    "Rest the pointer on the pet until it blushes, 10 times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك المؤشر على رفيقك حتى يحمرّ خجلًا، 10 مرات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte ukazatel spočinout na mazlíčkovi, dokud se nezačervená, 10krát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Zeiger 10-mal auf deinem Haustier ruhen, bis es errötet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest the pointer on the pet until it blushes, 10 times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el puntero sobre tu mascota hasta que se sonroje, 10 veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez le pointeur sur votre compagnon jusqu’à ce qu’il rougisse, 10 fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉइंटर को अपने नन्हे दोस्त पर तब तक रखें जब तक वह शरमा न जाए, 10 बार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan penunjuk di atas peliharaan Anda sampai ia tersipu, 10 kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il puntatore sul tuo animaletto finché non arrossisce, 10 volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットが照れるまでポインタをのせたままにします（10回）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫이 얼굴을 붉힐 때까지 포인터를 올려 두십시오. 10번 해 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de aanwijzer op je huisdiertje rusten tot het bloost, 10 keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj wskaźnik na zwierzaku, aż się zarumieni, 10 razy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o ponteiro sobre seu bichinho até ele corar, 10 vezes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți cursorul pe animăluț până se îmbujorează, de 10 ori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите указатель на питомце, пока он не смутится, 10 раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt pekaren vila på ditt husdjur tills det rodnar, 10 gånger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางตัวชี้บนเพื่อนตัวน้อยจนเขินหน้าแดง 10 ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci evcil dostunuzun üzerinde yanakları kızarana kadar tutun, 10 kez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте курсор на улюбленці, доки він не зніяковіє, 10 разів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt con trỏ lên thú cưng cho đến khi nó đỏ mặt, 10 lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
