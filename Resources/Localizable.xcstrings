    "Click a format or an app to choose which app opens it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على صيغة أو تطبيق لاختيار التطبيق الذي يفتحها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na formát nebo aplikaci vyberete, ve které aplikaci se otevře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick auf ein Format oder eine App, um zu wählen, welche App es öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a format or an app to choose which app opens it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un formato o en una app para elegir qué app lo abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un format ou une app pour choisir l’app qui l’ouvre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़ॉर्मैट या ऐप पर क्लिक करके चुनें कि उसे कौन-सा ऐप खोले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik format atau app untuk memilih app yang membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un formato o su un’app per scegliere quale app lo apre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットまたはアプリをクリックして、開くアプリを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형식이나 앱을 클릭하여 여는 앱을 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een formaat of een app om te kiezen welke app het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij format lub aplikację, aby wybrać, która aplikacja go otwiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um formato ou em um app para escolher qual app o abre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe un format sau pe o aplicație pentru a alege aplicația care îl deschide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на формат или программу, чтобы выбрать, в какой программе открывать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ett format eller en app för att välja vilken app som öppnar det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกรูปแบบหรือแอปเพื่อเลือกแอปที่จะเปิดรูปแบบนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi uygulamanın açacağını seçmek için bir biçime veya uygulamaya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть формат або програму, щоб вибрати, в якій програмі його відкривати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào định dạng hoặc ứng dụng để chọn ứng dụng sẽ mở nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按格式或 App，即可选择用哪个 App 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按格式或 App，即可選擇用哪個 App 開啟。"
          }
        }
      }
    },
