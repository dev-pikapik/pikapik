    "Select the text, then choose “%@” in the Services menu: in the app menu or when you right-click the text.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد النص، ثم اختر «%@» من قائمة الخدمات: في قائمة التطبيق أو في قائمة النقر بزر الماوس الأيمن على النص."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte text a pak v nabídce Služby zvolte „%@“: v nabídce aplikace nebo v nabídce pravého kliku na text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere den Text und wähle dann „%@“ im Menü „Dienste“: im App-Menü oder per Rechtsklick auf den Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the text, then choose “%@” in the Services menu: in the app menu or when you right-click the text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el texto y elige «%@» en el menú Servicios: en el menú de la app o con clic derecho sobre el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le texte, puis choisissez « %@ » dans le menu Services : dans le menu de l’app ou d’un clic droit sur le texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट चुनें, फिर सेवाएँ मेनू में “%@” चुनें: ऐप मेनू में या टेक्स्ट के राइट-क्लिक मेनू में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih teksnya, lalu pilih “%@” di menu Layanan: di menu app atau di menu klik kanan pada teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il testo, poi scegli «%@» nel menu Servizi: nel menu dell’app o con il clic destro sul testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを選択し、アプリのメニューまたは右クリックメニューにある「サービス」から「%@」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 선택한 다음, 앱 메뉴나 우클릭 메뉴의 서비스 메뉴에서 ‘%@’을(를) 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer de tekst en kies ‘%@’ in het menu Voorzieningen: in het appmenu of in het rechtsklikmenu van de tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz tekst, a potem wybierz „%@” z menu Usługi: w menu aplikacji lub w menu prawego kliku na tekście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o texto e escolha “%@” no menu Serviços: no menu do app ou com o clique direito no texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați textul, apoi alegeți „%@” din meniul Servicii: în meniul aplicației sau în meniul de clic dreapta pe text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите текст и выберите «%@» в меню «Службы»: оно есть в меню приложения и в контекстном меню текста."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera texten och välj sedan ”%@” i menyn Tjänster: i appmenyn eller i högerklicksmenyn för texten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกข้อความ แล้วเลือก “%@” ในเมนูบริการ ซึ่งอยู่ในเมนูแอปและเมนูคลิกขวาที่ข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni seçin, ardından Servisler menüsünde “%@” öğesini seçin: uygulama menüsünde veya metnin sağ tık menüsünde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділіть текст і виберіть «%@» у меню «Служби»: воно є в меню програми та в меню правого кліку по тексту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn văn bản, rồi chọn “%@” trong menu Dịch vụ: trong menu ứng dụng hoặc menu bấm chuột phải vào văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文本，然后在 App 菜单或右键菜单的“服务”中选取“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取文字，然後在 App 選單或右鍵選單的「服務」中選擇「%@」。"
          }
        }
      }
    },
