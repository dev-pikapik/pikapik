    "Magnifies the screen to make details easier to see.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكبّر الشاشة لتسهيل رؤية التفاصيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvětšuje obrazovku pro snazší zobrazení detailů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößert den Bildschirm, damit Details leichter zu erkennen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnifies the screen to make details easier to see."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplía la pantalla para ver mejor los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandit l’écran pour mieux voir les détails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारीकियाँ आसानी से देखने के लिए स्क्रीन बड़ा करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbesar layar agar detail lebih mudah dilihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisce lo schermo per vedere meglio i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を拡大して細部を見やすくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 확대해 세부 내용을 더 쉽게 봅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergroot het scherm zodat details beter te zien zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiększa ekran, ułatwiając dostrzeżenie szczegółów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplia a tela para facilitar a visualização dos detalhes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mărește ecranul pentru a vedea mai ușor detaliile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличивает экран, чтобы было легче рассмотреть детали."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förstorar skärmen så att detaljer blir lättare att se."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยายหน้าจอเพื่อให้เห็นรายละเอียดง่ายขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntıları daha kolay görmek için ekranı büyütür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільшує екран, щоб було легше роздивитися деталі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phóng to màn hình để dễ nhìn chi tiết hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大屏幕，让细节更容易看清。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大螢幕，讓細節更容易看清。"
          }
        }
      }
    },
