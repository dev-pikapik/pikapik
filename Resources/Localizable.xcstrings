    "Turn on if the monitor doesn’t respond to the slider.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّله إذا لم تستجب الشاشة لشريط التمرير."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte, pokud monitor na jezdec nereaguje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das ein, wenn der Monitor nicht auf den Schieberegler reagiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on if the monitor doesn’t respond to the slider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si el monitor no responde al regulador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option si l’écran ne réagit pas au curseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर मॉनिटर स्लाइडर पर प्रतिक्रिया न दे, तो इसे चालू करें।"
