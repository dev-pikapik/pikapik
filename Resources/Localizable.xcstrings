        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 켜면 끌 때까지 켜져 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu aangezet, blijft het aan tot je het uitzet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu teraz będzie działać, dopóki go nie wyłączysz"
