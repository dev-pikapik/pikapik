            "state": "translated",
            "value": "Щоб дізнатися, натисніть «Перевірити швидкість»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm “Kiểm tra tốc độ” để biết"
          }
