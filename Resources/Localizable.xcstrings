            "value": "pikapik знову сам перевірятиме оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik sẽ lại tự động kiểm tra bản cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 将重新自动检查更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 將再次自動檢查更新。"
          }
        }
      }
    },
    "pikapik will restart, and the tools that need it will turn grey until you allow it again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُعاد تشغيل pikapik، وستظهر الأدوات التي تحتاج إليه باللون الرمادي إلى أن تسمح به مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik se restartuje a nástroje, které to potřebují, zešednou, dokud to znovu nepovolíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik startet neu, und die Tools, die sie brauchen, werden grau, bis du sie wieder erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik will restart, and the tools that need it will turn grey until you allow it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik se reiniciará y las herramientas que lo necesiten se verán en gris hasta que lo permitas de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik va redémarrer, et les outils qui en ont besoin seront grisés jusqu’à ce que vous l’autorisiez de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik रीस्टार्ट होगा, और जिन टूल को इसकी ज़रूरत है वे तब तक धूसर रहेंगे जब तक आप इसे फिर से अनुमति नहीं देते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik akan dimulai ulang, dan alat yang membutuhkannya akan berwarna abu-abu sampai Anda mengizinkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik si riavvierà e gli strumenti che ne hanno bisogno resteranno in grigio finché non lo consenti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik が再起動し、必要とするツールは、もう一度許可するまでグレーになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik이 다시 시작되고, 이 권한이 필요한 도구는 다시 허용할 때까지 회색으로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik start opnieuw op en de functies die dit nodig hebben worden grijs totdat je het weer toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik uruchomi się ponownie, a narzędzia, które tego potrzebują, będą wyszarzone, dopóki ponownie nie zezwolisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pikapik vai reiniciar, e as ferramentas que precisam dela ficarão em cinza até você permitir de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik va reporni, iar instrumentele care au nevoie de ea vor deveni gri până o permiți din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik перезапустится, а инструменты, которым это нужно, станут серыми, пока вы снова не разрешите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik startar om, och verktygen som behöver den blir gråa tills du tillåter den igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik จะเริ่มใหม่ และเครื่องมือที่ต้องใช้สิ่งนี้จะเป็นสีเทาจนกว่าคุณจะอนุญาตอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik yeniden başlayacak ve buna ihtiyaç duyan araçlar, yeniden izin verene kadar gri olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik перезапуститься, а інструменти, яким це потрібно, стануть сірими, доки ви знову не дозволите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik sẽ khởi động lại, và các công cụ cần quyền này sẽ chuyển màu xám cho đến khi bạn cho phép lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 会重新启动，需要该权限的工具会变灰，直到你再次允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 會重新啟動，需要此權限的工具會變灰，直到你再次允許。"
          }
        }
      }
    },
