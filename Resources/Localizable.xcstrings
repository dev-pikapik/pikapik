          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб показати наступне зображення, дозвольте доступ до цієї папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để hiển thị ảnh tiếp theo, hãy cho phép truy cập thư mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要显示下一张图片，请允许访问此文件夹。"
