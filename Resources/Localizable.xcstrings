    "The pointer moves as far as your hand, at any speed. Mouse only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك المؤشر بقدر حركة يدك مهما كانت السرعة. للماوس فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazatel urazí stejnou vzdálenost jako ruka, ať se hýbe jakkoli rychle. Jen pro myši."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeiger bewegt sich so weit wie deine Hand, egal wie schnell. Nur für Mäuse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pointer moves as far as your hand, at any speed. Mouse only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puntero recorre lo mismo que tu mano, a cualquier velocidad. Solo para ratones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pointeur va aussi loin que ta main, quelle que soit la vitesse. Souris uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉइंटर उतना ही चलता है जितना आपका हाथ, चाहे जिस गति से चलाएँ। सिर्फ़ माउस के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penunjuk bergerak sejauh tangan Anda, secepat apa pun. Hanya untuk tetikus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il puntatore si sposta quanto la tua mano, a qualsiasi velocità. Solo per mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれだけ速く動かしても、ポインタは手を動かした分だけ進みます。マウス専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 빠르게 움직여도 포인터는 손이 움직인 만큼만 이동합니다. 마우스 전용입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanwijzer gaat net zo ver als je hand, hoe snel je ook beweegt. Alleen voor muizen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaźnik przesuwa się tyle, co ręka, bez względu na szybkość. Tylko dla myszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cursor percorre a mesma distância que sua mão, não importa a velocidade. Só para mouse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursorul se mișcă atât cât mâna dumneavoastră, oricât de repede o mișcați. Doar pentru mausuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указатель проходит столько же, сколько рука, с любой скоростью. Только для мыши."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekaren rör sig lika långt som handen, hur snabbt du än rör den. Bara för möss."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวชี้เลื่อนไปเท่ากับที่มือคุณเลื่อน ไม่ว่าจะเร็วแค่ไหน เฉพาะเมาส์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar hızlı hareket ettirirseniz ettirin, imleç eliniz kadar ilerler. Yalnızca fareler için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вказівник проходить стільки ж, скільки рука, з будь-якою швидкістю. Лише для миші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con trỏ di chuyển đúng bằng tay bạn, dù nhanh hay chậm. Chỉ dành cho chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论移动多快，指针移动的距离都与手相同。仅限鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論移動多快，指標移動的距離都和手一樣。僅適用於滑鼠。"
          }
        }
      }
    },
    "The pointer stays in the game": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى المؤشر في اللعبة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazatel zůstává ve hře"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeiger bleibt im Spiel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pointer stays in the game"
          }
        },
        "es": {
          "stringUnit": {
