            "state": "translated",
            "value": "L’écran « %@ » ne s’est pas rallumé. Débranchez son câble, puis rebranchez-le."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” स्क्रीन वापस चालू नहीं हुई। उसकी केबल निकालें और फिर से लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar “%@” tidak menyala lagi. Cabut kabelnya, lalu colokkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo «%@» non si è riacceso. Scollega il suo cavo e ricollegalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面「%@」が再表示されませんでした。ケーブルを抜いて、もう一度差し込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 화면이 다시 켜지지 않았습니다. 케이블을 뽑았다가 다시 꽂으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm ‘%@’ is niet teruggekomen. Trek de kabel eruit en steek hem er weer in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran „%@” nie włączył się ponownie. Odłącz jego kabel i podłącz go jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela “%@” não voltou. Desconecte o cabo dela e conecte de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul „%@” nu a pornit din nou. Scoateți-i cablul și conectați-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран «%@» не включился. Выньте его кабель и вставьте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen ”%@” kom inte tillbaka. Dra ut dess kabel och sätt i den igen."
          }
        },
        "th": {
