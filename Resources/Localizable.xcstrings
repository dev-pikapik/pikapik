    "Put the pointer in its way and it jumps over it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع المؤشر في طريقه فيقفز فوقه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavte mu ukazatel do cesty a přeskočí ho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt ihm den Zeiger in den Weg, und es springt darüber"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the pointer in its way and it jumps over it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle el puntero en el camino y lo salta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez le pointeur sur son chemin et il saute par-dessus"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉइंटर को उसके रास्ते में रखें और वह उसके ऊपर से कूद जाएगा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh penunjuk di jalannya dan ia melompatinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettigli il puntatore davanti e ci salta sopra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタを行く手に置くと、飛び越えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터를 길에 두면 뛰어넘습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de aanwijzer in de weg en het springt eroverheen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postaw mu wskaźnik na drodze, a go przeskoczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o ponteiro no caminho e ele pula por cima"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puneți-i cursorul în cale și sare peste el"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте указатель у него на пути — он через него перепрыгнет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ pekaren i vägen så hoppar det över den"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางตัวชี้ขวางทางแล้วมันจะกระโดดข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleci yoluna koyun, üstünden atlasın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте курсор йому на шляху — він його перестрибне"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt con trỏ chắn đường là nó nhảy qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把指针挡在它前面，它会跳过去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把指標擋在它前面，它會跳過去"
          }
        }
      }
    },
