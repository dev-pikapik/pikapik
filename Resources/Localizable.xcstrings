    "Keep Awake": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع السكون"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez spánku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener activo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगाए रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap Terjaga"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta sveglio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープさせない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기 방지"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakker houden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez usypiania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter ativo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține activ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засыпать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll vaken"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ให้หลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засинати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ máy thức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持喚醒"
          }
        }
      }
    },
    "Keep Awake will turn off, and the duration and options will go back to how they were.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف «منع السكون»، وستعود المدة والخيارات إلى ما كانت عليه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bez spánku“ se vypne a doba trvání i volby se vrátí do původního stavu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wach bleiben“ wird ausgeschaltet, Dauer und Optionen werden zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake will turn off, and the duration and options will go back to how they were."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mantener activo» se desactivará, y la duración y las opciones volverán a como estaban."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Rester éveillé » sera désactivé, et la durée et les options reviendront à leur état initial."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“जगाए रखें” बंद हो जाएगा, और अवधि व विकल्प पहले जैसे हो जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tetap Terjaga” akan mati, serta durasi dan pilihannya kembali seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Resta sveglio» si disattiverà, e durata e opzioni torneranno come prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スリープさせない」がオフになり、時間とオプションも元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'잠자기 방지'가 꺼지고, 지속 시간과 옵션이 원래대로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Wakker houden’ wordt uitgeschakeld en de duur en opties worden weer zoals ze waren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bez usypiania” wyłączy się, a czas i opcje wrócą do poprzednich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Manter ativo” será desativado, e a duração e as opções voltarão a ser como eram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Menține activ” se va dezactiva, iar durata și opțiunile vor reveni cum erau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Не засыпать» выключится, а длительность и параметры вернутся к исходным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Håll vaken” stängs av, och tid och alternativ blir som de var."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ไม่ให้หลับ” จะปิด และระยะเวลากับตัวเลือกจะกลับเป็นเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uyanık Tut” kapanacak; süre ve seçenekler eski hâline dönecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Не засинати» вимкнеться, а тривалість і параметри повернуться до початкових."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Giữ máy thức” sẽ tắt, thời lượng và tùy chọn sẽ trở lại như cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“保持唤醒”将关闭，时长和选项也会恢复原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「保持喚醒」將關閉，時間長度和選項也會回復原狀。"
          }
        }
      }
    },
