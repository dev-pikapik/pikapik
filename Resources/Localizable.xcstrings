            "state": "translated",
            "value": "ภาพอาจค้างหรือเบลอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü donabilir veya bulanıklaşabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
