    "Looks like the app is gone. Pick what to remove.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن التطبيق اختفى. اختر ما تريد إزالته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace už je pryč. Vyberte, co odebrat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App scheint weg zu sein. Wähle, was weg soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the app is gone. Pick what to remove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que la app ya no está. Elige qué eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app semble disparue. Choisissez quoi supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है ऐप हट चुका है। चुनें कि क्या हटाना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App tampaknya sudah hilang. Pilih apa yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app sembra sparita. Scegli cosa rimuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは削除済みのようです。消すものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 이미 없는 것 같습니다. 제거할 항목을 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app lijkt weg. Kies wat je wilt verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacji już nie ma. Wybierz, co usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que o app foi embora. Escolha o que remover."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că aplicația nu mai e. Alegeți ce să eliminați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, приложения уже нет. Выберите, что удалить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen verkar vara borta. Välj vad som ska tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนแอปหายไปแล้ว เลือกสิ่งที่จะลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama artık yok. Kaldırılacakları seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, програми вже немає. Виберіть, що видалити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ ứng dụng đã mất. Hãy chọn thứ cần gỡ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 似乎已经不在了。请选择要移除的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 似乎已經不在了。請選擇要移除的內容。"
          }
        }
      }
    },
