            "value": "アプリごとの音量を変えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 음량을 바꾸기 위해"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om het volume van elke app te wijzigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zmieniać głośność każdej aplikacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para alterar o volume de cada app"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a schimba volumul fiecărei aplicații"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы менять громкость каждого приложения"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att ändra volymen för varje app"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อเปลี่ยนระดับเสียงของแต่ละแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamanın ses düzeyini değiştirmek için"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінювати гучність кожної програми"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đổi âm lượng của từng ứng dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于调整每个 App 的音量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於調整每個 App 的音量"
          }
        }
      }
    },
    "To change each app’s volume, allow “%@”. Nothing is recorded or saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتغيير مستوى صوت كل تطبيق، اسمح بـ «%@». لا يتم تسجيل أي شيء ولا حفظه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li měnit hlasitost každé aplikace, povolte „%@“. Nic se nenahrává ani neukládá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Lautstärke jeder App zu ändern, erlaube „%@“. Es wird nichts aufgenommen oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change each app’s volume, allow “%@”. Nothing is recorded or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar el volumen de cada app, permite «%@». No se graba ni se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer le volume de chaque app, autorisez « %@ ». Rien n’est enregistré ni conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ऐप की आवाज़ बदलने के लिए “%@” की अनुमति दें। कुछ भी रिकॉर्ड या सेव नहीं किया जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengubah volume tiap app, izinkan “%@”. Tidak ada yang direkam atau disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cambiare il volume di ogni app, consenti “%@”. Non viene registrato né salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの音量を変えるには、「%@」を許可してください。録音も保存もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 음량을 바꾸려면 “%@”을(를) 허용하십시오. 아무것도 녹음되거나 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om het volume van elke app te wijzigen, sta “%@” toe. Er wordt niets opgenomen of bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zmieniać głośność każdej aplikacji, zezwól na „%@”. Nic nie jest nagrywane ani zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para alterar o volume de cada app, permita “%@”. Nada é gravado nem salvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a schimba volumul fiecărei aplicații, permiteți „%@”. Nimic nu este înregistrat sau salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы менять громкость каждого приложения, разрешите «%@». Ничего не записывается и не сохраняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att ändra volymen för varje app, tillåt ”%@”. Ingenting spelas in eller sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อเปลี่ยนระดับเสียงของแต่ละแอป ให้อนุญาต “%@” ไม่มีการบันทึกหรือเก็บอะไรไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamanın ses düzeyini değiştirmek için “%@” iznini verin. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінювати гучність кожної програми, дозвольте «%@». Нічого не записується й не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đổi âm lượng của từng ứng dụng, hãy cho phép “%@”. Không có gì được ghi lại hoặc lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要调整每个 App 的音量，请允许“%@”。不会录制或保存任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要調整每個 App 的音量，請允許「%@」。不會錄製或儲存任何內容。"
          }
        }
      }
    },
    "To choose its size here, set “Use as” to “Extended display” in System Settings › Displays": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاختيار حجمها هنا، اضبط «استخدام كـ» على «شاشة عرض ممتدة» في إعدادات النظام › شاشات العرض"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zde vybrat jeho velikost, nastavte v Nastavení systému › Monitory „Používat jako“ na „Rozšířené zobrazení“"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um hier seine Größe zu wählen, stell in Systemeinstellungen › Displays „Verwenden als“ auf „Erweiterte Darstellung“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To choose its size here, set “Use as” to “Extended display” in System Settings › Displays"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para elegir su tamaño aquí, en Ajustes del Sistema › Pantallas, cambia «Usar como» a «Pantalla ampliada»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour choisir sa taille ici, réglez « Utiliser comme » sur « Affichage étendu » dans Réglages Système › Moniteurs"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इसका आकार चुनने के लिए सिस्टम सेटिंग › डिस्प्ले में “ऐसे उपयोग करें” को “विस्तारित डिस्प्ले” पर सेट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memilih ukurannya di sini, atur “Gunakan sebagai” ke “Layar yang diperluas” di Pengaturan Sistem › Layar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sceglierne le dimensioni qui, in Impostazioni di Sistema › Schermi imposta «Utilizza come» su «Schermo esteso»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでサイズを選ぶには、システム設定 › ディスプレイで「使用形態」を「拡張ディスプレイ」にしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 크기를 선택하려면 시스템 설정 › 디스플레이에서 ‘다음으로 사용’을 ‘확장된 디스플레이’로 설정하십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om hier de grootte te kiezen, zet je ‘Gebruik als’ op ‘Uitgebreid scherm’ in Systeeminstellingen › Beeldschermen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wybrać tu jego rozmiar, w Ustawieniach systemowych › Wyświetlacze ustaw „Używaj jako” na „Rozszerzony ekran”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escolher o tamanho aqui, em Ajustes do Sistema › Telas, defina “Usar como” como “Tela estendida”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a-i alege dimensiunea aici, setați „Utilizați ca” la „Afișaj extins” în Configurări sistem › Afișaje"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выбрать здесь его размер, в Системных настройках › Дисплеи для «Использовать как» выберите «Расширенный дисплей»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill välja storleken här ställer du in ”Använd som” på ”Utökad bildskärm” i Systeminställningar › Bildskärmar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเลือกขนาดที่นี่ ให้ตั้ง “ใช้เป็น” เป็น “จอภาพแบบต่อขยาย” ในการตั้งค่าระบบ › จอภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutunu burada seçmek için Sistem Ayarları › Ekranlar’da “Şöyle Kullan” seçeneğini “Genişletilmiş ekran” olarak ayarlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вибрати тут його розмір, у Системних параметрах › Дисплеї для «Використання» виберіть «Розширений дисплей»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để chọn kích thước tại đây, hãy đặt “Dùng làm” thành “Màn hình mở rộng” trong Cài đặt hệ thống › Màn hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在这里选择其大小，请在“系统设置” › “显示器”中将“用途”设为“扩展显示器”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在這裡選擇其大小，請在「系統設定」›「顯示器」中將「做為」設為「延伸的顯示器」"
          }
        }
      }
    },
    "To continue, choose the folder “%@” or a folder that contains it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمتابعة، اختر المجلد «%@» أو مجلدًا يحتويه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li pokračovat, vyberte složku „%@“ nebo složku, která ji obsahuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zum Fortfahren den Ordner „%@“ oder einen Ordner, der ihn enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue, choose the folder “%@” or a folder that contains it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, elige la carpeta «%@» o una carpeta que la contenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer, choisissez le dossier « %@ » ou un dossier qui le contient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए “%@” फ़ोल्डर या उसे रखने वाला कोई फ़ोल्डर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melanjutkan, pilih folder “%@” atau folder yang memuatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare, scegli la cartella “%@” o una cartella che la contiene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには、フォルダ「%@」か、それを含むフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 “%@” 폴더나 그 폴더가 들어 있는 폴더를 선택해 주십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de map “%@” of een map waar die in staat om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, wybierz folder „%@” lub folder, który go zawiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar, escolha a pasta “%@” ou uma pasta que a contenha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a continua, alegeți folderul „%@” sau un folder care îl conține."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, выберите папку «%@» или папку, в которой она находится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mappen ”%@” eller en mapp som innehåller den för att fortsätta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการดำเนินการต่อ ให้เลือกโฟลเดอร์ “%@” หรือโฟลเดอร์ที่มีโฟลเดอร์นี้อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için “%@” klasörünü ya da onu içeren bir klasörü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, виберіть папку «%@» або папку, у якій вона лежить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tiếp tục, hãy chọn thư mục “%@” hoặc một thư mục chứa nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要继续，请选择文件夹“%@”或包含它的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要繼續，請選擇檔案夾「%@」或包含它的檔案夾。"
          }
        }
      }
    },
