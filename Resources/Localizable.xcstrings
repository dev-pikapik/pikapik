          "stringUnit": {
            "state": "translated",
            "value": "Rear button goes back, front button goes forward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón trasero va atrás, el delantero va adelante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouton arrière : précédent, bouton avant : suivant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे वाला बटन पीछे जाता है, आगे वाला बटन आगे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol belakang untuk kembali, tombol depan untuk maju"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tasto posteriore va indietro, quello anteriore avanti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろのボタンで戻る、前のボタンで進む"
