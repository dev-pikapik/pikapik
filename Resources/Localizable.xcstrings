    "Lower or mute any app without touching the others.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخفض صوت أي تطبيق أو اكتمه دون المساس بالتطبيقات الأخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztište nebo ztlumte libovolnou aplikaci, aniž byste ovlivnili ostatní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App leiser stellen oder stummschalten, ohne die anderen zu verändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower or mute any app without touching the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el volumen de cualquier app o silénciala sin tocar las demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baissez le volume de n’importe quelle app ou coupez-en le son, sans toucher aux autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप को छुए बिना किसी भी ऐप की आवाज़ घटाएँ या उसे म्यूट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecilkan atau bisukan app mana pun tanpa memengaruhi yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa il volume di qualsiasi app o silenziala senza toccare le altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリはそのままで、好きなアプリの音量を下げたりミュートしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱은 그대로 두고 원하는 앱의 음량을 낮추거나 음소거하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een app zachter of demp hem, zonder de andere aan te raken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścisz lub wycisz dowolną aplikację, nie ruszając pozostałych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diminua o volume de qualquer app ou silencie-o sem mexer nos outros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduceți volumul sau opriți sunetul oricărei aplicații, fără să le afectați pe celelalte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшайте громкость или выключайте звук любого приложения, не затрагивая остальные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sänk volymen eller stäng av ljudet för valfri app utan att påverka de andra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดเสียงหรือปิดเสียงแอปใดก็ได้ โดยไม่กระทบแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğerlerine dokunmadan herhangi bir uygulamanın sesini kısın veya kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшуйте гучність або вимикайте звук будь-якої програми, не чіпаючи решту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm hoặc tắt tiếng bất kỳ ứng dụng nào mà không ảnh hưởng đến các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调低或静音任意 App，不影响其他 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調低或靜音任何 App，不影響其他 App。"
          }
        }
      }
    },
