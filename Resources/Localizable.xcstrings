          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie może teraz wyświetlić monitora w skali %@. Spróbuj innego rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
