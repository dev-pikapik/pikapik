    "Bars and colors follow the normal range for each part": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد الأشرطة والألوان على النطاق الطبيعي لكل جزء"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruhy a barvy počítají s běžným rozsahem pro každou část"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Balken und Farben richten sich nach dem normalen Bereich jedes Bauteils"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars and colors follow the normal range for each part"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras y los colores tienen en cuenta el rango normal de cada componente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres et les couleurs tiennent compte de la plage normale de chaque composant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पट्टियाँ और रंग हर हिस्से की सामान्य सीमा के आधार पर तय होते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah dan warna disesuaikan dengan rentang normal setiap komponen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre e i colori tengono conto dell’intervallo normale di ogni componente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーと色は各部品の通常の温度範囲に基づいています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막대와 색상은 부품마다 다른 정상 범위를 기준으로 합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De balken en kleuren houden rekening met het normale bereik van elk onderdeel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paski i kolory uwzględniają normalny zakres dla każdej części"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras e as cores levam em conta a faixa normal de cada componente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Barele și culorile țin cont de intervalul normal al fiecărei componente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полоски и цвет учитывают, какая температура нормальна для каждой детали"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Staplarna och färgerna utgår från det normala intervallet för varje del"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบและสีจะอิงตามช่วงอุณหภูมิปกติของแต่ละชิ้นส่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuklar ve renkler her parçanın normal aralığına göre belirlenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Смужки й колір враховують, яка температура нормальна для кожної деталі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh và màu sắc dựa trên khoảng nhiệt độ bình thường của từng bộ phận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横条和颜色会根据各部件的正常温度范围显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫條和顏色會依各部件的正常溫度範圍顯示"
          }
        }
      }
    },
