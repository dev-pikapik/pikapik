    "You’re doing great. I checked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تبلي بلاءً رائعًا. لقد تحققت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde vám to skvěle. Kontroloval jsem to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst das super. Ich hab nachgesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re doing great. I checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo estás haciendo genial. Lo he comprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous débrouillez très bien. J’ai vérifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बहुत बढ़िया कर रहे हैं। मैंने देख लिया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda hebat kok. Aku sudah cek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai andando alla grande. Ho controllato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すごくがんばってますね。確認済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말 잘하고 있습니다. 제가 확인했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je doet het super. Ik heb het gecheckt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świetnie ci idzie. Sprawdziłem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está mandando muito bem. Eu conferi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă descurcați de minune. Am verificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас всё отлично получается. Я проверил."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gör det jättebra. Jag har kollat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทำได้ดีมาก ตรวจสอบแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika gidiyorsunuz. Kontrol ettim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас усе чудово виходить. Я перевірив."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang làm rất tốt. Mình kiểm tra rồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你做得很棒。我检查过了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你做得很棒。我確認過了。"
          }
        }
      }
    },
