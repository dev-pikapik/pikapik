    "To leave a game, press %@; to close its window, %@. ⌥⌘Esc always works.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للخروج من اللعبة، اضغط %1$@، ولإغلاق نافذتها %2$@. يعمل ⌥⌘Esc دائمًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hru ukončíte stiskem %1$@, její okno zavřete stiskem %2$@. ⌥⌘Esc funguje vždy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ein Spiel zu beenden, drück %1$@, um sein Fenster zu schließen, %2$@. ⌥⌘Esc funktioniert immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To leave a game, press %1$@; to close its window, %2$@. ⌥⌘Esc always works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para salir de un juego, pulsa %1$@; para cerrar su ventana, %2$@. ⌥⌘Esc siempre funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour quitter un jeu, appuyez sur %1$@ ; pour fermer sa fenêtre, sur %2$@. ⌥⌘Esc fonctionne toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम से बाहर निकलने के लिए %1$@ दबाएँ, और उसकी विंडो बंद करने के लिए %2$@। ⌥⌘Esc हमेशा काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk keluar dari game, tekan %1$@; untuk menutup jendelanya, %2$@. ⌥⌘Esc selalu berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per uscire da un gioco, premi %1$@; per chiuderne la finestra, %2$@. ⌥⌘Esc funziona sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームを終了するには%1$@、ウインドウを閉じるには%2$@を押します。⌥⌘Escは必ず使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 끝내려면 %1$@를, 창을 닫으려면 %2$@를 누르십시오. ⌥⌘Esc는 항상 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op %1$@ om een game te verlaten en op %2$@ om het venster te sluiten. ⌥⌘Esc werkt altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyjść z gry, naciśnij %1$@, a żeby zamknąć jej okno – %2$@. ⌥⌘Esc działa zawsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sair de um jogo, pressione %1$@; para fechar a janela dele, %2$@. ⌥⌘Esc sempre funciona."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să ieșiți dintr-un joc, apăsați %1$@, iar ca să-i închideți fereastra, %2$@. ⌥⌘Esc merge mereu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выйти из игры, нажмите %1$@, а чтобы закрыть её окно — %2$@. ⌥⌘Esc работает всегда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på %1$@ för att lämna ett spel och på %2$@ för att stänga dess fönster. ⌥⌘Esc fungerar alltid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการออกจากเกม ให้กด %1$@ และหากต้องการปิดหน้าต่างเกม ให้กด %2$@ ส่วน ⌥⌘Esc ใช้ได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyundan çıkmak için %1$@’ya, penceresini kapatmak için %2$@’ye basın. ⌥⌘Esc her zaman çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вийти з гри, натисніть %1$@, а щоб закрити її вікно — %2$@. ⌥⌘Esc працює завжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thoát trò chơi, hãy nhấn %1$@; để đóng cửa sổ của nó, nhấn %2$@. ⌥⌘Esc luôn hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要退出游戏，请按 %1$@；要关闭其窗口，请按 %2$@。⌥⌘Esc 始终有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要結束遊戲，請按 %1$@；要關閉其視窗，請按 %2$@。⌥⌘Esc 永遠有效。"
          }
        }
      }
    },
