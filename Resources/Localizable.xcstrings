    "These apps can ask for it. Only System Settings shows who has it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لهذه التطبيقات طلبه. إعدادات النظام وحدها تعرض من لديه الإذن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto aplikace o to mohou požádat. Kdo má povoleno, ukáže jen Nastavení systému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apps können danach fragen. Wer Zugriff hat, zeigen nur die Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These apps can ask for it. Only System Settings shows who has it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas apps pueden pedirlo. Solo Ajustes del Sistema muestra quién lo tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces apps peuvent la demander. Seuls les Réglages Système montrent qui l’a."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये ऐप इसे माँग सकते हैं। किसे मिली है, यह सिर्फ़ सिस्टम सेटिंग्ज़ में दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App ini bisa memintanya. Siapa yang punya izin hanya terlihat di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste app possono richiederlo. Solo Impostazioni di Sistema mostra chi ce l’ha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリは許可を求めることができます。許可されているアプリは、システム設定でのみ確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱들이 요청할 수 있습니다. 누가 허용받았는지는 시스템 설정에서만 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze apps kunnen erom vragen. Alleen Systeeminstellingen laat zien wie toestemming heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te aplikacje mogą o nie poprosić. Kto je ma, widać tylko w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes apps podem pedir. Só os Ajustes do Sistema mostram quem tem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste aplicații o pot cere. Cine o are se vede doar în Configurări sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти приложения могут попросить. Кому разрешено, видно только в Системных настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här apparna kan be om den. Bara Systeminställningar visar vem som har den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปเหล่านี้ขอสิทธิ์ได้ ดูได้เฉพาะในการตั้งค่าระบบว่าใครมีสิทธิ์"
          }
        },
        "tr": {
