    "Contains a program. Open it only if you trust where it came from.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي على برنامج. لا تفتحه إلا إذا كنت تثق بمصدره."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsahuje program. Otevírejte ho jen tehdy, pokud zdroji důvěřujete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält ein Programm. Öffne es nur, wenn du der Quelle vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contains a program. Open it only if you trust where it came from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiene un programa. Ábrelo solo si confías en su origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient un programme. Ne l’ouvrez que si vous faites confiance à sa source."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें एक प्रोग्राम है। इसे तभी खोलें जब आपको इसके स्रोत पर भरोसा हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berisi program. Buka hanya jika Anda memercayai sumbernya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiene un programma. Aprilo solo se ti fidi della fonte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムが含まれています。入手元を信頼できる場合のみ開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램이 들어 있습니다. 출처를 신뢰할 수 있을 때만 여십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevat een programma. Open het alleen als je de bron vertrouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawiera program. Otwieraj go tylko wtedy, gdy ufasz jego źródłu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contém um programa. Abra somente se você confiar na origem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conține un program. Deschideți-l doar dacă aveți încredere în sursă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержит программу. Открывайте её, только если доверяете источнику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innehåller ett program. Öppna det bara om du litar på källan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
