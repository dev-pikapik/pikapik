          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zobrazit další obrázek, povolte přístup k této složce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf diesen Ordner, um das nächste Bild anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
