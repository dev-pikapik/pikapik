          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn nút chuột đã chọn để ẩn ứng dụng đang ở phía trước, giống như ⌘H."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下所选的鼠标按钮即可隐藏最前面的应用，就像按 ⌘H 一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下所選的滑鼠按鈕即可隱藏最前面的 App，就像按 ⌘H 一樣。"
          }
        }
      }
    },
