    "Click the green button to fill the screen, click again to go back. Full screen stays in the button’s menu and on ⌃⌘F.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الزر الأخضر لتملأ النافذة الشاشة، وانقر مرة أخرى للعودة. يبقى ملء الشاشة متاحًا من قائمة الزر وعلى ⌃⌘F."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na zelené tlačítko okno vyplní obrazovku, dalším kliknutím se vrátí zpět. Celá obrazovka zůstává v nabídce tlačítka a na ⌃⌘F."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den grünen Knopf, und das Fenster füllt den Bildschirm. Noch ein Klick bringt die alte Größe zurück. Vollbild gibt es weiterhin im Menü des Knopfs und mit ⌃⌘F."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the green button to fill the screen, click again to go back. Full screen stays in the button’s menu and on ⌃⌘F."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón verde para que la ventana llene la pantalla. Otro clic la devuelve a su tamaño. La pantalla completa sigue en el menú del botón y con ⌃⌘F."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton vert pour que la fenêtre remplisse l’écran. Un autre clic la remet à sa taille d’avant. Le plein écran reste dans le menu du bouton et sur ⌃⌘F."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हरे बटन पर क्लिक करें, तो विंडो पूरी स्क्रीन भर देगी। पहले का आकार लौटाने के लिए फिर से क्लिक करें। फ़ुल स्क्रीन बटन के मेनू में और ⌃⌘F से मिलता रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik tombol hijau agar jendela memenuhi layar, klik lagi untuk kembali ke ukuran semula. Layar penuh tetap ada di menu tombol dan di ⌃⌘F."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul pulsante verde per far riempire lo schermo alla finestra. Un altro clic la riporta alla misura precedente. Lo schermo intero resta nel menu del pulsante e con ⌃⌘F."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑のボタンをクリックすると、ウインドウが画面いっぱいに広がります。もう一度クリックすると元の大きさに戻ります。フルスクリーンは、ボタンのメニューと⌃⌘Fで引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색 버튼을 클릭하면 윈도우가 화면을 가득 채웁니다. 다시 클릭하면 이전 크기로 돌아옵니다. 전체 화면은 버튼 메뉴와 ⌃⌘F로 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de groene knop om het venster het scherm te laten vullen, klik nogmaals om terug te gaan. Volledig scherm blijft beschikbaar in het menu van de knop en met ⌃⌘F."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij zielony przycisk, aby okno wypełniło ekran, i kliknij ponownie, aby wrócić do poprzedniego rozmiaru. Pełny ekran nadal jest w menu przycisku i pod ⌃⌘F."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão verde para a janela preencher a tela; clique de novo para voltar ao tamanho anterior. A tela inteira continua no menu do botão e em ⌃⌘F."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe butonul verde ca fereastra să umple ecranul. Faceți clic din nou ca să reveniți la mărimea de dinainte. Ecranul complet rămâne în meniul butonului și pe ⌃⌘F."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кликните по зелёной кнопке — окно заполнит экран. Ещё клик — вернётся прежний размер. Полный экран остаётся в меню кнопки и на ⌃⌘F."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på den gröna knappen så fyller fönstret skärmen. Klicka igen för att gå tillbaka. Helskärm finns kvar i knappens meny och på ⌃⌘F."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกปุ่มสีเขียวเพื่อให้หน้าต่างเต็มหน้าจอ คลิกอีกครั้งเพื่อกลับเป็นขนาดเดิม โหมดเต็มหน้าจอยังอยู่ในเมนูของปุ่มและที่ ⌃⌘F"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerenin ekranı doldurması için yeşil düğmeyi tıklayın, eski boyuta dönmek için yeniden tıklayın. Tam ekran, düğmenin menüsünde ve ⌃⌘F ile kullanılabilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть зелену кнопку — вікно заповнить екран. Ще клацання — повернеться попередній розмір. Повноекранний режим залишається в меню кнопки та на ⌃⌘F."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào nút xanh lá để cửa sổ lấp đầy màn hình. Bấm lần nữa để trở lại kích thước cũ. Chế độ toàn màn hình vẫn có trong menu của nút và ở ⌃⌘F."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按绿色按钮，窗口会铺满屏幕；再点按一次，恢复原来的大小。全屏幕仍可在按钮的菜单中或按 ⌃⌘F 使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按綠色按鈕，視窗會填滿螢幕；再點按一次，恢復原本大小。全螢幕仍可在按鈕的選單中或按 ⌃⌘F 使用。"
          }
        }
      }
    },
    "Click the icon of the app you’re in to hide it. Click again to bring it back.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أيقونة التطبيق الذي تستخدمه لإخفائه. انقر مرة أخرى لإعادته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na ikonu aplikace, kterou právě používáte, a skryje se. Dalším kliknutím ji vrátíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Symbol der App, die du gerade nutzt, um sie auszublenden. Noch ein Klick holt sie zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the icon of the app you’re in to hide it. Click again to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de la app que usas para ocultarla. Otro clic la trae de vuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône de l’app active pour la masquer. Un autre clic la fait revenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस ऐप में आप हैं, उसे छिपाने के लिए उसके आइकॉन पर क्लिक करें। वापस लाने के लिए फिर से क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ikon app yang sedang digunakan untuk menyembunyikannya. Klik lagi untuk menampilkannya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’icona dell’app in uso per nasconderla. Un altro clic la riporta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のアプリのアイコンをクリックすると隠れます。もう一度クリックすると戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 앱의 아이콘을 클릭하면 가려집니다. 다시 클릭하면 돌아옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op het symbool van de app waarin je werkt om deze te verbergen. Klik nogmaals om hem terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ikonę aplikacji, w której jesteś, aby ją ukryć. Kliknij ponownie, aby ją przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone do app em uso para ocultá-lo. Outro clique o traz de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe pictograma aplicației în care vă aflați ca s-o ascundeți. Faceți clic din nou ca s-o readuceți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кликните по значку приложения, в котором работаете, — оно скроется. Ещё клик — вернётся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på symbolen för appen du använder för att gömma den. Klicka igen för att ta tillbaka den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกไอคอนของแอปที่ใช้อยู่เพื่อซ่อน คลิกอีกครั้งเพื่อแสดงกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullandığınız uygulamanın simgesini tıklayarak onu gizleyin. Geri getirmek için yeniden tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть значок програми, у якій працюєте, — вона сховається. Ще клацання — повернеться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào biểu tượng của ứng dụng đang dùng để ẩn ứng dụng. Bấm lần nữa để hiện lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按当前应用的图标即可隐藏，再点按一次即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按目前使用中 App 的圖像即可隱藏，再點按一次即可顯示。"
          }
        }
      }
    },
    "Click the icon of the app you’re in, and all its windows go down to the Dock. Click again to bring them all back.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أيقونة التطبيق الذي تستخدمه، فتنزل كل نوافذه إلى Dock. انقر مرة أخرى لإعادتها كلها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na ikonu aplikace, kterou právě používáte, a všechna její okna sjedou do Docku. Dalším kliknutím je všechna vrátíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Symbol der App, die du gerade nutzt, und alle ihre Fenster wandern ins Dock. Noch ein Klick holt sie alle zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the icon of the app you’re in, and all its windows go down to the Dock. Click again to bring them all back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de la app que usas y todas sus ventanas bajan al Dock. Otro clic las trae todas de vuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône de l’app active et toutes ses fenêtres rejoignent le Dock. Un autre clic les fait toutes revenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस ऐप में आप हैं, उसके आइकन पर क्लिक करें, और उसकी सारी विंडो Dock में चली जाएँगी। सबको वापस लाने के लिए फिर से क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik ikon app yang sedang digunakan, dan semua jendelanya akan turun ke Dock. Klik lagi untuk menampilkan semuanya kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’icona dell’app in uso e tutte le sue finestre scendono nel Dock. Un altro clic le riporta tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のアプリのアイコンをクリックすると、すべてのウインドウがDockに入ります。もう一度クリックするとすべて戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 앱의 아이콘을 클릭하면 모든 윈도우가 Dock으로 내려갑니다. 다시 클릭하면 모두 돌아옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op het symbool van de app waarin je werkt en al zijn vensters gaan naar het Dock. Klik nogmaals om ze allemaal terug te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ikonę aplikacji, w której jesteś, a wszystkie jej okna trafią do Docka. Kliknij ponownie, aby przywrócić je wszystkie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone do app em uso e todas as janelas dele descem para o Dock. Outro clique traz todas de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe pictograma aplicației în care vă aflați și toate ferestrele ei coboară în Dock. Faceți clic din nou ca să le readuceți pe toate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кликните по значку приложения, в котором работаете, — все его окна свернутся в Dock. Ещё клик — все вернутся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på symbolen för appen du använder så hamnar alla dess fönster i Dock. Klicka igen för att ta tillbaka alla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกไอคอนของแอปที่ใช้อยู่ แล้วหน้าต่างทั้งหมดของแอปจะลงไปอยู่ใน Dock คลิกอีกครั้งเพื่อให้ทุกหน้าต่างกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullandığınız uygulamanın simgesini tıklayınca tüm pencereleri Dock’a iner. Hepsini geri getirmek için yeniden tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть значок програми, у якій працюєте, — усі її вікна згорнуться в Dock. Ще клацання — усі повернуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào biểu tượng của ứng dụng đang dùng, mọi cửa sổ của nó sẽ thu xuống Dock. Bấm lần nữa để tất cả hiện lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按当前 App 的图标，它的所有窗口都会收进程序坞；再点按一次即可全部恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按目前使用中 App 的圖像，它的所有視窗都會收進 Dock；再點按一次即可全部顯示。"
          }
        }
      }
    },
