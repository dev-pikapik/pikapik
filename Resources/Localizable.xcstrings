          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildskärmen stannade inte på %@ och gick tillbaka till föregående storlek. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จอภาพไม่คงอยู่ที่ %@ และกลับไปเป็นขนาดเดิม ลองอีกครั้ง"
