            "value": "Este Mac no puede mostrar el monitor al %@ en este momento. Prueba otro tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne peut pas afficher l’écran à %@ pour le moment. Essayez une autre taille."
