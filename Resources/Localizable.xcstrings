    "Perks up while you type and dozes off when you step away": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشط وأنت تكتب ويغفو حين تبتعد"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když píšete, ožije, a když odejdete, podřimuje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird munter, während du tippst, und döst ein, wenn du weggehst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perks up while you type and dozes off when you step away"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anima mientras escribes y dormita cuando te alejas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’anime quand vous tapez et somnole quand vous vous éloignez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप टाइप करते हैं तो फुर्तीला हो जाता है और आपके जाते ही ऊँघने लगता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersemangat saat Anda mengetik dan terkantuk-kantuk saat Anda pergi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si anima mentre scrivi e sonnecchia quando ti allontani"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中は元気になり、席を離れると、うとうとします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑하는 동안엔 기운이 나고, 자리를 비우면 꾸벅꾸벅 좁니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt levendig als je typt en dommelt in als je wegloopt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ożywia się, gdy piszesz, i drzemie, gdy odchodzisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica animado enquanto você digita e cochila quando você se afasta"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se înviorează cât timp tastați și ațipește când vă îndepărtați"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бодрится, пока вы печатаете, и дремлет, когда вы отходите"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piggnar till när du skriver och slumrar när du går iväg"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระฉับกระเฉงขณะคุณพิมพ์ และงีบหลับเมื่อคุณลุกไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazarken canlanır, uzaklaştığınızda uyuklar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бадьориться, поки ви друкуєте, і дрімає, коли ви відходите"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hăng hái khi bạn gõ phím và ngủ gà ngủ gật khi bạn rời đi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打字时它精神抖擞，你走开时它打起瞌睡"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你打字時它精神抖擻，你走開時它打起瞌睡"
          }
        }
      }
    },
