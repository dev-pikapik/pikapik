          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe snel de Finder in de kolomweergave naar de volgende kolom gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
