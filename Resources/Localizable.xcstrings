    "All pikapik settings will be replaced with the ones from “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استبدال جميع إعدادات pikapik بالإعدادات الموجودة في «%@»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna nastavení pikapik budou nahrazena nastaveními ze souboru „%@“."
          }
        },
