    "Prevents an accidental close shortcut from closing the game window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع اختصار إغلاق غير مقصود من إغلاق نافذة اللعبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrání okno hry před omylem stisknutou zkratkou zavření."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass ein versehentlicher Schließen-Kurzbefehl das Spielfenster schließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents an accidental close shortcut from closing the game window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que un atajo accidental cierre la ventana del juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche un raccourci accidentel de fermer la fenêtre du jeu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलती से दबे बंद करने के शॉर्टकट से गेम की विंडो बंद होने से बचाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencegah pintasan tutup yang tak sengaja menutup jendela game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita che una scorciatoia accidentale chiuda la finestra del gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるショートカットの誤操作でゲームのウインドウが閉じるのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못 누른 닫기 단축키가 게임 윈도우를 닫지 못하게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt dat een onbedoelde sneltoets het gamevenster sluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroni okno gry przed przypadkowym skrótem zamknięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que um atalho acidental feche a janela do jogo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împiedică o scurtătură apăsată accidental să închidă fereastra jocului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищает окно игры от случайного нажатия сочетания закрытия."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrar ett oavsiktligt kortkommando från att stänga spelfönstret."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้องกันปุ่มลัดปิดที่กดโดยไม่ตั้งใจไม่ให้ปิดหน้าต่างเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlışlıkla basılan kapatma kısayolunun oyun penceresini kapatmasını önler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захищає вікно гри від випадкового натискання поєднання закриття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn phím tắt đóng bị nhấn nhầm đóng cửa sổ trò chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止误按关闭快捷键关闭游戏窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免誤按關閉快速鍵而關閉遊戲視窗。"
          }
        }
      }
    },
