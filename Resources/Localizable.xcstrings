          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS memerlukan port ini, jadi port ini tetap terpakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bisogno di questa porta, quindi resta occupata."
          }
        },
