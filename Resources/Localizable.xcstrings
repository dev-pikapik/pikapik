        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 Mac에서 모니터를 %@로 표시할 수 없습니다. 다른 크기를 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
