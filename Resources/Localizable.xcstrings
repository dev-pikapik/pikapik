            "value": "Nie udało się zapisać klatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o quadro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrul nu a putut fi salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить кадр."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildrutan kunde inte sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกเฟรมได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти кадр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu khung hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法存储此帧。"
          }
