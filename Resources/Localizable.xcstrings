    "Only some tools need these permissions, and the rest work without them": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج بعض الأدوات فقط إلى هذه الأذونات، وبقية الأدوات تعمل من دونها"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato oprávnění potřebují jen některé nástroje, ostatní fungují i bez nich"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur einige Tools brauchen diese Berechtigungen, alle anderen funktionieren auch ohne sie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only some tools need these permissions, and the rest work without them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo algunas herramientas necesitan estos permisos, y el resto funciona sin ellos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls certains outils ont besoin de ces autorisations, et les autres fonctionnent sans elles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये अनुमतियाँ सिर्फ़ कुछ टूल को चाहिए, बाकी इनके बिना भी काम करते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya beberapa alat yang memerlukan izin ini, sisanya tetap berfungsi tanpa izin ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo alcuni strumenti hanno bisogno di questi permessi, e il resto funziona anche senza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアクセス権が必要なのは一部のツールだけで、ほかの機能はアクセス権がなくても使えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한은 일부 도구에만 필요하며, 나머지는 권한 없이도 작동합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen sommige functies hebben deze toestemmingen nodig, de rest werkt ook zonder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te uprawnienia są potrzebne tylko niektórym narzędziom, a reszta działa bez nich"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só algumas ferramentas precisam dessas permissões, e o resto funciona sem elas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar unele instrumente au nevoie de aceste permisiuni, iar restul funcționează și fără ele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти разрешения нужны только некоторым инструментам, а всё остальное работает и без них"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara vissa verktyg behöver de här behörigheterna, och resten fungerar utan dem"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงเครื่องมือบางตัวที่ต้องใช้การอนุญาตเหล่านี้ ส่วนที่เหลือใช้งานได้โดยไม่ต้องอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu izinlere yalnızca bazı araçlar ihtiyaç duyar, geri kalanı izinsiz de çalışır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці дозволи потрібні лише деяким інструментам, а решта працює й без них"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ một số công cụ cần các quyền này, còn lại vẫn hoạt động mà không cần chúng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有部分工具需要这些权限，其他功能不授权也能正常使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有部分工具需要這些權限，其他功能不授權也能正常使用"
          }
        }
      }
    },
