    "Choose your home folder once so pikapik can save files next to yours and see your background tasks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلد المنزل مرة واحدة ليتمكن pikapik من حفظ الملفات بجانب ملفاتك ورؤية مهام الخلفية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jednou svou domovskou složku, aby pikapik mohl ukládat soubory vedle vašich a vidět vaše úlohy na pozadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einmal deinen Home-Ordner, damit pikapik Dateien neben deinen speichern und deine Hintergrundaufgaben sehen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your home folder once so pikapik can save files next to yours and see your background tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu carpeta de inicio una vez para que pikapik pueda guardar archivos junto a los tuyos y ver tus tareas en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une fois votre dossier personnel pour que pikapik puisse enregistrer des fichiers à côté des vôtres et voir vos tâches en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना होम फ़ोल्डर एक बार चुनें, ताकि pikapik आपकी फ़ाइलों के बगल में फ़ाइलें सहेज सके और आपके बैकग्राउंड टास्क देख सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder utama Anda sekali saja agar pikapik dapat menyimpan file di samping file Anda dan melihat tugas latar belakang Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una volta la tua cartella Home così pikapik potrà salvare i file accanto ai tuoi e vedere le tue attività in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik がファイルをあなたのファイルの隣に保存し、バックグラウンドタスクを表示できるよう、ホームフォルダを一度選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik이 내 파일 옆에 파일을 저장하고 백그라운드 작업을 볼 수 있도록 홈 폴더를 한 번만 선택해 주십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies één keer je thuismap, zodat pikapik bestanden naast de jouwe kan bewaren en je achtergrondtaken kan zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz raz swój folder domowy, aby pikapik mógł zapisywać pliki obok Twoich i widzieć Twoje zadania w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha sua pasta pessoal uma vez para o pikapik salvar arquivos ao lado dos seus e ver suas tarefas em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o singură dată folderul principal, ca pikapik să poată salva fișiere lângă ale dumneavoastră și să vadă sarcinile din fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите домашнюю папку один раз, чтобы pikapik мог сохранять файлы рядом с вашими и видеть ваши фоновые задачи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj din hemmapp en gång så att pikapik kan spara filer bredvid dina och se dina bakgrundsuppgifter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์โฮมของคุณหนึ่งครั้ง เพื่อให้ pikapik บันทึกไฟล์ไว้ข้างไฟล์ของคุณ และดูงานเบื้องหลังของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik’in dosyaları seninkilerin yanına kaydedebilmesi ve arka plan görevlerini görebilmesi için ana klasörünü bir kez seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть домашню папку один раз, щоб pikapik міг зберігати файли поруч із вашими й бачити ваші фонові завдання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn thư mục chính của bạn một lần để pikapik có thể lưu tệp cạnh tệp của bạn và xem các tác vụ nền của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一次你的个人文件夹，这样 pikapik 就能把文件保存在你的文件旁边，并查看你的后台任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一次你的個人檔案夾，這樣 pikapik 就能把檔案儲存在你的檔案旁邊，並查看你的背景工作。"
          }
        }
      }
    },
    "Choose “Scale Effect” for a quicker animation": {
      "extractionState": "manual",
      "localizations": {
