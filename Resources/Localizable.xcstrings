    "Takes about half a minute and runs on Apple’s servers. It can use a lot of data.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق نحو نصف دقيقة ويتم عبر خوادم Apple. قد يستهلك الكثير من البيانات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvá asi půl minuty a probíhá přes servery Apple. Může spotřebovat hodně dat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert etwa eine halbe Minute und läuft über Server von Apple. Kann viel Datenvolumen verbrauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes about half a minute and runs on Apple’s servers. It can use a lot of data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarda medio minuto y usa los servidores de Apple. Puede gastar muchos datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ une demi-minute, via les serveurs d’Apple. Le test peut consommer beaucoup de données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग आधा मिनट लगता है और जाँच Apple के सर्वर से होती है। इसमें काफ़ी डेटा खर्च हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Butuh sekitar setengah menit dan memakai server Apple. Bisa memakan banyak data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve circa mezzo minuto e passa dai server di Apple. Può consumare molti dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30秒ほどかかり、Appleのサーバを使います。データ通信量が多くなることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30초 정도 걸리며 Apple 서버로 측정합니다. 데이터를 많이 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duurt ongeveer een halve minuut en loopt via servers van Apple. Kan veel data verbruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa około pół minuty i korzysta z serwerów Apple. Może zużyć dużo danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva cerca de meio minuto e usa servidores da Apple. Pode gastar muitos dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Durează cam jumătate de minut și folosește serverele Apple. Poate consuma multe date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около полминуты, проверка идёт через серверы Apple. Может потратить много трафика."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar ungefär en halv minut och går via Apples servrar. Kan använda mycket data."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เวลาราวครึ่งนาทีและใช้เซิร์ฟเวอร์ของ Apple อาจใช้ข้อมูลมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık yarım dakika sürer ve Apple sunucularıyla yapılır. Çok veri kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Близько пів хвилини, перевірка йде через сервери Apple. Може витратити багато трафіку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất khoảng nửa phút và dùng máy chủ của Apple. Có thể tốn nhiều dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约半分钟，使用 Apple 的服务器。可能会消耗大量流量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大約半分鐘，使用 Apple 的伺服器。可能會消耗大量數據流量。"
          }
        }
      }
    },
