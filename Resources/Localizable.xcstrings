          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per salvare i nuovi file accanto ai tuoi e vedere le attività in background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいファイルをあなたのファイルの隣に保存し、バックグラウンドタスクを表示するため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 파일을 내 파일 옆에 저장하고 백그라운드 작업을 보는 데 필요"
