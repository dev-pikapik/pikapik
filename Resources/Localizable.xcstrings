          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi «Misura velocità» per scoprirlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「速度を測定」を押すと分かります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘속도 측정’을 눌러 확인하십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op ‘Test snelheid’ om het te weten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby się dowiedzieć, naciśnij „Sprawdź prędkość”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “Testar velocidade” para descobrir"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați „Verificați viteza” ca să aflați"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы узнать, нажмите «Проверить скорость»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ”Testa hastigheten” för att ta reda på det"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด “ตรวจความเร็ว” เพื่อดูผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenmek için “Hızı Ölç”e basın"
          }
        },
        "uk": {
