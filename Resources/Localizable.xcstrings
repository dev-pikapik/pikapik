    "Press Space and it jumps. Put the pointer in its way and it jumps over it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مفتاح المسافة فيقفز. ضع المؤشر في طريقه فيقفز فوقه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte mezerník a vyskočí. Postavte mu ukazatel do cesty a přeskočí ho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück die Leertaste, und es hüpft. Halt ihm den Zeiger in den Weg, und es springt darüber"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Space and it jumps. Put the pointer in its way and it jumps over it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Espacio y salta. Ponle el puntero en el camino y lo salta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Espace et il saute. Mettez le pointeur sur son chemin et il saute par-dessus"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेस दबाएँ और वह उछलेगा। पॉइंटर को उसके रास्ते में रखें और वह उसके ऊपर से कूद जाएगा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Spasi dan ia melompat. Taruh penunjuk di jalannya dan ia melompatinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Spazio e salta. Mettigli il puntatore davanti e ci salta sopra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを押すとジャンプします。ポインタを行く手に置くと、飛び越えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스페이스를 누르면 점프합니다. 포인터를 길에 두면 뛰어넘습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de spatiebalk en het springt. Zet de aanwijzer in de weg en het springt eroverheen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij spację, a podskoczy. Postaw mu wskaźnik na drodze, a go przeskoczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte Espaço e ele pula. Coloque o ponteiro no caminho e ele pula por cima"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați Spațiu și sare. Puneți-i cursorul în cale și sare peste el"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел — и он подпрыгнет. Поставьте курсор у него на пути — он через него перепрыгнет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på mellanslag så hoppar det. Ställ pekaren i vägen så hoppar det över den"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดเว้นวรรคแล้วมันจะกระโดด วางตัวชี้ขวางทางแล้วมันจะกระโดดข้าม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk tuşuna basın, zıplasın. İmleci yoluna koyun, üstünden atlasın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть пробіл — і він підстрибне. Поставте курсор йому на шляху — він його перестрибне"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn phím cách là nó nhảy. Đặt con trỏ chắn đường là nó nhảy qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按空格键它就会跳。把指针挡在它前面，它会跳过去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按空白鍵它就會跳。把指標擋在它前面，它會跳過去"
          }
        }
      }
    },
    "Press again for other layouts. Right after a fix, it undoes it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرة أخرى لتجربة تخطيطات أخرى. والضغط مباشرةً بعد التصحيح يتراجع عنه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalším stisknutím vyzkoušíte jiná rozložení. Hned po opravě ji tím vrátíte zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nochmal drücken: andere Layouts. Direkt nach einer Korrektur wird sie rückgängig gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press again for other layouts. Right after a fix, it undoes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa de nuevo para otras distribuciones. Justo después de una corrección, la deshace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez encore pour les autres dispositions. Juste après une correction, le raccourci l’annule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे लेआउट के लिए फिर दबाएँ। सुधार के तुरंत बाद दबाने पर सुधार पलट जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lagi untuk tata letak lain. Tepat setelah perbaikan, pintasan ini membatalkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo per altri layout. Subito dopo una correzione, la annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度押すと別のレイアウトに切り替わります。修正の直後なら元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 누르면 다른 레이아웃으로 바뀝니다. 바로잡은 직후에 누르면 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk nog eens voor andere indelingen. Direct na een correctie maak je die ermee ongedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ponownie, aby wybrać inny układ. Zaraz po poprawce skrót ją cofa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione de novo para outros layouts. Logo após uma correção, o atalho a desfaz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați din nou pentru alte aranjamente. Imediat după o corectare, o anulează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторное нажатие — другие раскладки. Сразу после исправления — отмена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck igen för andra layouter. Direkt efter en rättning ångras den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดอีกครั้งเพื่อเปลี่ยนเป็นรูปแบบอื่น กดทันทีหลังการแก้ไขเพื่อเลิกทำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer düzenler için yeniden basın. Bir düzeltmenin hemen ardından basarsanız düzeltme geri alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторне натискання — інші розкладки. Одразу після виправлення — скасування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn lần nữa để đổi sang bố cục khác. Ngay sau khi sửa, nhấn để hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次可换成其他布局。修正后立即按下则撤销修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次可換成其他配置。修正後立即按下則還原修正。"
          }
        }
      }
    },
