    "Thank you! It means a lot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لك! هذا يعني لنا الكثير."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Děkujeme! Moc to pro nás znamená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke! Das bedeutet uns viel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you! It means a lot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias! Significa mucho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci ! Cela compte beaucoup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद! हमारे लिए यह बहुत मायने रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih! Ini sangat berarti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie! Significa molto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます！とても励みになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다! 큰 힘이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt! Dat betekent veel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy! To dla nas dużo znaczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado! Isso significa muito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulțumim! Înseamnă mult pentru noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо! Нам очень приятно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack! Det betyder mycket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณมาก! มีความหมายกับเรามาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler! Bizim için çok değerli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо! Нам дуже приємно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn! Điều này rất ý nghĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢！这对我们意义重大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝！這對我們意義重大。"
          }
        }
      }
    },
    "The AirPlay device didn’t ask this Mac for the video. Make sure the Mac and the device are on the same network and that no VPN or firewall blocks connections inside it, then pick the device again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يطلب جهاز AirPlay الفيديو من هذا الـ Mac. تأكد من أن الـ Mac والجهاز على الشبكة نفسها، وأن أي VPN أو جدار حماية لا يمنع الاتصالات داخلها، ثم اختر الجهاز مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení AirPlay si video od tohoto Macu nevyžádalo. Ujistěte se, že Mac i zařízení jsou ve stejné síti a že VPN ani firewall v ní nebrání připojení, a pak zařízení vyberte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das AirPlay-Gerät hat das Video nicht bei diesem Mac angefordert. Stelle sicher, dass Mac und Gerät im selben Netzwerk sind und dass weder ein VPN noch eine Firewall Verbindungen darin blockiert, und wähle das Gerät dann erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AirPlay device didn’t ask this Mac for the video. Make sure the Mac and the device are on the same network and that no VPN or firewall blocks connections inside it, then pick the device again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo AirPlay no ha pedido el vídeo a este Mac. Asegúrate de que el Mac y el dispositivo estén en la misma red y de que ninguna VPN ni cortafuegos bloquee las conexiones dentro de ella, y vuelve a elegir el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil AirPlay n’a pas demandé la vidéo à ce Mac. Assurez-vous que le Mac et l’appareil sont sur le même réseau et qu’aucun VPN ni coupe-feu ne bloque les connexions à l’intérieur, puis sélectionnez à nouveau l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay डिवाइस ने इस Mac से वीडियो नहीं माँगा। पक्का करें कि Mac और डिवाइस एक ही नेटवर्क पर हैं और कोई VPN या फ़ायरवॉल उसके भीतर कनेक्शन नहीं रोक रहा, फिर डिवाइस को दोबारा चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat AirPlay tidak meminta video dari Mac ini. Pastikan Mac dan perangkat berada di jaringan yang sama dan tidak ada VPN atau firewall yang memblokir koneksi di dalamnya, lalu pilih perangkat lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo AirPlay non ha richiesto il video a questo Mac. Assicurati che il Mac e il dispositivo siano sulla stessa rete e che nessuna VPN o firewall blocchi le connessioni al suo interno, poi scegli di nuovo il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlayデバイスがこのMacにビデオを要求しませんでした。Macとデバイスが同じネットワークにあり、VPNやファイアウォールがそのネットワーク内の接続を妨げていないことを確認してから、もう一度デバイスを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 기기가 이 Mac에 비디오를 요청하지 않았습니다. Mac과 기기가 같은 네트워크에 있고 VPN이나 방화벽이 그 안의 연결을 막지 않는지 확인한 다음 기기를 다시 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AirPlay-apparaat heeft de video niet bij deze Mac opgevraagd. Zorg dat de Mac en het apparaat op hetzelfde netwerk zitten en dat geen vpn of firewall verbindingen daarbinnen blokkeert, en kies het apparaat dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie AirPlay nie poprosiło tego Maca o wideo. Upewnij się, że Mac i urządzenie są w tej samej sieci oraz że żaden VPN ani zapora nie blokuje połączeń w jej obrębie, a potem wybierz urządzenie ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo AirPlay não pediu o vídeo a este Mac. Verifique se o Mac e o dispositivo estão na mesma rede e se nenhuma VPN ou firewall bloqueia as conexões dentro dela e escolha o dispositivo de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivul AirPlay nu a cerut videoclipul de la acest Mac. Asigurați-vă că Mac-ul și dispozitivul sunt în aceeași rețea și că niciun VPN sau firewall nu blochează conexiunile din interiorul ei, apoi alegeți din nou dispozitivul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство AirPlay не запросило видео у этого Mac. Убедитесь, что Mac и устройство подключены к одной сети и что VPN или брандмауэр не блокируют соединения внутри неё, затем выберите устройство снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay-enheten bad inte den här Macen om videon. Kontrollera att Macen och enheten är på samma nätverk och att inget VPN eller ingen brandvägg blockerar anslutningar inom det, och välj sedan enheten igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ AirPlay ไม่ได้ขอวิดีโอจาก Mac เครื่องนี้ โปรดตรวจสอบว่า Mac และอุปกรณ์อยู่ในเครือข่ายเดียวกัน และไม่มี VPN หรือไฟร์วอลล์บล็อกการเชื่อมต่อภายในเครือข่ายนั้น แล้วเลือกอุปกรณ์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay aygıtı bu Mac’ten videoyu istemedi. Mac ile aygıtın aynı ağda olduğundan ve hiçbir VPN veya güvenlik duvarının ağ içindeki bağlantıları engellemediğinden emin olun, sonra aygıtı yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій AirPlay не запросив відео в цього Mac. Переконайтеся, що Mac і пристрій у тій самій мережі та що VPN чи брандмауер не блокують з’єднання всередині неї, а потім виберіть пристрій знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị AirPlay đã không yêu cầu video từ Mac này. Hãy đảm bảo Mac và thiết bị cùng một mạng và không có VPN hay tường lửa nào chặn kết nối trong mạng đó, rồi chọn lại thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 设备没有向这台 Mac 请求视频。请确认 Mac 和设备在同一网络中，且没有 VPN 或防火墙阻止网络内的连接，然后重新选择设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 裝置沒有向這部 Mac 要求影片。請確認 Mac 和裝置在同一網路中，且沒有 VPN 或防火牆封鎖網路內的連線，然後重新選擇裝置。"
          }
        }
      }
    },
    "The AirPlay device stopped playing this video, so playback continues on this Mac. Check that the device is turned on and on the same network, then pick it again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف جهاز AirPlay عن تشغيل هذا الفيديو، لذا يستمر التشغيل على هذا الـ Mac. تأكد من أن الجهاز قيد التشغيل وعلى الشبكة نفسها، ثم اخترْه مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení AirPlay přestalo toto video přehrávat, proto přehrávání pokračuje na tomto Macu. Zkontrolujte, že je zařízení zapnuté a ve stejné síti, a pak ho vyberte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das AirPlay-Gerät hat die Wiedergabe dieses Videos beendet, deshalb läuft sie auf diesem Mac weiter. Prüfe, ob das Gerät eingeschaltet und im selben Netzwerk ist, und wähle es dann erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AirPlay device stopped playing this video, so playback continues on this Mac. Check that the device is turned on and on the same network, then pick it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo AirPlay ha dejado de reproducir este vídeo, así que la reproducción continúa en este Mac. Comprueba que el dispositivo esté encendido y en la misma red, y vuelve a elegirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil AirPlay a arrêté de lire cette vidéo ; la lecture continue donc sur ce Mac. Vérifiez que l’appareil est allumé et connecté au même réseau, puis sélectionnez-le à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay डिवाइस ने यह वीडियो चलाना बंद कर दिया, इसलिए प्लेबैक इस Mac पर जारी है। जाँचें कि डिवाइस चालू है और उसी नेटवर्क पर है, फिर उसे दोबारा चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat AirPlay berhenti memutar video ini, jadi pemutaran dilanjutkan di Mac ini. Pastikan perangkat menyala dan berada di jaringan yang sama, lalu pilih lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo AirPlay ha smesso di riprodurre questo video, quindi la riproduzione continua su questo Mac. Controlla che il dispositivo sia acceso e sulla stessa rete, poi sceglilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlayデバイスがこのビデオの再生を止めたため、このMacで再生を続けます。デバイスの電源が入っていて同じネットワークにあることを確認してから、もう一度選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 기기가 이 비디오 재생을 멈춰서 이 Mac에서 계속 재생합니다. 기기가 켜져 있고 같은 네트워크에 있는지 확인한 다음 다시 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AirPlay-apparaat is gestopt met het afspelen van deze video, dus het afspelen gaat verder op deze Mac. Controleer of het apparaat aanstaat en op hetzelfde netwerk zit en kies het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie AirPlay przestało odtwarzać to wideo, więc odtwarzanie trwa dalej na tym Macu. Sprawdź, czy urządzenie jest włączone i w tej samej sieci, a potem wybierz je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo AirPlay parou de reproduzir este vídeo, então a reprodução continua neste Mac. Verifique se o dispositivo está ligado e na mesma rede e escolha-o de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivul AirPlay a oprit redarea acestui videoclip, așa că redarea continuă pe acest Mac. Verificați dacă dispozitivul este pornit și în aceeași rețea, apoi alegeți-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство AirPlay перестало показывать это видео, поэтому воспроизведение продолжается на этом Mac. Проверьте, что устройство включено и подключено к той же сети, затем выберите его снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay-enheten slutade spela upp videon, så uppspelningen fortsätter på den här Macen. Kontrollera att enheten är påslagen och på samma nätverk och välj den sedan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ AirPlay หยุดเล่นวิดีโอนี้ จึงเล่นต่อบน Mac เครื่องนี้ โปรดตรวจสอบว่าอุปกรณ์เปิดอยู่และอยู่ในเครือข่ายเดียวกัน แล้วเลือกอุปกรณ์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay aygıtı bu videoyu oynatmayı durdurdu, bu yüzden oynatma bu Mac’te devam ediyor. Aygıtın açık ve aynı ağda olduğunu kontrol edin, sonra yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій AirPlay перестав показувати це відео, тому відтворення триває на цьому Mac. Переконайтеся, що пристрій увімкнено й він у тій самій мережі, а потім виберіть його знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị AirPlay đã ngừng phát video này nên video tiếp tục phát trên Mac này. Hãy kiểm tra thiết bị đã bật và cùng mạng, rồi chọn lại thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 设备已停止播放此视频，因此这台 Mac 会继续播放。请确认设备已开启并在同一网络中，然后重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 裝置已停止播放此影片，因此這部 Mac 會繼續播放。請確認裝置已開啟並在同一網路中，然後重新選擇。"
          }
        }
      }
    },
    "The Dock goes with it. Turning the switch off puts the displays back as they were": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل Dock معها. إيقاف المفتاح يعيد الشاشات كما كانت"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock se přesune s ním. Vypnutím přepínače se monitory vrátí, jak byly"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dock zieht mit um. Schaltest du den Schalter aus, kommen die Bildschirme wieder an ihren alten Platz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dock goes with it. Turning the switch off puts the displays back as they were"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock se va con ella. Al apagar el interruptor, las pantallas vuelven a como estaban"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock la suit. En désactivant l’interrupteur, les écrans reprennent leur place d’origine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock भी उसी के साथ जाता है। स्विच बंद करने पर डिस्प्ले पहले जैसे हो जाते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock ikut berpindah. Mematikan sakelar mengembalikan layar seperti semula"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Dock la segue. Spegnendo l’interruttore, gli schermi tornano come prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock も一緒に移ります。スイッチをオフにすると、ディスプレイの配置は元に戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock도 함께 이동합니다. 스위치를 끄면 디스플레이 배치가 원래대로 돌아갑니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Dock gaat mee. Zet je de schakelaar uit, dan staan de beeldschermen weer zoals ze waren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock przenosi się razem z nim. Wyłączenie przełącznika przywraca poprzedni układ wyświetlaczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock vai junto. Ao desligar a chave, as telas voltam a ficar como estavam"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-ul se mută odată cu el. Dacă opriți comutatorul, afișajele revin cum erau"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock переезжает вместе с ним. Если выключить переключатель, дисплеи вернутся как были"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock följer med. Stänger du av reglaget återgår skärmarna till hur de var"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock จะย้ายตามไปด้วย การปิดสวิตช์จะคืนการจัดวางจอภาพกลับเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock da onunla taşınır. Anahtarı kapatmak ekranları eski düzenine döndürür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock переходить разом із ним. Якщо вимкнути перемикач, дисплеї повернуться як були"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock chuyển theo. Tắt công tắc sẽ đưa các màn hình về như cũ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序坞会随之移动。关闭开关后，显示器会恢复原样"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 會跟著移動。關閉開關後，顯示器會恢復原樣"
          }
        }
      }
    },
    "The Dock no longer jumps to another display when the pointer hits its bottom edge, however fast you move. To move the Dock, make another display the main one. Turning this on or off restarts the Dock.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد Dock ينتقل إلى شاشة أخرى عندما يصل المؤشر إلى حافتها السفلية، مهما كانت سرعة الحركة. لنقل Dock، اجعل شاشة أخرى هي الشاشة الرئيسية. تشغيل هذا الخيار أو إيقافه يعيد تشغيل Dock."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock už nepřeskakuje na jiný displej, když ukazatel dojede k jeho spodnímu okraji, ať s ním pohybujete jakkoli rychle. Chcete-li Dock přesunout, nastavte jako hlavní jiný displej. Zapnutím nebo vypnutím se Dock restartuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dock springt nicht mehr auf ein anderes Display, wenn der Zeiger dessen unteren Rand erreicht, egal wie schnell du ihn bewegst. Um das Dock zu verschieben, mach ein anderes Display zum Hauptbildschirm. Beim Ein- und Ausschalten startet das Dock neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dock no longer jumps to another display when the pointer hits its bottom edge, however fast you move. To move the Dock, make another display the main one. Turning this on or off restarts the Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock ya no salta a otra pantalla cuando el puntero llega a su borde inferior, por muy rápido que lo muevas. Para mover el Dock, haz que otra pantalla sea la principal. Al activar o desactivar esta opción, el Dock se reinicia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock ne saute plus sur un autre écran quand le pointeur atteint son bord inférieur, même si vous le déplacez très vite. Pour déplacer le Dock, faites d’un autre écran l’écran principal. Activer ou désactiver cette option redémarre le Dock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉइंटर किसी दूसरे डिस्प्ले के निचले किनारे तक पहुँचे, तब भी Dock अब उस पर नहीं जाता, चाहे आप कितनी भी तेज़ी से हिलाएँ। Dock को ले जाने के लिए किसी दूसरे डिस्प्ले को मुख्य बनाएँ। इसे चालू या बंद करने पर Dock फिर से शुरू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock tidak lagi melompat ke layar lain saat penunjuk mencapai tepi bawahnya, secepat apa pun Anda menggerakkannya. Untuk memindahkan Dock, jadikan layar lain sebagai layar utama. Menyalakan atau mematikan opsi ini akan memulai ulang Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Dock non salta più su un altro schermo quando il puntatore ne raggiunge il bordo inferiore, per quanto velocemente tu lo muova. Per spostare il Dock, rendi principale un altro schermo. Attivando o disattivando questa opzione, il Dock si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタが別のディスプレイの下端に届いても、Dockはそちらへ移動しなくなります。どんなに速く動かしても同じです。Dockを移動するには、別のディスプレイを主ディスプレイにします。オン/オフを切り替えるとDockが再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터가 다른 디스플레이의 아래쪽 가장자리에 닿아도, 아무리 빠르게 움직여도 Dock이 그쪽으로 옮겨 가지 않습니다. Dock을 옮기려면 다른 디스플레이를 메인 디스플레이로 지정하십시오. 켜거나 끄면 Dock이 다시 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Dock springt niet meer naar een ander scherm als de aanwijzer de onderrand ervan bereikt, hoe snel je ook beweegt. Maak een ander scherm het hoofdbeeldscherm om het Dock te verplaatsen. Als je dit aan- of uitzet, start het Dock opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock nie przeskakuje już na inny ekran, gdy wskaźnik dotrze do jego dolnej krawędzi, niezależnie od tego, jak szybko go przesuwasz. Aby przenieść Dock, ustaw inny ekran jako główny. Włączenie lub wyłączenie tej opcji uruchamia Dock ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock não pula mais para outra tela quando o ponteiro chega à borda inferior dela, por mais rápido que você o mova. Para mover o Dock, torne outra tela a principal. Ativar ou desativar esta opção reinicia o Dock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-ul nu mai sare pe alt ecran când cursorul ajunge la marginea de jos a acestuia, oricât de repede l-ați mișca. Pentru a muta Dock-ul, setați alt ecran ca principal. Activarea sau dezactivarea acestei opțiuni repornește Dock-ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock больше не перескакивает на другой дисплей, когда указатель доходит до его нижнего края, как бы быстро он ни двигался. Чтобы перенести Dock, сделайте основным другой дисплей. При включении и выключении Dock перезапускается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock hoppar inte längre till en annan skärm när pekaren når dess nederkant, hur snabbt du än rör den. Gör en annan skärm till huvudbildskärm för att flytta Dock. Dock startas om när du slår på eller av det här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock จะไม่กระโดดไปยังจออื่นอีกเมื่อตัวชี้ไปถึงขอบล่างของจอนั้น ไม่ว่าจะขยับเร็วแค่ไหน หากต้องการย้าย Dock ให้ตั้งจออื่นเป็นจอภาพหลัก การเปิดหรือปิดตัวเลือกนี้จะเริ่ม Dock ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç başka bir ekranın alt kenarına ulaştığında, ne kadar hızlı hareket ettirirseniz ettirin Dock artık o ekrana atlamaz. Dock’u taşımak için başka bir ekranı ana ekran yapın. Bunu açıp kapatmak Dock’u yeniden başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock більше не перескакує на інший екран, коли вказівник доходить до його нижнього краю, хоч як швидко він рухається. Щоб перенести Dock, зробіть основним інший екран. Під час увімкнення і вимкнення Dock перезапускається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock không còn nhảy sang màn hình khác khi con trỏ chạm cạnh dưới của màn hình đó, dù bạn di chuyển nhanh đến đâu. Để di chuyển Dock, hãy đặt màn hình khác làm màn hình chính. Bật hoặc tắt tùy chọn này sẽ khởi động lại Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针移到另一台显示器的底部边缘时，无论移动多快，程序坞都不会再跳到那台显示器上。要移动程序坞，请将另一台显示器设为主显示器。打开或关闭此选项会重新启动程序坞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標移到另一台顯示器的底部邊緣時，無論移動多快，Dock 都不會再跳到那台顯示器上。若要移動 Dock，請將另一台顯示器設為主要顯示器。開啟或關閉此選項會重新啟動 Dock。"
          }
        }
      }
    },
    "The Dock, menu bar and hot corners don’t pop up, and the pointer doesn’t slip onto another screen": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يظهر Dock وشريط القائمة والزوايا النشطة فجأة، ولا ينتقل المؤشر إلى شاشة أخرى"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, řádek nabídek a aktivní rohy nevyskakují a ukazatel neuteče na jinou obrazovku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, Menüleiste und aktive Ecken springen nicht auf, und der Zeiger rutscht nicht auf einen anderen Bildschirm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dock, menu bar and hot corners don’t pop up, and the pointer doesn’t slip onto another screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock, la barra de menús y las esquinas activas no aparecen, y el puntero no se escapa a otra pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock, la barre des menus et les coins actifs ne surgissent pas, et le pointeur ne glisse pas vers un autre écran"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, मेनू बार और हॉट कॉर्नर अचानक नहीं खुलते, और पॉइंटर दूसरी स्क्रीन पर नहीं जाता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, bar menu, dan sudut aktif tidak muncul tiba-tiba, dan penunjuk tidak lari ke layar lain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Dock, la barra dei menu e gli angoli attivi non spuntano fuori, e il puntatore non scivola su un altro schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock、メニューバー、ホットコーナーが出てこず、ポインタがほかの画面へ移りません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, 메뉴 막대, 핫 코너가 튀어나오지 않고, 포인터가 다른 화면으로 넘어가지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Dock, de menubalk en actieve hoeken springen niet tevoorschijn, en de aanwijzer glipt niet naar een ander scherm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, pasek menu i aktywne narożniki nie wyskakują, a wskaźnik nie ucieka na inny ekran"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock, a barra de menus e os cantos ativos não aparecem, e o ponteiro não escapa para outra tela"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-ul, bara de meniu și colțurile active nu apar, iar cursorul nu fuge pe alt ecran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, строка меню и активные углы не выскакивают, а указатель не уходит на другой дисплей"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, menyraden och aktiva hörn dyker inte upp, och pekaren glider inte över till en annan skärm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, แถบเมนู และมุมลัดไม่โผล่ขึ้นมา และตัวชี้ไม่หลุดไปยังหน้าจออื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, menü çubuğu ve etkin köşeler açılmaz, imleç başka bir ekrana kaymaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, рядок меню й активні кути не вискакують, а курсор не переходить на інший екран"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock, thanh menu và góc nóng không bật ra, và con trỏ không trượt sang màn hình khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序坞、菜单栏和触发角不会弹出，指针也不会跑到另一块屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock、選單列和熱點不會跳出來，指標也不會跑到另一個螢幕"
          }
        }
      }
    },
    "The Mac can’t show this monitor at %@ sharply, so pikapik offers %@, the closest sharp size.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الـ Mac عرض هذه الشاشة بحجم %1$@ بوضوح، لذا يقدّم pikapik ‏%2$@، وهو أقرب حجم واضح."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nedokáže tento monitor zobrazit ostře na %1$@, a tak pikapik nabízí %2$@, nejbližší ostrou velikost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac kann diesen Monitor nicht scharf mit %1$@ anzeigen, deshalb bietet pikapik %2$@ an, die nächste scharfe Größe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac can’t show this monitor at %@ sharply, so pikapik offers %@, the closest sharp size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac no puede mostrar este monitor al %1$@ con nitidez, así que pikapik ofrece el %2$@, el tamaño nítido más cercano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac ne peut pas afficher cet écran à %1$@ avec netteté : pikapik propose donc %2$@, la taille nette la plus proche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac इस मॉनिटर को %1$@ पर साफ़ नहीं दिखा सकता, इसलिए pikapik %2$@ देता है, जो सबसे नज़दीकी साफ़ आकार है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tidak dapat menampilkan monitor ini pada %1$@ dengan tajam, jadi pikapik menawarkan %2$@, ukuran tajam yang terdekat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac non può mostrare questo monitor al %1$@ in modo nitido, quindi pikapik offre il %2$@, la dimensione nitida più vicina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macはこのモニタを%1$@でくっきり表示できないため、pikapikはいちばん近いくっきり表示できるサイズの%2$@を用意しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 이 모니터를 %1$@로 선명하게 표시할 수 없어서, pikapik은 가장 가까운 선명한 크기인 %2$@를 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Mac kan deze monitor niet scherp op %1$@ weergeven, dus biedt pikapik %2$@, de dichtstbijzijnde scherpe grootte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nie może wyświetlić tego monitora ostro w skali %1$@, więc pikapik proponuje %2$@, najbliższy ostry rozmiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac não consegue mostrar este monitor em %1$@ com nitidez, então o pikapik oferece %2$@, o tamanho nítido mais próximo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul nu poate afișa clar acest monitor la %1$@, așa că pikapik oferă %2$@, cea mai apropiată dimensiune clară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не может показать этот монитор в масштабе %1$@ чётко, поэтому pikapik предлагает %2$@ — ближайший чёткий размер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-datorn kan inte visa den här bildskärmen skarpt i %1$@, så pikapik erbjuder %2$@, den närmaste skarpa storleken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac แสดงจอภาพนี้ที่ %1$@ ให้คมชัดไม่ได้ pikapik จึงเสนอ %2$@ ซึ่งเป็นขนาดคมชัดที่ใกล้ที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac bu monitörü %1$@ değerinde net gösteremiyor, bu yüzden pikapik en yakın net boyut olan %2$@ değerini sunuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не може показати цей монітор у масштабі %1$@ чітко, тому pikapik пропонує %2$@ — найближчий чіткий розмір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac không thể hiển thị màn hình này ở %1$@ sắc nét, nên pikapik đưa ra %2$@, kích thước sắc nét gần nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 无法以 %1$@ 清晰显示这台显示器，因此 pikapik 提供 %2$@，即最接近的清晰大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 無法以 %1$@ 清晰顯示這台顯示器，因此 pikapik 提供 %2$@，也就是最接近的清晰大小。"
          }
        }
      }
    },
