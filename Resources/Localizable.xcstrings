        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी चालू करने पर यह तब तक चालू रहेगा जब तक आप इसे बंद नहीं करते"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diaktifkan sekarang, tetap aktif sampai Anda mematikannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo attivi adesso, resta attivo finché non lo spegni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまオンにすると、オフにするまでオンのままです"
