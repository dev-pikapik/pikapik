            "value": "배터리 상태를 확인하고 더 오래 쓰는 방법을 알아보십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk hoe het met je batterij gaat en hoe je hem langer laat meegaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, jak się miewa bateria i jak sprawić, by działała dłużej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja como está a sua bateria e como fazer com que ela dure mais"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți cum stă bateria și cum o puteți face să țină mai mult"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, в каком состоянии аккумулятор и как продлить его срок службы"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hur batteriet mår och hur du får det att räcka längre"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าแบตเตอรี่ของคุณเป็นอย่างไรบ้าง และจะทำให้ใช้ได้นานขึ้นได้อย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilinizin durumunu ve ömrünü nasıl uzatacağınızı görün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, в якому стані акумулятор і як зробити, щоб він служив довше"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem pin của bạn đang thế nào và cách giúp pin dùng được lâu hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看电池的状况，以及如何让它更耐用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看電池的狀況，以及如何讓它更耐用"
          }
        }
      }
    },
