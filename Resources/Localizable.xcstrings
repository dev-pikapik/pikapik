          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rapidez com que o Finder passa para a próxima coluna na visualização em colunas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de repede trece Finder la coloana următoare în vizualizarea pe coloane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро Finder переходит к следующей колонке в режиме колонок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur snabbt Finder går till nästa kolumn i kolumnvyn."
          }
