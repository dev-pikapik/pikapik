            "value": "La app se oculta con todas sus ventanas, como con ⌘H"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app disparaît avec toutes ses fenêtres, comme avec ⌘H"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप अपनी सारी विंडो के साथ छिप जाता है, ⌘H की तरह"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App bersembunyi bersama semua jendelanya, seperti dengan ⌘H"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app si nasconde con tutte le sue finestre, come con ⌘H"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがすべてのウインドウごと隠れます。⌘Hと同じです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 모든 윈도우와 함께 가리기, ⌘H처럼"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app verbergt zich met al zijn vensters, zoals met ⌘H"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja chowa się ze wszystkimi oknami, jak po ⌘H"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app fica oculto com todas as janelas, como com ⌘H"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația se ascunde cu toate ferestrele ei, ca la ⌘H"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение скрывается со всеми окнами, как по ⌘H"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen gömmer sig med alla sina fönster, som med ⌘H"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะซ่อนไปพร้อมหน้าต่างทั้งหมด เหมือนกด ⌘H"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama tüm pencereleriyle gizlenir, ⌘H gibi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма ховається з усіма вікнами, як за ⌘H"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng ẩn đi cùng mọi cửa sổ, giống ⌘H"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 连同所有窗口一起隐藏，和 ⌘H 一样"
          }
        },
        "zh-Hant": {
