    "Walks along the bottom of the screen, behind your windows and the Dock. Try picking it up!": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتمشّى على طول أسفل الشاشة، خلف نوافذك وخلف Dock. جرّب أن ترفعه!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochází se po spodním okraji obrazovky, za vašimi okny a Dockem. Zkuste ho zvednout!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziert am unteren Bildschirmrand entlang, hinter deinen Fenstern und dem Dock. Heb es doch mal hoch!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walks along the bottom of the screen, behind your windows and the Dock. Try picking it up!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasea por la parte de abajo de la pantalla, detrás de tus ventanas y del Dock. ¡Prueba a levantarlo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se promène le long du bas de l’écran, derrière vos fenêtres et le Dock. Essayez de l’attraper !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन के निचले किनारे पर, आपकी विंडो और Dock के पीछे टहलता है। उसे उठाकर तो देखिए!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan-jalan di tepi bawah layar, di belakang jendela dan Dock. Coba angkat dia!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passeggia lungo il bordo inferiore dello schermo, dietro le tue finestre e il Dock. Prova a prenderlo in braccio!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウやDockの後ろで、画面の下の端をお散歩します。つまみ上げてみて！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우와 Dock 뒤에서 화면 아래쪽 가장자리를 따라 산책합니다. 한번 들어 올려 보십시오!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt langs de onderkant van het scherm, achter je vensters en het Dock. Pak het maar eens op!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceruje wzdłuż dolnej krawędzi ekranu, za twoimi oknami i Dockiem. Spróbuj go podnieść!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passeia pela parte de baixo da tela, atrás das suas janelas e do Dock. Experimente pegá-lo!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se plimbă de-a lungul marginii de jos a ecranului, în spatele ferestrelor și al Dock-ului. Încercați să-l ridicați!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гуляет по нижнему краю экрана, за окнами и Dock. Попробуйте его поднять!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Promenerar längs skärmens nederkant, bakom dina fönster och Dock. Testa att lyfta upp det!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดินเล่นไปตามขอบล่างของหน้าจอ อยู่หลังหน้าต่างและ Dock ลองจับยกขึ้นดูสิ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranın alt kenarında, pencerelerinizin ve Dock’un arkasında dolaşır. Onu tutup kaldırmayı deneyin!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гуляє нижнім краєм екрана, за вікнами й Dock. Спробуйте його підняти!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi dạo dọc mép dưới màn hình, phía sau các cửa sổ và Dock. Thử nhấc nó lên xem!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗口和程序坞后面，沿着屏幕底边散步。试试把它拎起来！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在視窗和 Dock 後面，沿著螢幕底邊散步。試試把它拎起來！"
          }
        }
      }
    },
