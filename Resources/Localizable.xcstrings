        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac अभी मॉनिटर को %@ पर नहीं दिखा सकता। कोई दूसरा आकार आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak dapat menampilkan monitor pada %@ saat ini. Coba ukuran lain."
          }
        },
        "it": {
          "stringUnit": {
