        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤쪽 버튼은 뒤로, 앞쪽 버튼은 앞으로"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Achterste knop gaat terug, voorste knop gaat vooruit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylny przycisk – wstecz, przedni – dalej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão traseiro volta, o dianteiro avança"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Butonul din spate merge înapoi, cel din față înainte"
