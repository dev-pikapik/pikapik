    "Finder closes its windows and opens again. Wait until files finish copying.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيغلق Finder نوافذه ثم يفتح من جديد. انتظر حتى تنتهي عمليات نسخ الملفات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder zavře svá okna a znovu se otevře. Počkejte, až se dokončí kopírování souborů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder schließt seine Fenster und öffnet sich wieder. Warte, bis alle Kopiervorgänge fertig sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder closes its windows and opens again. Wait until files finish copying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder cierra sus ventanas y vuelve a abrirse. Espera a que terminen las copias de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder ferme ses fenêtres puis se rouvre. Attendez la fin des copies de fichiers en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder अपनी विंडो बंद करके फिर से खुलेगा। फ़ाइलों की कॉपी पूरी होने तक रुकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder menutup jendelanya lalu terbuka lagi. Tunggu sampai penyalinan file selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Finder chiude le sue finestre e si riapre. Aspetta che finiscano le copie dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderはウインドウを閉じてから再び開きます。ファイルのコピーが終わるまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder가 윈도우를 닫고 다시 열립니다. 파일 복사가 끝날 때까지 기다리십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Finder sluit zijn vensters en opent opnieuw. Wacht tot het kopiëren van bestanden klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder zamknie swoje okna i otworzy się ponownie. Poczekaj, aż skończy się kopiowanie plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Finder fecha as janelas e abre de novo. Espere as cópias de arquivos terminarem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder își închide ferestrele și se deschide din nou. Așteptați să se termine copierea fișierelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder закроет свои окна и откроется снова. Дождитесь, пока закончится копирование файлов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder stänger sina fönster och öppnas igen. Vänta tills alla kopieringar är klara."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder จะปิดหน้าต่างแล้วเปิดใหม่ รอให้การคัดลอกไฟล์เสร็จก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder pencerelerini kapatıp yeniden açılır. Dosya kopyalama işlemlerinin bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder закриє свої вікна й відкриється знову. Дочекайтеся, поки завершиться копіювання файлів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder sẽ đóng các cửa sổ rồi mở lại. Hãy đợi việc sao chép tệp xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达会关闭其窗口并重新打开。请等待文件拷贝完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 會關閉其視窗並重新打開。請等待檔案拷貝完成。"
          }
        }
      }
    },
    "Finder picks up the changes after a restart": {
