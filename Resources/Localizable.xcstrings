        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai ulang Finder sekali agar item klik kanan muncul lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia il Finder una volta per ritrovare le voci del clic destro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderを一度再起動すると、右クリックの項目が戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder를 한 번 재시작하면 우클릭 항목이 다시 나타납니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstart de Finder één keer om de rechtsklik-opties terug te krijgen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom ponownie Finder jeden raz, aby wróciły pozycje z menu prawego kliku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Finder uma vez para trazer de volta as opções do clique direito"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporniți Finder o dată ca să revină opțiunile de la clic dreapta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите Finder один раз, чтобы вернуть пункты правого клика"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta om Finder en gång så kommer högerklicksvalen tillbaka"
          }
        },
        "th": {
