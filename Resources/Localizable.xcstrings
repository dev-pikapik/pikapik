    "Tap or click with three or four fingers to open a link in a new tab or close a tab, like the middle mouse button.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط أو انقر بثلاثة أصابع أو أربعة لفتح رابط في علامة تبويب جديدة أو إغلاق علامة تبويب، مثل زر الماوس الأوسط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím nebo kliknutím třemi či čtyřmi prsty otevřete odkaz na nové kartě nebo zavřete kartu, jako prostředním tlačítkem myši."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oder klicke mit drei oder vier Fingern, um einen Link in einem neuen Tab zu öffnen oder einen Tab zu schließen – wie mit der mittleren Maustaste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or click with three or four fingers to open a link in a new tab or close a tab, like the middle mouse button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca o haz clic con tres o cuatro dedos para abrir un enlace en una pestaña nueva o cerrar una pestaña, como con el botón central del ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ou cliquez avec trois ou quatre doigts pour ouvrir un lien dans un nouvel onglet ou fermer un onglet, comme avec le bouton du milieu de la souris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन या चार उँगलियों से टैप या क्लिक करें, ताकि लिंक नए टैब में खुले या टैब बंद हो, बिल्कुल माउस के बीच वाले बटन की तरह।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk atau klik dengan tiga atau empat jari untuk membuka tautan di tab baru atau menutup tab, seperti tombol tengah tetikus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca o fai clic con tre o quattro dita per aprire un link in una nuova scheda o chiudere una scheda, come con il tasto centrale del mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3本指か4本指でタップまたはクリックすると、マウスの中央ボタンと同じように、リンクを新しいタブで開いたりタブを閉じたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 손가락이나 네 손가락으로 탭하거나 클릭하면 마우스 가운데 버튼처럼 링크를 새 탭에서 열거나 탭을 닫을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik of klik met drie of vier vingers om een link in een nieuw tabblad te openen of een tabblad te sluiten, net als met de middelste muisknop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij lub kliknij trzema albo czterema palcami, aby otworzyć link w nowej karcie lub zamknąć kartę, jak środkowym przyciskiem myszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque ou clique com três ou quatro dedos para abrir um link em uma nova aba ou fechar uma aba, como com o botão do meio do mouse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți sau faceți clic cu trei sau patru degete ca să deschideți un link într-o filă nouă sau să închideți o filă, ca și cu butonul din mijloc al mausului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь или нажмите тремя или четырьмя пальцами, чтобы открыть ссылку в новой вкладке или закрыть вкладку, как средней кнопкой мыши."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck eller klicka med tre eller fyra fingrar för att öppna en länk i en ny flik eller stänga en flik, som med mittknappen på en mus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะหรือคลิกด้วยสามหรือสี่นิ้วเพื่อเปิดลิงก์ในแท็บใหม่หรือปิดแท็บ เหมือนปุ่มกลางของเมาส์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantıyı yeni sekmede açmak ya da bir sekmeyi kapatmak için üç veya dört parmakla dokunun ya da tıklayın; farenin orta düğmesi gibi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться або клацніть трьома чи чотирма пальцями, щоб відкрити посилання в новій вкладці або закрити вкладку, як середньою кнопкою миші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm hoặc bấm bằng ba hoặc bốn ngón tay để mở liên kết trong tab mới hoặc đóng tab, giống như nút giữa của chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用三指或四指轻点或点按，即可在新标签页中打开链接或关闭标签页，就像鼠标中键一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用三指或四指點一下或按一下，即可在新標籤頁中打開連結或關閉標籤頁，就像滑鼠的中間按鈕一樣。"
          }
        }
      }
    },
