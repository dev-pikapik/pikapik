    "Choose this folder so pikapik can save files next to yours.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر هذا المجلد ليتمكن pikapik من حفظ الملفات بجانب ملفاتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte tuto složku, aby pikapik mohl ukládat soubory vedle vašich."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle diesen Ordner, damit pikapik Dateien neben deinen speichern kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this folder so pikapik can save files next to yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige esta carpeta para que pikapik pueda guardar archivos junto a los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce dossier pour que pikapik puisse enregistrer des fichiers à côté des vôtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोल्डर चुनें, ताकि pikapik आपकी फ़ाइलों के बगल में फ़ाइलें सहेज सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder ini agar pikapik dapat menyimpan file di samping file Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli questa cartella così pikapik potrà salvare i file accanto ai tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik がファイルをあなたのファイルの隣に保存できるよう、このフォルダを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik이 내 파일 옆에 파일을 저장할 수 있도록 이 폴더를 선택해 주십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies deze map, zodat pikapik bestanden naast de jouwe kan bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ten folder, aby pikapik mógł zapisywać pliki obok Twoich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha esta pasta para o pikapik salvar arquivos ao lado dos seus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți acest folder, ca pikapik să poată salva fișiere lângă ale dumneavoastră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите эту папку, чтобы pikapik мог сохранять файлы рядом с вашими."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj den här mappen så att pikapik kan spara filer bredvid dina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์นี้ เพื่อให้ pikapik บันทึกไฟล์ไว้ข้างไฟล์ของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik’in dosyaları seninkilerin yanına kaydedebilmesi için bu klasörü seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть цю папку, щоб pikapik міг зберігати файли поруч із вашими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn thư mục này để pikapik có thể lưu tệp cạnh tệp của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择此文件夹，这样 pikapik 就能把文件保存在你的文件旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇此檔案夾，這樣 pikapik 就能把檔案儲存在你的檔案旁邊。"
          }
        }
      }
    },
