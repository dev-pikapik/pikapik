    "Your Mac is slowing down to cool off. Closing heavy apps will help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبطئ جهاز Mac ليبرد. سيساعد إغلاق التطبيقات الثقيلة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac zpomaluje, aby vychladl. Pomůže zavřít náročné aplikace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac wird langsamer, um abzukühlen. Schließ aufwendige Apps, das hilft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is slowing down to cool off. Closing heavy apps will help"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac va más lento para enfriarse. Cerrar las apps pesadas ayudará"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac ralentit pour refroidir. Fermer les apps gourmandes aidera"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठंडा होने के लिए आपका Mac धीमा हो रहा है। भारी ऐप्स बंद करने से मदद मिलेगी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda melambat agar dingin. Menutup app yang berat akan membantu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac sta rallentando per raffreddarsi. Chiudere le app pesanti aiuterà"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は温度を下げるために速度を落としています。負荷の高いアプリを終了すると効果があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 열을 식히기 위해 느려지고 있습니다. 무거운 앱을 닫으면 도움이 됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac wordt trager om af te koelen. Zware apps sluiten helpt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac zwalnia, aby ostygnąć. Zamknięcie wymagających aplikacji pomoże"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac está ficando mais lento para esfriar. Fechar apps pesados vai ajudar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul încetinește ca să se răcească. Închiderea aplicațiilor solicitante va ajuta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac замедляется, чтобы остыть. Закройте тяжёлые приложения, это поможет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac går långsammare för att svalna. Det hjälper att stänga tunga appar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ของคุณกำลังช้าลงเพื่อลดความร้อน การปิดแอปที่ใช้ทรัพยากรมากจะช่วยได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz soğumak için yavaşlıyor. Ağır uygulamaları kapatmak işe yarar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac сповільнюється, щоб охолонути. Закрийте важкі програми, це допоможе"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac đang chậm lại để hạ nhiệt. Đóng các ứng dụng nặng sẽ giúp ích"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 正在降速以便降温。关闭占用资源多的 App 会有帮助"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 正在降速以便降溫。關閉耗用資源多的 App 會有幫助"
          }
        }
      }
    },
    "Your Mac keeps working. To bring the display back, move the mouse or press a key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل جهاز Mac العمل. لإعادة الشاشة، حرّك الماوس أو اضغط على أي مفتاح."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac dál pracuje. Displej vrátíte pohybem myši nebo stiskem klávesy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac arbeitet weiter. Bewege die Maus oder drücke eine Taste, um das Display zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac keeps working. To bring the display back, move the mouse or press a key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac sigue funcionando. Para volver a ver la pantalla, mueve el ratón o pulsa una tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac continue de fonctionner. Pour rallumer l’écran, bougez la souris ou appuyez sur une touche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac काम करता रहेगा। डिस्प्ले वापस लाने के लिए माउस हिलाएँ या कोई कुंजी दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda tetap bekerja. Untuk menyalakan layar lagi, gerakkan mouse atau tekan tombol apa saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac continua a funzionare. Per riaccendere lo schermo, muovi il mouse o premi un tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は動き続けます。ディスプレイを戻すには、マウスを動かすかキーを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 계속 작동합니다. 디스플레이를 다시 켜려면 마우스를 움직이거나 아무 키나 누르십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac blijft werken. Beweeg de muis of druk op een toets om het scherm terug te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac dalej pracuje. Aby przywrócić ekran, rusz myszą lub naciśnij dowolny klawisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac continua funcionando. Para trazer a tela de volta, mova o mouse ou pressione uma tecla."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul continuă să lucreze. Ca să aprindeți ecranul la loc, mișcați mouse-ul sau apăsați o tastă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac продолжит работать. Чтобы вернуть экран, подвигайте мышью или нажмите любую клавишу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac fortsätter arbeta. Flytta musen eller tryck på en tangent för att få tillbaka skärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ยังทำงานต่อ หากต้องการให้หน้าจอกลับมา ให้ขยับเมาส์หรือกดแป้นใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz çalışmaya devam eder. Ekranı geri getirmek için fareyi oynatın ya da bir tuşa basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac працюватиме далі. Щоб повернути екран, поворушіть мишею або натисніть будь-яку клавішу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac vẫn làm việc. Để màn hình sáng lại, hãy di chuột hoặc nhấn một phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 会继续工作。移动鼠标或按任意键即可唤醒显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 會繼續運作。移動滑鼠或按任意鍵即可喚醒顯示器。"
          }
        }
      }
    },
    "Your Mac learns your routine and waits at %@ until you need it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعلّم جهاز Mac روتينك وينتظر عند %@ حتى تحتاج إليه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac se učí váš denní režim a zastaví nabíjení na %@, dokud ho nebudete potřebovat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac lernt deinen Alltag und wartet bei %@, bis du ihn brauchst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac learns your routine and waits at %@ until you need it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac aprende tu rutina y se queda en el %@ hasta que lo necesites"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac apprend vos habitudes et s’arrête à %@ jusqu’à ce que vous en ayez besoin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac आपकी दिनचर्या सीखता है और ज़रूरत पड़ने तक %@ पर रुका रहता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda mempelajari rutinitas Anda dan bertahan di %@ sampai Anda membutuhkannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac impara le tue abitudini e resta a %@ finché non ti serve"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが生活パターンを学習し、必要になるまで%@で待機します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 생활 패턴을 학습하고, 필요할 때까지 %@에서 기다립니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac leert je routine en wacht bij %@ tot je hem nodig hebt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac uczy się twojego rytmu dnia i zatrzymuje się na %@, dopóki nie będzie ci potrzebny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac aprende a sua rotina e fica em %@ até você precisar dele"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul dumneavoastră vă învață rutina și rămâne la %@ până aveți nevoie de el"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac изучает ваш распорядок и останавливает зарядку на %@, пока не понадобится"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac lär sig din rutin och stannar på %@ tills du behöver den"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac จะเรียนรู้กิจวัตรของคุณ และรอที่ %@ จนกว่าคุณจะต้องใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz günlük düzeninizi öğrenir ve ihtiyaç duyana kadar %@ seviyesinde bekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac вивчає ваш розпорядок і зупиняється на %@, доки він вам не знадобиться"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac học thói quen của bạn và chờ ở mức %@ cho đến khi bạn cần dùng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 会学习你的日常习惯，在你需要它之前一直停在 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 會學習你的日常習慣，在你需要它之前一直停在 %@"
          }
        }
      }
    },
