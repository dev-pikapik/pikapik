        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱을 휴지통으로 옮겼지만 앱의 파일은 아직 Mac에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze app naar de Prullenmand verplaatst, maar de bestanden staan nog op je Mac."
          }
        },
