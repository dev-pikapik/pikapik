    "Press Check Speed to find out": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «فحص السرعة» لتعرف"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjistíte to tlačítkem „Změřit rychlost“"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Geschwindigkeit prüfen“, um es herauszufinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Check Speed to find out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa «Comprobar velocidad» para averiguarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Tester le débit » pour le savoir"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानने के लिए “स्पीड जाँचें” दबाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
