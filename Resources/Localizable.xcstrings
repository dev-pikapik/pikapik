          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till den här mappen om du vill spela nästa fil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเล่นไฟล์ถัดไป โปรดอนุญาตการเข้าถึงโฟลเดอร์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki dosyayı oynatmak için bu klasöre erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб відтворити наступний файл, дозвольте доступ до цієї папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để phát tệp tiếp theo, hãy cho phép truy cập thư mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要播放下一个文件，请允许访问此文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要播放下一個檔案，請允許存取此資料夾。"
          }
        }
      }
    },
    "To see the tasks in your home folder, allow access to it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاطلاع على المهام في مجلد المنزل، اسمح بالوصول إليه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li vidět úlohy ve své domovské složce, povolte k ní přístup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf deinen Home-Ordner, um die Aufgaben darin zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see the tasks in your home folder, allow access to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver las tareas de tu carpeta de inicio, permite el acceso a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à votre dossier personnel pour voir les tâches qu’il contient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने होम फ़ोल्डर के टास्क देखने के लिए उसकी एक्सेस की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat tugas di folder utama Anda, izinkan akses ke folder tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere le attività nella tua cartella Home, consenti l’accesso alla cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダ内のタスクを表示するには、ホームフォルダへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 폴더의 작업을 보려면 홈 폴더에 대한 접근을 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot je thuismap om de taken erin te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zobaczyć zadania w folderze domowym, zezwól na dostęp do niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver as tarefas da sua pasta pessoal, permita o acesso a ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să vedeți sarcinile din folderul dumneavoastră principal, permiteți accesul la el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы увидеть задачи в домашней папке, разрешите доступ к ней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge åtkomst till din hemmapp för att se uppgifterna i den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการดูงานในโฟลเดอร์โฮมของคุณ ให้อนุญาตการเข้าถึงโฟลเดอร์นั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana klasörünüzdeki görevleri görmek için ona erişim izni verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб побачити завдання в домашній папці, дозвольте доступ до неї."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xem các tác vụ trong thư mục chính của bạn, hãy cho phép truy cập thư mục đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要查看个人文件夹中的任务，请允许访问个人文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要查看個人檔案夾中的工作，請允許取用個人檔案夾。"
          }
        }
      }
    },
    "To show the next picture, allow access to this folder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
