    "Moves keyboard focus between menus, controls and windows.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقل تركيز لوحة المفاتيح بين القوائم وعناصر التحكم والنوافذ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesouvá zaměření klávesnice mezi nabídkami, ovládacími prvky a okny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt den Tastaturfokus zwischen Menüs, Bedienelementen und Fenstern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves keyboard focus between menus, controls and windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el foco del teclado entre menús, controles y ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace le focus du clavier entre menus, commandes et fenêtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेनू, नियंत्रणों और विंडो के बीच कीबोर्ड फ़ोकस बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindahkan fokus papan ketik antara menu, kontrol, dan jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il focus della tastiera tra menu, controlli e finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー、コントロール、ウインドウの間でキーボードフォーカスを移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴, 제어기, 윈도우 사이에서 키보드 포커스를 옮깁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatst de toetsenbordfocus tussen menu’s, bediening en vensters."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenosi fokus klawiatury między menu, elementami sterowania i oknami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o foco do teclado entre menus, controles e janelas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mută focalizarea tastaturii între meniuri, comenzi și ferestre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит фокус клавиатуры между меню, элементами и окнами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttar tangentbordsfokus mellan menyer, reglage och fönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายโฟกัสแป้นพิมพ์ระหว่างเมนู ตัวควบคุม และหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye odağını menüler, denetimler ve pencereler arasında taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводить фокус клавіатури між меню, елементами й вікнами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển tiêu điểm bàn phím giữa menu, điều khiển và cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单、控件与窗口之间移动键盘焦点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單、控制項與視窗之間移動鍵盤焦點。"
          }
        }
      }
    },
    "Moves or resizes the active window.": {
