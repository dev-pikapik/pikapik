    "It stays because no password was entered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى العنصر في مكانه لأنه لم تُدخَل كلمة سر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka zůstává na místě, protože nebylo zadáno heslo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt bleibt, weil kein Passwort eingegeben wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays because no password was entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento se queda donde está porque no se introdujo ninguna contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément reste en place, car aucun mot de passe n’a été saisi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड दर्ज नहीं किया गया, इसलिए यह आइटम अपनी जगह पर ही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini tetap di tempatnya karena kata sandi tidak dimasukkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elemento resta dov’è perché non è stata inserita nessuna password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが入力されなかったため、そのまま残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호가 입력되지 않아 항목이 그대로 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het onderdeel blijft staan, omdat er geen wachtwoord is ingevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element zostaje na miejscu, bo nie podano hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item continua onde está porque nenhuma senha foi digitada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementul rămâne pe loc, pentru că nu a fost introdusă nicio parolă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент остался на месте, потому что не был введён пароль."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektet ligger kvar eftersom inget lösenord angavs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้ยังอยู่ที่เดิม เพราะไม่ได้ป้อนรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola girilmediği için öğe yerinde kaldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент залишився на місці, бо не було введено пароль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này vẫn ở nguyên chỗ vì chưa nhập mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于没有输入密码，该项目保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於沒有輸入密碼，此項目保持原樣。"
          }
        }
      }
    },
