        }
      }
    },
    "The port is free once the app closes. If it has unsaved work, it will ask you what to do.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيصبح المنفذ متاحًا بعد إغلاق التطبيق. إذا كان لديه عمل غير محفوظ، فسيسألك عمّا تريد فعله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Port se uvolní, jakmile se aplikace zavře. Pokud má neuložené změny, zeptá se, co s nimi dělat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Port wird frei, sobald die App geschlossen ist. Falls noch etwas nicht gesichert ist, fragt sie dich, was passieren soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port is free once the app closes. If it has unsaved work, it will ask you what to do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto quedará libre cuando la app se cierre. Si tiene trabajo sin guardar, te preguntará qué hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port sera libre une fois l’app fermée. Si elle contient du travail non enregistré, elle vous demandera quoi faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंद होते ही पोर्ट खाली हो जाएगा। अगर उसमें बिना सहेजा काम है, तो वह आपसे पूछेगा कि क्या करना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Port akan bebas setelah app tertutup. Jika ada pekerjaan yang belum disimpan, app akan menanyakan apa yang ingin Anda lakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta si libera quando l’app si chiude. Se ha lavoro non salvato, ti chiederà cosa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが閉じるとポートが空きます。保存していない作業がある場合は、どうするかアプリが確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 닫히면 포트가 비워집니다. 저장하지 않은 작업이 있으면 어떻게 할지 앱이 물어봅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De poort is vrij zodra de app is gesloten. Als er nog niet-bewaard werk is, vraagt de app wat je wilt doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Port zwolni się, gdy aplikacja się zamknie. Jeśli ma niezapisaną pracę, zapyta, co zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta fica livre quando o app fechar. Se houver trabalho não salvo, ele vai perguntar o que fazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portul se eliberează după ce aplicația se închide. Dacă are lucru nesalvat, vă va întreba ce să faceți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт освободится, когда программа закроется. Если в ней есть несохранённая работа, она спросит, что делать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten blir ledig när appen stängs. Om den har osparat arbete frågar den vad du vill göra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พอร์ตจะว่างเมื่อแอปปิด หากมีงานที่ยังไม่ได้บันทึก แอปจะถามว่าจะให้ทำอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kapandığında port serbest kalır. Kaydedilmemiş işi varsa ne yapılacağını size soracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт звільниться, коли програма закриється. Якщо в ній є незбережена робота, вона запитає, що робити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cổng sẽ trống khi ứng dụng đóng. Nếu còn công việc chưa lưu, ứng dụng sẽ hỏi bạn muốn làm gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 关闭后端口就会释放。如果有未存储的内容，它会询问你该怎么做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 關閉後連接埠就會釋放。如果有未儲存的內容，它會詢問你該怎麼做。"
          }
        }
      }
    },
    "The power adapter can’t keep up, so the battery is helping": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع محوّل الطاقة مجاراة الاستهلاك، لذا تساعده البطارية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptér nestíhá, proto mu baterie pomáhá"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzteil kommt nicht mit, deshalb hilft die Batterie aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The power adapter can’t keep up, so the battery is helping"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El adaptador de corriente no da abasto, así que la batería echa una mano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adaptateur secteur n’arrive pas à suivre, alors la batterie l’aide"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पावर अडैप्टर काफ़ी नहीं पड़ रहा, इसलिए बैटरी मदद कर रही है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptor daya tidak cukup kuat, jadi baterai ikut membantu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alimentatore non basta, quindi la batteria dà una mano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アダプタの出力が足りないため、バッテリーが補っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 어댑터의 출력이 부족해서 배터리가 도와주고 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lichtnetadapter kan het niet bijbenen, dus de batterij helpt mee"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasilacz nie nadąża, więc bateria mu pomaga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O adaptador de energia não dá conta, então a bateria está ajudando"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptorul nu face față, așa că bateria ajută"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптер не справляется, поэтому ему помогает аккумулятор"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömadaptern hänger inte med, så batteriet hjälper till"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อะแดปเตอร์แปลงไฟจ่ายไฟไม่พอ แบตเตอรี่จึงช่วยจ่ายไฟอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç adaptörü yetmiyor, bu yüzden pil de destek veriyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптер не справляється, тож акумулятор допомагає"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ tiếp hợp nguồn không đủ công suất nên pin đang hỗ trợ thêm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电源适配器供电跟不上，所以电池在帮忙"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電源轉接器供電跟不上，所以電池在幫忙"
          }
        }
      }
    },
    "The program didn’t close. Force quitting ends it right away, and anything unsaved is lost.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُغلق البرنامج. فرض الإنهاء يوقفه فورًا، وأي شيء غير محفوظ سيضيع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Program se nezavřel. Vynucené ukončení ho zastaví okamžitě a vše neuložené se ztratí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Programm hat sich nicht geschlossen. „Sofort beenden“ stoppt es auf der Stelle, und alles Ungesicherte geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program didn’t close. Force quitting ends it right away, and anything unsaved is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa no se cerró. Forzar la salida lo detiene al instante y se pierde lo que no esté guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme ne s’est pas fermé. Forcer à quitter l’arrête aussitôt, et tout ce qui n’est pas enregistré est perdu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोग्राम बंद नहीं हुआ। बलपूर्वक बंद करने से वह तुरंत रुक जाता है, और बिना सहेजा सब कुछ खो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program tidak menutup. Paksa keluar menghentikannya seketika, dan semua yang belum disimpan akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma non si è chiuso. Forzare l’uscita lo ferma subito e ciò che non è salvato va perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムが閉じませんでした。強制終了すると今すぐ停止し、保存していない内容は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램이 닫히지 않았습니다. 강제 종료하면 즉시 멈추고 저장하지 않은 내용은 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het programma is niet gesloten. Geforceerd stoppen beëindigt het programma meteen en alles wat niet is bewaard, gaat verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program się nie zamknął. Wymuszenie zakończenia zatrzyma go od razu, a niezapisane dane przepadną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa não fechou. Forçar o encerramento o interrompe na hora e o que não foi salvo se perde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul nu s-a închis. Închiderea forțată îl oprește imediat, iar ce nu e salvat se pierde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа не закрылась. Принудительное завершение останавливает её сразу, а всё несохранённое будет потеряно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmet stängdes inte. Tvångsavslut stoppar det direkt, och allt osparat går förlorat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมไม่ได้ปิด การบังคับออกจะหยุดโปรแกรมทันที และสิ่งที่ยังไม่ได้บันทึกจะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program kapanmadı. Çıkmaya zorlamak onu hemen durdurur ve kaydedilmemiş her şey kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма не закрилася. Примусове завершення зупиняє її одразу, а все незбережене буде втрачено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chương trình chưa đóng. Buộc thoát sẽ dừng ngay, và mọi thứ chưa lưu sẽ mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此程序没有关闭。强制退出会立即停止它，未存储的内容将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此程式沒有關閉。強制結束會立即停止它，未儲存的內容將會遺失。"
          }
        }
      }
    },
    "The program gets a moment to finish its work, then the port is free.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحصل البرنامج على لحظة لإنهاء عمله، ثم يصبح المنفذ متاحًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Program dostane chvilku na dokončení práce a pak bude port volný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Programm hat kurz Zeit, seine Arbeit zu beenden, danach ist der Port frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program gets a moment to finish its work, then the port is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa tiene un momento para terminar lo que está haciendo y luego el puerto queda libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme a un instant pour terminer son travail, puis le port se libère."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोग्राम को अपना काम पूरा करने के लिए थोड़ा समय मिलता है, फिर पोर्ट खाली हो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program diberi waktu sebentar untuk menyelesaikan pekerjaannya, lalu port akan bebas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma ha un momento per finire il suo lavoro, poi la porta si libera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムが作業を終えるのを少し待ってから、ポートが空きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램이 하던 작업을 잠시 마무리한 다음 포트가 비워집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het programma krijgt even de tijd om zijn werk af te maken, daarna is de poort vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program dostanie chwilę na dokończenie pracy, a potem port będzie wolny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa tem um momento para terminar o que está fazendo, e depois a porta fica livre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul are un moment să-și termine treaba, apoi portul e liber."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа успеет закончить работу, и порт освободится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmet får en stund på sig att avsluta sitt arbete, sedan är porten ledig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมจะมีเวลาสักครู่เพื่อทำงานให้เสร็จ แล้วพอร์ตจะว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa işini bitirmesi için kısa bir süre tanınır, ardından port serbest kalır."
