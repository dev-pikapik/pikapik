    "Lets you hold Control and click without opening a context menu.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح الضغط على Control والنقر دون فتح قائمة سياقية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje držet Control a klikat bez kontextové nabídky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Control-Klicks ohne Kontextmenü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you hold Control and click without opening a context menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite mantener Control y hacer clic sin abrir un menú contextual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de maintenir Control et de cliquer sans menu contextuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Control दबाए रखकर संदर्भ मेनू खोले बिना क्लिक करने देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan menahan Control dan mengeklik tanpa menu konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette di tenere Control e fare clic senza un menu contestuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlを押しながらクリックしてもコンテキストメニューを開きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Control을 누른 채 클릭해도 컨텍스트 메뉴가 열리지 않게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je Control ingedrukt houden en klikken zonder contextmenu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala trzymać Control i klikać bez menu kontekstowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite segurar Control e clicar sem abrir um menu contextual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă permite să țineți Control și să faceți clic fără meniul contextual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет держать Control и нажимать мышь без контекстного меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter dig hålla Control och klicka utan en kontextmeny."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้กด Control ค้างและคลิกโดยไม่เปิดเมนูบริบท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Control basılıyken bağlam menüsü açmadan tıklamanızı sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє тримати Control і клацати без контекстного меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép giữ Control và bấm mà không mở menu ngữ cảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许按住 Control 并点击，而不打开快捷菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許按住 Control 並點按，而不開啟快捷選單。"
          }
        }
      }
    },
