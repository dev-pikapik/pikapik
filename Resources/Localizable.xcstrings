        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan jika monitor tidak merespons penggeser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva se il monitor non risponde al cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モニタがスライダに反応しない場合はオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터가 슬라이더에 반응하지 않으면 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit aan als de monitor niet op de schuifknop reageert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz, jeśli monitor nie reaguje na suwak."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
