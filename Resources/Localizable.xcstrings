    "This works when you have two or more keyboard layouts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل عندما يكون لديك تخطيطان للوحة المفاتيح أو أكثر"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funguje, když máte dvě nebo více rozložení klávesnice"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert, wenn du zwei oder mehr Tastaturlayouts hast"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This works when you have two or more keyboard layouts"
          }
        },
        "es": {
