    "The wheel switches slots while you hold ⇧": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العجلة تبدّل الخانات أثناء الضغط على ⇧"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolečko přepíná sloty i při držení ⇧"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rad wechselt Slots bei gehaltenem ⇧"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wheel switches slots while you hold ⇧"
          }
