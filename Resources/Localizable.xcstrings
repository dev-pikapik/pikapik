        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को नई फ़ाइलें आपकी फ़ाइलों के बगल में सहेजने और बैकग्राउंड टास्क देखने देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
