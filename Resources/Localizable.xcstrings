          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac est un peu chaud, mais fonctionne toujours à pleine vitesse"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac थोड़ा गर्म है, लेकिन अभी भी पूरी रफ़्तार से चल रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda agak hangat, tetapi masih berjalan dengan kecepatan penuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac è un po’ caldo, ma funziona ancora alla massima velocità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は少し熱くなっていますが、フルスピードで動作しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 약간 따뜻하지만 여전히 최대 속도로 작동 중입니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac is een beetje warm, maar werkt nog op volle snelheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac jest trochę ciepły, ale nadal działa z pełną prędkością"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac está um pouco quente, mas continua na velocidade máxima"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul este puțin cald, dar funcționează în continuare la viteză maximă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac немного нагрелся, но работает на полной скорости"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac är lite varm men går fortfarande för full fart"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ของคุณอุ่นขึ้นเล็กน้อย แต่ยังทำงานเต็มความเร็ว"
          }
