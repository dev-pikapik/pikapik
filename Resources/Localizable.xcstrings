    "Here’s what’s in your Dock and open now. Click an app to add it, or drag one here from Finder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا ما في Dock وما هو مفتوح الآن. انقر على تطبيق لإضافته، أو اسحبه إلى هنا من Finder"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady je, co máte v Docku a co je právě otevřené. Klikněte na aplikaci, abyste ji přidali, nebo ji sem přetáhněte z Finderu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist, was in deinem Dock ist und gerade läuft. Klick auf eine App, um sie hinzuzufügen, oder zieh sie aus dem Finder hierher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here’s what’s in your Dock and open now. Click an app to add it, or drag one here from Finder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí está lo que hay en tu Dock y lo que tienes abierto. Haz clic en una app para añadirla o arrástrala aquí desde el Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici ce qui se trouve dans votre Dock et ce qui est ouvert. Cliquez sur une app pour l’ajouter, ou faites-la glisser ici depuis le Finder"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ वह है जो आपके Dock में है और अभी खुला है। जोड़ने के लिए किसी ऐप पर क्लिक करें, या उसे Finder से यहाँ खींच लाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini yang ada di Dock Anda dan yang sedang terbuka. Klik app untuk menambahkannya, atau seret ke sini dari Finder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco cosa c’è nel tuo Dock e cosa è aperto ora. Fai clic su un’app per aggiungerla, oppure trascinala qui dal Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockにあるものと、いま開いているものがここに並んでいます。アプリをクリックして追加するか、Finderからここにドラッグしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock에 있는 앱과 지금 열려 있는 앱입니다. 앱을 클릭해 추가하거나 Finder에서 여기로 끌어 오십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staat wat in je Dock zit en wat nu open is. Klik op een app om hem toe te voegen, of sleep hem hierheen vanuit de Finder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jest to, co masz w Docku i co jest teraz otwarte. Kliknij aplikację, aby ją dodać, albo przeciągnij ją tutaj z Findera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui está o que há no seu Dock e o que está aberto agora. Clique em um app para adicioná-lo ou arraste-o do Finder para cá"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici e ce aveți în Dock și ce e deschis acum. Faceți clic pe o aplicație ca s-o adăugați sau trageți-o aici din Finder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь то, что есть в Dock и открыто сейчас. Нажмите на приложение, чтобы добавить его, или перетащите его сюда из Finder"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här är det som finns i ditt Dock och det som är öppet nu. Klicka på en app för att lägga till den, eller dra hit den från Finder"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือสิ่งที่อยู่ใน Dock และที่เปิดอยู่ตอนนี้ คลิกแอปเพื่อเพิ่ม หรือลากแอปมาที่นี่จาก Finder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock’unuzdakiler ve şu an açık olanlar burada. Eklemek için bir uygulamaya tıklayın ya da Finder’dan buraya sürükleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут те, що є в Dock і відкрите зараз. Натисніть на застосунок, щоб додати його, або перетягніть його сюди з Finder"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là những gì trong Dock và đang mở. Bấm vào một ứng dụng để thêm, hoặc kéo ứng dụng từ Finder vào đây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是程序坞里和正在打开的 App。点按一个 App 来添加，或从访达把它拖到这里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡是 Dock 裡和正在打開的 App。按一下 App 來加入，或從 Finder 把它拖到這裡"
          }
        }
      }
    },
    "Here’s what’s in your Dock. Click your game to add it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا كل ما في Dock. انقر على لعبتك لإضافتها"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tady je všechno, co máte v Docku. Klikněte na hru, abyste ji přidali"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist alles aus deinem Dock. Klick auf dein Spiel, um es hinzuzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here’s what’s in your Dock. Click your game to add it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí está todo lo que hay en tu Dock. Haz clic en tu juego para añadirlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici tout ce qui se trouve dans votre Dock. Cliquez sur votre jeu pour l’ajouter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ वह सब है जो आपके Dock में है। जोड़ने के लिए अपने गेम पर क्लिक करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini semua yang ada di Dock Anda. Klik game Anda untuk menambahkannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco tutto quello che c’è nel tuo Dock. Fai clic sul tuo gioco per aggiungerlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockにあるものがここに並んでいます。ゲームをクリックして追加してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock에 있는 앱이 모두 여기 있습니다. 게임을 클릭해 추가하십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staat alles uit je Dock. Klik op je game om hem toe te voegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jest wszystko, co masz w Docku. Kliknij grę, aby ją dodać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui está tudo o que há no seu Dock. Clique no seu jogo para adicioná-lo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici e tot ce aveți în Dock. Faceți clic pe joc ca să-l adăugați"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь всё, что есть в Dock. Нажмите на игру, чтобы добавить её"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här är allt som finns i ditt Dock. Klicka på ditt spel för att lägga till det"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือทุกอย่างใน Dock ของคุณ คลิกเกมของคุณเพื่อเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock’unuzdaki her şey burada. Eklemek için oyununuza tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут усе, що є в Dock. Натисніть на гру, щоб додати її"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mọi thứ trong Dock của bạn. Bấm vào trò chơi để thêm"
