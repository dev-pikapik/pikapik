    "Your pet climbs onto a window 10 times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتسلق رفيقك نافذة 10 مرات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš mazlíček vyšplhá na okno 10krát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Haustier klettert 10-mal auf ein Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pet climbs onto a window 10 times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mascota trepa a una ventana 10 veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compagnon grimpe sur une fenêtre 10 fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नन्हा दोस्त 10 बार विंडो पर चढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peliharaan Anda memanjat jendela 10 kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo animaletto si arrampica su una finestra 10 volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットがウインドウに10回よじ登ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫이 윈도우에 10번 올라갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huisdiertje klimt 10 keer op een venster."
          }
        },
