            "value": "În Configurări sistem, apăsați pe „%@”, apoi pe „%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Системных настройках нажмите «%@», а затем «%@»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
