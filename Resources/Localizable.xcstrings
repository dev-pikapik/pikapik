    "Pick the pet up and set it down gently 25 times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع رفيقك ثم أنزله برفق 25 مرة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedněte mazlíčka a jemně ho položte 25krát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb dein Haustier hoch und setz es 25-mal behutsam ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the pet up and set it down gently 25 times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta a tu mascota y déjala con suavidad 25 veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulevez votre compagnon puis reposez-le doucement 25 fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने नन्हे दोस्त को उठाएँ और 25 बार धीरे से नीचे रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat peliharaan Anda lalu letakkan dengan lembut 25 kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva il tuo animaletto e appoggialo con delicatezza 25 volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットを持ち上げ、そっと下ろすことを25回行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펫을 들어 올렸다가 살며시 내려놓기를 25번 해 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Til je huisdiertje op en zet het 25 keer voorzichtig neer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnieś zwierzaka i delikatnie go odstaw 25 razy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante seu bichinho e coloque-o no chão com delicadeza 25 vezes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridicați animăluțul și lăsați-l jos cu grijă de 25 de ori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимите питомца и бережно опустите его 25 раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft upp ditt husdjur och sätt ner det försiktigt 25 gånger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุ้มเพื่อนตัวน้อยขึ้นแล้ววางลงเบาๆ 25 ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evcil dostunuzu kaldırın ve 25 kez nazikçe yere bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підніміть улюбленця й обережно опустіть його 25 разів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấc thú cưng lên rồi đặt xuống nhẹ nhàng 25 lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抱起宠物再轻轻放下，共 25 次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抱起寵物再輕輕放下，共 25 次。"
          }
        }
      }
    },
