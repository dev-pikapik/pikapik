    "While Keep Awake is on, your Mac stays awake with the lid closed. Don’t put it in a bag.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما دام «منع السكون» قيد التشغيل، يبقى Mac مستيقظًا والغطاء مغلق. لا تضعه في حقيبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnuté „Bez spánku“, Mac zůstane vzhůru i se zavřeným víkem. Nedávejte ho do tašky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange „Wach bleiben“ an ist, bleibt der Mac auch bei geschlossenem Deckel wach. Steck ihn nicht in eine Tasche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Keep Awake is on, your Mac stays awake with the lid closed. Don’t put it in a bag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras «Mantener activo» esté activado, el Mac no se duerme con la tapa cerrada. No lo guardes en una mochila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que « Rester éveillé » est activé, le Mac reste éveillé capot fermé. Ne le mettez pas dans un sac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक “जगाए रखें” चालू है, ढक्कन बंद होने पर भी Mac जगा रहता है। इसे बैग में न रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama “Tetap Terjaga” menyala, Mac tetap menyala saat penutup ditutup. Jangan masukkan ke dalam tas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché “Resta sveglio” è attivo, il Mac resta attivo a coperchio chiuso. Non metterlo in una borsa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スリープさせない」がオンのあいだは、蓋を閉じても Mac はスリープしません。バッグに入れないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘잠자기 방지’가 켜져 있는 동안에는 덮개를 닫아도 Mac이 잠자지 않습니다. 가방에 넣지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang “Wakker houden” aan staat, blijft de Mac wakker met gesloten klep. Stop hem niet in een tas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy „Bez usypiania” jest włączone, Mac nie uśnie przy zamkniętej klapie. Nie wkładaj go do torby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto “Manter ativo” estiver ativado, o Mac fica ativo com a tampa fechada. Não o coloque em uma mochila."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp „Menține activ” este pornit, Mac-ul rămâne activ cu capacul închis. Nu îl puneți în geantă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока «Не засыпать» включено, Mac не уснёт с закрытой крышкой. Не кладите его в сумку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan ”Håll vaken” är på förblir datorn vaken med stängt lock. Lägg den inte i en väska."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่ “ไม่ให้หลับ” เปิดอยู่ Mac จะไม่หลับแม้ปิดฝา อย่าใส่เครื่องไว้ในกระเป๋า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uyanık Tut” açıkken Mac, kapak kapalıyken de uyanık kalır. Çantaya koymayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки «Не засинати» ввімкнено, Mac не засне із закритою кришкою. Не кладіть його в сумку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi “Giữ máy thức” đang bật, Mac vẫn thức khi gập màn hình. Đừng để máy trong túi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“保持唤醒”开启时，合上盖子 Mac 也不会睡眠。请勿将它放进包里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「保持喚醒」開啟時，闔上螢幕 Mac 也不會進入睡眠。請勿將它放進包包裡。"
          }
        }
      }
    },
