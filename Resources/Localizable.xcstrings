    "This copy changes nothing on your Mac and takes over when the other copy quits.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغيّر هذه النسخة أي شيء في جهاز Mac، وتتولى الأمر عند إغلاق النسخة الأخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato kopie na Macu nic nemění a převezme řízení, až se druhá kopie zavře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie ändert nichts an deinem Mac und übernimmt, sobald die andere Kopie beendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy changes nothing on your Mac and takes over when the other copy quits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia no cambia nada en tu Mac y toma el relevo cuando la otra copia se cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie ne modifie rien sur votre Mac et reprend la main quand l’autre copie se ferme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कॉपी आपके Mac पर कुछ नहीं बदलती और दूसरी कॉपी बंद होने पर कमान संभाल लेती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan ini tidak mengubah apa pun di Mac dan mengambil alih saat salinan lainnya ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia non modifica nulla sul tuo Mac e subentra quando l’altra copia viene chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーはMacを変更しません。もう一方のコピーが終了すると、このコピーが引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사본은 Mac에서 아무것도 변경하지 않으며, 다른 사본이 종료되면 이어받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kopie verandert niets op je Mac en neemt het over zodra de andere kopie stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia niczego nie zmienia w Macu i przejmie kontrolę, gdy druga kopia zostanie zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia não altera nada no Mac e assume quando a outra cópia for fechada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această copie nu schimbă nimic pe Mac și preia controlul când cealaltă copie se închide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия ничего не меняет на вашем Mac и берёт управление на себя, когда другая копия закроется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här kopian ändrar ingenting på din Mac och tar över när den andra kopian avslutas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนานี้ไม่เปลี่ยนแปลงอะไรบน Mac และจะรับช่วงต่อเมื่อสำเนาอีกชุดปิดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopya Mac’te hiçbir şeyi değiştirmez; diğer kopya kapandığında yönetimi devralır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця копія нічого не змінює на вашому Mac і перебирає керування, коли інша копія закриється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao này không thay đổi gì trên Mac và sẽ tiếp quản khi bản sao kia đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本不会更改你的 Mac 设置，另一个副本退出后会自动接手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本不會變更你的 Mac 設定，另一個副本結束後會自動接手。"
          }
        }
      }
    },
