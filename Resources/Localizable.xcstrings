            "value": "ढक्कन बंद होने पर आपका Mac अब भी स्लीप में नहीं जाता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda masih tidak tidur saat penutup ditutup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac non va ancora in stop con il coperchio chiuso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じてもまだスリープしません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫아도 아직 잠자기에 들어가지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac gaat nog steeds niet in sluimerstand met het deksel dicht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nadal nie usypia się przy zamkniętej pokrywie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac ainda não entra em repouso com a tampa fechada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul tot nu intră în repaus cu capacul închis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac всё ещё не засыпает при закрытой крышке"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac går fortfarande inte i vila med locket stängt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ของคุณยังไม่พักเครื่องเมื่อปิดฝา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz kapak kapalıyken hâlâ uyku moduna geçmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac досі не засинає при закритій кришці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac vẫn không ngủ khi gập nắp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上盖子后 Mac 仍然不会睡眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋上螢幕後 Mac 仍然不會進入睡眠"
          }
        }
      }
    },
    "Your Mac will ask for your password once.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب جهاز Mac كلمة السر مرة واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac vás jednou požádá o heslo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac fragt einmal nach deinem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac will ask for your password once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac pedirá tu contraseña una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac demandera une seule fois votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Mac एक बार पासवर्ड माँगेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac akan meminta kata sandi Anda satu kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac chiederà la password una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがパスワードを1回だけ求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 암호를 한 번 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac vraagt één keer om je wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac zapyta o hasło tylko raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac vai pedir sua senha uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul vă va cere parola o singură dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac один раз запросит ваш пароль."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac frågar efter ditt lösenord en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac จะขอรหัสผ่านของคุณเพียงครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz parolanızı bir kez soracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac один раз запросить ваш пароль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac sẽ hỏi mật khẩu của bạn một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 会询问一次密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 會詢問一次密碼。"
          }
        }
      }
    },
    "Your awards, unlocked clothes and counters are erased from this Mac. This can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مسح جوائزك والملابس التي فتحتها والعدّادات من هذا الـ Mac. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše ocenění, odemčené oblečení a počítadla se z tohoto Macu smažou. Akci nelze vrátit zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auszeichnungen, freigeschalteten Kleidungsstücke und Zähler werden von diesem Mac gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your awards, unlocked clothes and counters are erased from this Mac. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus premios, la ropa desbloqueada y los contadores se borrarán de este Mac. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos récompenses, vos vêtements débloqués et vos compteurs seront effacés de ce Mac. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पुरस्कार, अनलॉक किए गए कपड़े और काउंटर इस Mac से मिटा दिए जाएँगे। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghargaan, pakaian yang terbuka, dan penghitung akan dihapus dari Mac ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi premi, i vestiti sbloccati e i contatori verranno cancellati da questo Mac. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アワード、解放した服、カウンターがこのMacから消去されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상, 잠금 해제한 옷, 카운터가 이 Mac에서 지워집니다. 이 동작은 되돌릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je onderscheidingen, ontgrendelde kleding en tellers worden van deze Mac gewist. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje nagrody, odblokowane ubrania i liczniki zostaną usunięte z tego Maca. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus prêmios, as roupas desbloqueadas e os contadores serão apagados deste Mac. Esta ação não pode ser desfeita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiile, hainele deblocate și contoarele vor fi șterse de pe acest Mac. Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши награды, открытая одежда и счётчики будут стёрты с этого Mac. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina utmärkelser, upplåsta kläder och räknare raderas från den här Mac-datorn. Det går inte att ångra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รางวัล เสื้อผ้าที่ปลดล็อกแล้ว และตัวนับของคุณจะถูกลบออกจาก Mac เครื่องนี้ การดำเนินการนี้ย้อนกลับไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödülleriniz, açılan kıyafetler ve sayaçlar bu Mac’ten silinir. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші нагороди, відкритий одяг і лічильники буде стерто з цього Mac. Цю дію неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thưởng, quần áo đã mở khóa và bộ đếm sẽ bị xóa khỏi máy Mac này. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的奖章、已解锁的服装和计数将从这台 Mac 上清除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的獎章、已解鎖的服裝和計數將從此 Mac 清除。此操作無法還原。"
          }
        }
      }
    },
    "Your game rules allow this action. It works as configured in macOS.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح قواعد اللعب بهذا الإجراء. يعمل حسب إعدادات macOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše herní pravidla tuto akci povolují. Funguje podle nastavení macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Spielregeln erlauben diese Aktion. Sie funktioniert wie in macOS eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your game rules allow this action. It works as configured in macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reglas de juego permiten esta acción. Funciona según los ajustes de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles de jeu autorisent cette action. Elle fonctionne selon les réglages macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके गेम के नियम इस क्रिया को अनुमति देते हैं। यह macOS की सेटिंग के अनुसार काम करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aturan game Anda mengizinkan tindakan ini. Tindakan berjalan sesuai pengaturan macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue regole di gioco consentono questa azione. Funziona secondo le impostazioni di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームのルールでこの操作が許可されています。macOSの設定どおりに動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 규칙에서 이 동작을 허용합니다. macOS 설정대로 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gameregels staan deze actie toe. Ze werkt zoals ingesteld in macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje reguły gry zezwalają na to działanie. Działa zgodnie z ustawieniami macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas regras de jogo permitem esta ação. Ela funciona conforme os ajustes do macOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulile dumneavoastră de joc permit această acțiune. Funcționează conform setărilor macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила игрового режима разрешают это действие. Оно работает как настроено в macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina spelregler tillåter åtgärden. Den fungerar enligt inställningarna i macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎเกมของคุณอนุญาตการทำงานนี้ จึงทำงานตามการตั้งค่า macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun kurallarınız bu eyleme izin verir. macOS ayarlarına göre çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила ігрового режиму дозволяють цю дію. Вона працює як налаштовано в macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc trò chơi của bạn cho phép hành động này. Hành động chạy theo cài đặt macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的游戏规则允许此操作。它会按 macOS 中的设置运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的遊戲規則允許此動作。它會依 macOS 中的設定執行。"
          }
        }
      }
    },
