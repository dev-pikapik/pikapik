    "You moved this app to the Trash, but its files are still on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقلتَ هذا التطبيق إلى سلة المهملات، لكن ملفاته ما زالت على جهاز Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto aplikaci jste přesunuli do Koše, ale její soubory jsou pořád ve vašem Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese App in den Papierkorb gelegt, aber ihre Dateien sind noch auf deinem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You moved this app to the Trash, but its files are still on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moviste esta app a la Papelera, pero sus archivos siguen en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez mis cette app à la Corbeille, mais ses fichiers sont toujours sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस ऐप को ट्रैश में डाला, लेकिन इसकी फ़ाइलें अब भी आपके Mac पर हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memindahkan app ini ke Tong Sampah, tetapi filenya masih ada di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai spostato questa app nel Cestino, ma i suoi file sono ancora sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
