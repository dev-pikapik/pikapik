          "stringUnit": {
            "state": "translated",
            "value": "Ventilatoarele au revenit la Auto pentru a vă proteja Mac-ul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентиляторы вернулись в режим «Авто», чтобы Mac не перегрелся"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fläktarna gick tillbaka till Auto för att skydda din Mac"
          }
        },
