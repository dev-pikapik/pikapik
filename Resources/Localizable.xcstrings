    "Mouse only: moves as far as your hand": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للماوس فقط: يتحرك بقدر حركة يدك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pro myši: urazí tolik, co ruka"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Mäuse: bewegt sich so weit wie deine Hand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse only: moves as far as your hand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para ratones: se mueve lo mismo que tu mano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souris uniquement : va aussi loin que votre main"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ माउस के लिए: हाथ जितनी ही दूरी तक चलता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk tetikus: bergerak sejauh tangan Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per mouse: si sposta quanto la tua mano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウス専用：手を動かした分だけ進みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 전용: 손이 움직인 만큼만 이동합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor muizen: gaat net zo ver als je hand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dla myszy: przesuwa się tyle, co ręka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para mouse: percorre o mesmo que sua mão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar pentru mausuri: se mișcă atât cât mâna dumneavoastră"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для мыши: двигается столько же, сколько рука"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara för möss: rör sig lika långt som handen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมาส์: เลื่อนไปเท่ากับที่มือเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca fareler için: eliniz kadar ilerler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для миші: рухається стільки ж, скільки рука"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dành cho chuột: di chuyển đúng bằng tay bạn"
