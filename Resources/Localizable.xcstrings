    "Fans went back to Auto to keep your Mac safe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت المراوح إلى الوضع التلقائي لحماية جهاز Mac"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
