    "pikapik passes each app’s sound through itself to change its volume. Nothing is recorded or saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرّر pikapik صوت كل تطبيق عبر نفسه لتغيير مستوى صوته. لا يتم تسجيل أي شيء ولا حفظه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik pouští zvuk každé aplikace přes sebe, aby mohl změnit její hlasitost. Nic se nenahrává ani neukládá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik leitet den Ton jeder App durch sich selbst, um die Lautstärke zu ändern. Es wird nichts aufgenommen oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik passes each app’s sound through itself to change its volume. Nothing is recorded or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik hace pasar el sonido de cada app por sí mismo para cambiar su volumen. No se graba ni se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik fait passer le son de chaque app par lui-même pour en changer le volume. Rien n’est enregistré ni conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik हर ऐप की ध्वनि को अपने से होकर गुज़ारता है, ताकि उसकी आवाज़ बदल सके। कुछ भी रिकॉर्ड या सेव नहीं किया जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik meneruskan suara tiap app melalui dirinya sendiri untuk mengubah volumenya. Tidak ada yang direkam atau disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik fa passare il suono di ogni app attraverso se stesso per cambiarne il volume. Non viene registrato né salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapikは、音量を変えるために各アプリの音をいったん通します。録音も保存もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik은 음량을 바꾸기 위해 각 앱의 소리를 자신을 거쳐 보냅니다. 아무것도 녹음되거나 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik leidt het geluid van elke app door zichzelf heen om het volume te wijzigen. Er wordt niets opgenomen of bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik przepuszcza dźwięk każdej aplikacji przez siebie, aby zmienić jego głośność. Nic nie jest nagrywane ani zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pikapik faz o som de cada app passar por ele para alterar o volume. Nada é gravado nem salvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik trece sunetul fiecărei aplicații prin el însuși pentru a-i schimba volumul. Nimic nu este înregistrat sau salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik пропускает звук каждого приложения через себя, чтобы изменить его громкость. Ничего не записывается и не сохраняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik leder varje apps ljud genom sig själv för att ändra volymen. Ingenting spelas in eller sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik ส่งเสียงของแต่ละแอปผ่านตัวเองเพื่อเปลี่ยนระดับเสียง ไม่มีการบันทึกหรือเก็บอะไรไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik, ses düzeyini değiştirmek için her uygulamanın sesini kendi içinden geçirir. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik пропускає звук кожної програми через себе, щоб змінити його гучність. Нічого не записується й не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik cho âm thanh của từng ứng dụng đi qua chính nó để đổi âm lượng. Không có gì được ghi lại hoặc lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 会让每个 App 的声音先经过自己，以便调整音量。不会录制或保存任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 會讓每個 App 的聲音先經過自己，以便調整音量。不會錄製或儲存任何內容。"
          }
        }
      }
    },
