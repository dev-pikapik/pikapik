          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm „%@“ ist nicht wieder angegangen. Zieh sein Kabel ab und steck es wieder ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “%@” screen didn’t come back. Unplug its cable and plug it in again."
          }
        },
        "es": {
