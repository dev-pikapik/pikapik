    "Move two fingers down to go down the page": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك إصبعين لأسفل للنزول في الصفحة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva prsty dolů: posun dolů po stránce"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Finger nach unten scrollen nach unten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move two fingers down to go down the page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos dedos hacia abajo: bajas por la página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux doigts vers le bas : tu descends dans la page"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो उँगलियाँ नीचे ले जाएँ तो पेज पर नीचे जाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan dua jari ke bawah untuk turun di halaman"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due dita verso il basso: scendi nella pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本指で下へ動かすとページの下へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락을 아래로 움직이면 페이지 아래로 이동합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee vingers omlaag: je gaat omlaag in de pagina"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa palce w dół: w dół strony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois dedos para baixo: você desce na página"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două degete în jos: coborâți în pagină"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два пальца вниз — прокрутка вниз"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två fingrar nedåt: du går nedåt på sidan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนสองนิ้วลงเพื่อเลื่อนลงไปในหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki parmak aşağı: sayfada aşağı inersiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два пальці вниз — прокручування вниз"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di hai ngón tay xuống để cuộn xuống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指向下移动时向页面下方移动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙指向下移動時往頁面下方移動"
          }
        }
      }
    },
