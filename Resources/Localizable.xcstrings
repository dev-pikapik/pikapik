    "Calm games like chess draw a new picture only when something moves, so 0 is normal for them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألعاب الهادئة مثل الشطرنج لا ترسم صورة جديدة إلا عندما يتحرك شيء ما، لذا فإن 0 أمر طبيعي فيها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidné hry jako šachy nakreslí nový obrázek, jen když se něco pohne, takže 0 je u nich normální."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhige Spiele wie Schach zeichnen nur dann ein neues Bild, wenn sich etwas bewegt, deshalb ist 0 bei ihnen normal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm games like chess draw a new picture only when something moves, so 0 is normal for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos tranquilos como el ajedrez solo dibujan una imagen nueva cuando algo se mueve, así que 0 es normal en ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux calmes comme les échecs ne dessinent une nouvelle image que lorsque quelque chose bouge, donc 0 est normal pour eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शतरंज जैसे शांत गेम नई तस्वीर तभी बनाते हैं जब कुछ हिलता है, इसलिए उनमें 0 होना सामान्य है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Game yang tenang seperti catur hanya menggambar gambar baru saat ada yang bergerak, jadi angka 0 itu normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giochi tranquilli come gli scacchi disegnano una nuova immagine solo quando qualcosa si muove, quindi per loro 0 è normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェスのような静かなゲームは、何かが動いたときだけ新しい絵を描くので、0 でも正常です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체스처럼 조용한 게임은 무언가 움직일 때만 새 그림을 그리므로 0이어도 정상입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustige games zoals schaken tekenen alleen een nieuw beeld als er iets beweegt, dus 0 is bij hen normaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojne gry, takie jak szachy, rysują nowy obraz tylko wtedy, gdy coś się porusza, więc 0 jest u nich normalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogos calmos como xadrez só desenham uma nova imagem quando algo se move, então 0 é normal para eles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jocurile liniștite, precum șahul, desenează o imagine nouă doar când se mișcă ceva, așa că 0 e normal pentru ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойные игры вроде шахмат рисуют новую картинку, только когда что-то движется, поэтому 0 для них — это нормально."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugna spel som schack ritar en ny bild bara när något rör sig, så 0 är normalt för dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกมที่นิ่ง ๆ อย่างหมากรุกจะวาดภาพใหม่เฉพาะตอนที่มีบางอย่างขยับ ตัวเลข 0 จึงเป็นเรื่องปกติสำหรับเกมแบบนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç gibi sakin oyunlar yalnızca bir şey hareket ettiğinde yeni bir resim çizer, bu yüzden onlarda 0 normaldir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійні ігри на кшталт шахів малюють нове зображення, лише коли щось рухається, тому 0 для них — це нормально."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trò chơi tĩnh như cờ vua chỉ vẽ hình mới khi có thứ gì đó chuyển động, nên 0 là bình thường với chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像国际象棋这样的安静游戏只在有东西移动时才绘制新画面，所以显示 0 是正常的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像西洋棋這樣的安靜遊戲只在有東西移動時才繪製新畫面，所以顯示 0 是正常的。"
          }
        }
      }
    },
