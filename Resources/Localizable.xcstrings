        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen dimmen, schermbeveiliging of toegangsscherm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez przygaszania, wygaszacza i ekranu blokady"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem escurecer, protetor de tela ou tela bloqueada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără estompare, protector de ecran sau ecran de blocare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без затемнения, заставки и экрана блокировки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dämpning, skärmsläckare eller låsskärm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่หรี่ ไม่มีภาพพักหน้าจอ และไม่ล็อกหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
