    "While you play, your Mac doesn’t pull you out of the game": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء اللعب، لا يُخرجك Mac من اللعبة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatímco hrajete, Mac vás nevytrhne ze hry"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während du spielst, holt dich dein Mac nicht aus dem Spiel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you play, your Mac doesn’t pull you out of the game"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras juegas, tu Mac no te saca del juego"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que vous jouez, votre Mac ne vous sort pas du jeu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप खेलते हैं, तो आपका Mac आपको गेम से बाहर नहीं खींचता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selagi Anda bermain, Mac tidak menarik Anda keluar dari game"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre giochi, il Mac non ti tira fuori dal gioco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ中は、Macがゲームの邪魔をしません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이하는 동안 Mac이 게임에서 끌어내지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwijl je speelt, haalt je Mac je niet uit je game"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy grasz, Mac nie wyrywa cię z gry"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto você joga, seu Mac não tira você do jogo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp jucați, Macul nu vă scoate din joc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы играете, Mac не выдёргивает вас из игры"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan du spelar drar din Mac dig inte ur spelet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะที่คุณเล่น Mac จะไม่ดึงคุณออกจากเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oynarken Mac’iniz sizi oyundan koparmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки ви граєте, Mac не висмикує вас із гри"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chơi, máy Mac không kéo bạn ra khỏi trò chơi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你玩游戏时，Mac 不会把你拉出游戏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你玩遊戲時，Mac 不會把你拉出遊戲"
          }
        }
      }
    },
