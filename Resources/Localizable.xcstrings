    "Lets the Mac sleep before the battery runs out": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لجهاز Mac بالسكون مجددًا قبل نفاد البطارية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní Macu znovu usnout dřív, než se baterie vybije"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac schläft wieder, bevor der Akku leer ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the Mac sleep before the battery runs out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac vuelve a dormir antes de que se agote la batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac se remet en veille avant que la batterie ne soit vide"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी ख़त्म होने से पहले Mac को फिर से स्लीप में जाने देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membiarkan Mac tidur lagi sebelum baterai habis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac torna in stop prima che la batteria si scarichi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが切れる前にスリープに戻します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 다 닳기 전에 다시 잠자기에 들어갑니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de Mac weer sluimeren voordat de batterij leeg is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala Macowi znów się uśpić, zanim bateria się wyczerpie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac volta a dormir antes de a bateria acabar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Mac-ului să intre din nou în repaus înainte să se descarce bateria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac снова уснёт, пока батарея не села"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter Macen gå i vila igen innan batteriet tar slut"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ Mac พักเครื่องอีกครั้งก่อนแบตเตอรี่หมด"
