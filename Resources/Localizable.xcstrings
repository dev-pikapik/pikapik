    "The “%@” screen didn’t come back. Unplug its cable and plug it in again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعمل الشاشة «%@» مجددًا. افصل كابلها ثم أعد توصيله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
