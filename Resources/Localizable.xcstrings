          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保护你的 Mac，风扇已恢复为自动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了保護你的 Mac，風扇已恢復為自動"
          }
        }
      }
    },
