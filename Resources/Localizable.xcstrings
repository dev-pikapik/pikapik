    "Dims the picture. This monitor doesn’t let the Mac change its brightness.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتّم الصورة. هذه الشاشة لا تسمح لجهاز Mac بتغيير سطوعها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ztmavuje obraz. Tento monitor nedovolí Macu měnit svůj jas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt das Bild ab. Dieser Monitor lässt den Mac seine Helligkeit nicht ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dims the picture. This monitor doesn’t let the Mac change its brightness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece la imagen. Este monitor no deja que el Mac cambie su brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit l’image. Cet écran ne laisse pas le Mac changer sa luminosité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर को मंद करता है। यह मॉनिटर Mac को अपनी चमक बदलने नहीं देता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meredupkan gambar. Monitor ini tidak mengizinkan Mac mengubah kecerahannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurisce l’immagine. Questo monitor non permette al Mac di cambiarne la luminosità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を暗くします。このモニタは Mac からの明るさの変更を受け付けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 어둡게 합니다. 이 모니터는 Mac이 밝기를 바꾸도록 허용하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimt het beeld. Deze monitor laat de Mac zijn helderheid niet wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciemnia obraz. Ten monitor nie pozwala Macowi zmieniać swojej jasności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece a imagem. Este monitor não deixa o Mac mudar o brilho dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întunecă imaginea. Acest monitor nu lasă Mac-ul să-i schimbe luminozitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет картинку: этот монитор не даёт Mac менять свою яркость."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dämpar bilden. Den här bildskärmen låter inte Macen ändra dess ljusstyrka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หรี่ภาพให้มืดลง จอภาพนี้ไม่ให้ Mac เปลี่ยนความสว่างของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüyü karartır. Bu monitör, Mac’in parlaklığını değiştirmesine izin vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнює зображення: цей монітор не дає Mac змінювати свою яскравість."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm tối hình ảnh. Màn hình này không cho máy Mac thay đổi độ sáng của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调暗画面。这台显示器不允许 Mac 更改它的亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調暗畫面。這台顯示器不允許 Mac 更改它的亮度。"
          }
        }
      }
    },
