    "Other devices on your network can connect.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للأجهزة الأخرى على شبكتك الاتصال أيضًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojit se mohou i další zařízení ve vaší síti."
          }
        },
