        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉनिटर %@ पर नहीं रुका और पिछले आकार पर लौट गया। दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
