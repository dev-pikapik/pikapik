    "Press %@ right after a fix to undo it. That word won’t be fixed again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على %@ مباشرةً بعد التصحيح للتراجع عنه. لن تُصحَّح هذه الكلمة مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stisknutím %@ hned po opravě ji vrátíte zpět. Toto slovo se už opravovat nebude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@ direkt nach einer Korrektur, um sie rückgängig zu machen. Dieses Wort wird dann nicht mehr korrigiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ right after a fix to undo it. That word won’t be fixed again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ justo después de una corrección para deshacerla. Esa palabra ya no se volverá a corregir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ juste après une correction pour l’annuler. Ce mot ne sera plus corrigé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुधार पलटने के लिए उसके तुरंत बाद %@ दबाएँ। वह शब्द फिर ठीक नहीं किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan %@ tepat setelah perbaikan untuk membatalkannya. Kata itu tidak akan diperbaiki lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ subito dopo una correzione per annullarla. Quella parola non verrà più corretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正の直後に%@を押すと元に戻ります。その単語は以後修正されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로잡은 직후 %@ 키를 누르면 취소됩니다. 그 단어는 다시 바로잡지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk direct na een correctie op %@ om die ongedaan te maken. Dat woord wordt daarna niet meer gecorrigeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij %@ zaraz po poprawce, aby ją cofnąć. To słowo nie będzie już poprawiane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ logo após uma correção para desfazê-la. Essa palavra não será mais corrigida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați %@ imediat după o corectare ca s-o anulați. Cuvântul acela nu va mai fi corectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ сразу после исправления, чтобы отменить его. Это слово больше не будет исправляться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på %@ direkt efter en rättning för att ångra den. Det ordet rättas inte igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด %@ ทันทีหลังการแก้ไขเพื่อเลิกทำ คำนั้นจะไม่ถูกแก้ไขอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düzeltmeyi geri almak için hemen ardından %@ tuşlarına basın. O sözcük bir daha düzeltilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@ одразу після виправлення, щоб скасувати його. Це слово більше не виправлятиметься."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn %@ ngay sau khi sửa để hoàn tác. Từ đó sẽ không bị sửa nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正后立即按 %@ 可撤销修正。这个词以后不会再被修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正後立即按 %@ 可還原修正。這個字詞之後不會再被修正。"
          }
        }
      }
    },
