    "pikapik keeps this size while it runs, also in the background. When pikapik quits completely, the monitor goes back to its usual size.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ pikapik بهذا الحجم ما دام يعمل، حتى في الخلفية. عند إنهاء pikapik تمامًا تعود الشاشة إلى حجمها المعتاد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik tuto velikost drží, dokud běží, i na pozadí. Když pikapik úplně ukončíte, monitor se vrátí ke své obvyklé velikosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik hält diese Größe, solange es läuft, auch im Hintergrund. Wenn du pikapik vollständig beendest, kehrt der Monitor zu seiner üblichen Größe zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik keeps this size while it runs, also in the background. When pikapik quits completely, the monitor goes back to its usual size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik mantiene este tamaño mientras funciona, también en segundo plano. Al salir del todo de pikapik, el monitor vuelve a su tamaño habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik conserve cette taille tant qu’il fonctionne, même en arrière-plan. Quand vous quittez complètement pikapik, l’écran revient à sa taille habituelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik चलते रहने तक यह आकार बनाए रखता है, बैकग्राउंड में भी। pikapik पूरी तरह बंद करने पर मॉनिटर अपने सामान्य आकार पर लौट आता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik mempertahankan ukuran ini selama berjalan, juga di latar belakang. Saat Anda keluar sepenuhnya dari pikapik, monitor kembali ke ukuran biasanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik mantiene queste dimensioni finché è in funzione, anche in background. Quando esci del tutto da pikapik, il monitor torna alle dimensioni abituali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapikは動作している間、バックグラウンドでもこのサイズを保ちます。pikapikを完全に終了すると、モニタは通常のサイズに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik이 실행되는 동안 백그라운드에서도 이 크기가 유지됩니다. pikapik을 완전히 종료하면 모니터가 원래 크기로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik houdt deze grootte vast zolang het draait, ook op de achtergrond. Als je pikapik helemaal stopt, gaat de monitor terug naar zijn gewone grootte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik utrzymuje ten rozmiar, dopóki działa, także w tle. Gdy całkowicie zakończysz pikapik, monitor wróci do zwykłego rozmiaru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pikapik mantém este tamanho enquanto estiver funcionando, também em segundo plano. Ao encerrar o pikapik de vez, o monitor volta ao tamanho habitual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik păstrează această dimensiune cât timp funcționează, și în fundal. Când ieșiți complet din pikapik, monitorul revine la dimensiunea obișnuită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik сохраняет этот размер, пока работает, в том числе в фоне. Когда вы полностью завершите pikapik, монитор вернётся к обычному размеру."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik behåller den här storleken medan appen körs, även i bakgrunden. När du avslutar pikapik helt går bildskärmen tillbaka till sin vanliga storlek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik จะคงขนาดนี้ไว้ตราบที่ยังทำงานอยู่ แม้อยู่เบื้องหลัง เมื่อคุณออกจาก pikapik จริงๆ จอภาพจะกลับไปเป็นขนาดปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik çalıştığı sürece, arka planda da bu boyutu korur. pikapik’ten tamamen çıktığınızda monitör her zamanki boyutuna döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik зберігає цей розмір, доки працює, зокрема у фоні. Коли ви повністю вийдете з pikapik, монітор повернеться до звичайного розміру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik giữ kích thước này khi đang chạy, kể cả trong nền. Khi bạn thoát hẳn pikapik, màn hình sẽ trở về kích thước thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 运行期间会保持此大小，在后台运行时也是如此。完全退出 pikapik 后，显示器会恢复为平常的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 執行期間會維持此大小，在背景執行時也是如此。完全結束 pikapik 後，顯示器會回到平常的大小。"
          }
        }
      }
    },
    "pikapik keeps working in the background": {
