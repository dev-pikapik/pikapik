    "A quick shortcut switches language without a menu. Holding game keys prevents accidental switching.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر الاختصار القصير اللغة دون قائمة. تمنع مفاتيح اللعب المضغوطة تغيير اللغة بالخطأ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátká zkratka změní jazyk bez nabídky. Držené herní klávesy brání nechtěné změně jazyka."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Tastendruck wechselt die Sprache ohne Menü. Gedrückte Spieltasten verhindern versehentliche Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick shortcut switches language without a menu. Holding game keys prevents accidental switching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo breve cambia el idioma sin menú. Las teclas de juego mantenidas evitan cambios accidentales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci bref change la langue sans menu. Les touches de jeu maintenues empêchent un changement accidentel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा शॉर्टकट मेनू के बिना भाषा बदलता है। गेम की कुंजियाँ दबाए रखने से अनचाही भाषा बदलने से बचते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan singkat mengganti bahasa tanpa menu. Tombol game yang ditahan mencegah perubahan tidak sengaja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scorciatoia breve cambia lingua senza menu. I tasti di gioco tenuti premuti evitano cambi accidentali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いショートカットでメニューを開かずに言語を切り替えます。ゲームのキーを押し続けている間は誤切り替えを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 단축키로 메뉴 없이 언어를 바꿉니다. 게임 키를 누르고 있으면 실수로 언어가 바뀌지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte sneltoets wisselt de taal zonder menu. Ingedrukte gametoetsen voorkomen onbedoelde wissels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótkie naciśnięcie zmienia język bez menu. Przytrzymywane klawisze gry zapobiegają przypadkowej zmianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho breve muda o idioma sem menu. As teclas de jogo mantidas pressionadas evitam trocas acidentais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O scurtătură rapidă schimbă limba fără meniu. Tastele de joc ținute apăsate împiedică schimbarea accidentală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрое нажатие сочетания меняет язык без меню. Пока зажаты игровые клавиши, язык случайно не сменится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kort kommando byter språk utan meny. Nedtryckta speltangenter förhindrar oavsiktliga språkbyten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดที่กดสั้น ๆ จะเปลี่ยนภาษาโดยไม่เปิดเมนู การกดปุ่มเกมค้างช่วยป้องกันการเปลี่ยนภาษาโดยไม่ตั้งใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir kısayol dili menüsüz değiştirir. Basılı oyun tuşları yanlışlıkla dil değiştirmeyi önler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротке поєднання змінює мову без меню. Затиснуті ігрові клавіші захищають від випадкової зміни мови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím tắt ngắn đổi ngôn ngữ không cần menu. Giữ phím trò chơi ngăn đổi ngôn ngữ ngoài ý muốn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按快捷键可切换语言而不打开菜单。按住游戏按键时会避免误切换语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短按快速鍵可切換語言而不開啟選單。按住遊戲按鍵時會避免意外切換語言。"
          }
        }
      }
    },
    "A smaller copy wouldn’t save space, so none was made:": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة الأصغر لن توفّر مساحة، لذلك لم تُنشأ:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Menší kopie by neušetřila místo, takže nevznikla:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleinere Kopie würde keinen Platz sparen, daher wurde keine erstellt:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A smaller copy wouldn’t save space, so none was made:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia más ligera no ahorraría espacio, así que no se ha creado:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie allégée ne ferait pas gagner de place, aucune n’a donc été créée :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी कॉपी से जगह नहीं बचती, इसलिए कॉपी नहीं बनाई गई:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan lebih kecil tidak akan menghemat ruang, jadi tidak dibuat:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia più leggera non farebbe risparmiare spazio, quindi non è stata creata:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいコピーにしても容量が減らないため、作成しませんでした："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 사본을 만들어도 공간이 줄지 않아 만들지 않았습니다:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kleinere kopie zou geen ruimte besparen, dus die is niet gemaakt:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniejsza kopia nie zaoszczędziłaby miejsca, więc jej nie utworzono:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia menor não economizaria espaço, então nenhuma foi criada:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O copie mai mică nu ar economisi spațiu, așa că nu a fost creată:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия поменьше не сэкономит место, поэтому она не создана:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mindre kopia skulle inte spara plats, så ingen skapades:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาที่เล็กลงจะไม่ช่วยประหยัดพื้นที่ จึงไม่ได้สร้าง:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir kopya yer kazandırmayacağı için oluşturulmadı:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менша копія не заощадить місця, тому її не створено:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao nhỏ hơn sẽ không tiết kiệm được dung lượng nên không được tạo:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较小副本无法节省空间，因此未制作："
          }
        },
        "zh-Hant": {
