    "Can’t write to the app’s folder. Update with brew or install.sh": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتعذّر الكتابة في مجلد التطبيق. حدّثه باستخدام brew أو install.sh"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do složky aplikace nelze zapisovat. Aktualizujte přes brew nebo install.sh"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Schreibzugriff auf den App-Ordner. Mit brew oder install.sh aktualisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t write to the app’s folder. Update with brew or install.sh"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso de escritura en la carpeta de la app. Actualiza con brew o install.sh"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’accès en écriture au dossier de l’app. Mettez à jour avec brew ou install.sh"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के फ़ोल्डर में लिखा नहीं जा सकता। brew या install.sh से अपडेट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menulis ke folder app. Perbarui dengan brew atau install.sh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun permesso di scrittura sulla cartella dell’app. Aggiorna con brew o install.sh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのフォルダに書き込めません。brew または install.sh でアップデートしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 폴더에 쓸 권한이 없습니다. brew 또는 install.sh로 업데이트하십시오"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet schrijven naar de map van de app. Werk bij met brew of install.sh"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać w folderze aplikacji. Uaktualnij przez brew lub install.sh"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão de gravação na pasta do app. Atualize com brew ou install.sh"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate scrie în dosarul aplicației. Actualizați cu brew sau install.sh"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет прав на папку с приложением — обновите через brew или install.sh"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte skriva till appens mapp. Uppdatera med brew eller install.sh"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเขียนลงในโฟลเดอร์ของแอปได้ อัปเดตด้วย brew หรือ install.sh"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın klasörüne yazılamıyor. brew veya install.sh ile güncelleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає прав на папку з програмою — онови через brew або install.sh"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi vào thư mục của ứng dụng. Hãy cập nhật bằng brew hoặc install.sh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有应用文件夹的写入权限，请通过 brew 或 install.sh 更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入 App 所在的檔案夾。請使用 brew 或 install.sh 更新"
          }
        }
      }
    },
