        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการแสดงรูปภาพถัดไป โปรดอนุญาตการเข้าถึงโฟลเดอร์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
