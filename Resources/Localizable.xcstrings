    "Couldn’t add the layout. Use Keyboard Settings instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إضافة التخطيط. استخدم إعدادات لوحة المفاتيح بدلًا من ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozložení se nepodařilo přidat. Použijte místo toho Nastavení klávesnice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Layout konnte nicht hinzugefügt werden. Nutze stattdessen die Tastatureinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t add the layout. Use Keyboard Settings instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir la distribución. Usa los Ajustes del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ajouter la disposition. Utilisez plutôt les Réglages Clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेआउट जोड़ा नहीं जा सका। इसके बजाय कीबोर्ड सेटिंग का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menambahkan tata letak. Gunakan Pengaturan Papan Ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiungere il layout. Usa le Impostazioni tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを追加できませんでした。代わりにキーボード設定を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 추가할 수 없습니다. 대신 키보드 설정을 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De indeling kon niet worden toegevoegd. Gebruik in plaats daarvan Instellingen toetsenbord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dodać układu. Użyj zamiast tego Ustawień klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar o layout. Use os Ajustes de Teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut adăuga aranjamentul. Folosiți Configurări tastatură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось добавить раскладку. Воспользуйтесь настройками клавиатуры."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att lägga till layouten. Använd Tangentbordsinställningar i stället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มรูปแบบแป้นพิมพ์ไม่ได้ ใช้การตั้งค่าแป้นพิมพ์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen eklenemedi. Bunun yerine Klavye Ayarları’nı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося додати розкладку. Скористайтеся параметрами клавіатури."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thêm bố cục. Hãy dùng Cài đặt bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加布局。请改用键盘设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加入配置。請改用鍵盤設定。"
          }
        }
      }
    },
    "Couldn’t change the fan speed. Try allowing administrator access again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تغيير سرعة المراوح. جرّب السماح بصلاحيات المسؤول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlost ventilátorů se nepodařilo změnit. Zkuste přístup správce povolit znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüftergeschwindigkeit konnte nicht geändert werden. Erlaube den Administratorzugriff noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t change the fan speed. Try allowing administrator access again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar la velocidad de los ventiladores. Vuelve a permitir el acceso de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer la vitesse des ventilateurs. Autorisez de nouveau l’accès administrateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंखे की गति नहीं बदली जा सकी। एडमिन एक्सेस की अनुमति फिर से दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan kipas tidak bisa diubah. Coba izinkan akses administrator lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile cambiare la velocità delle ventole. Consenti di nuovo l’accesso amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンの回転数を変更できませんでした。もう一度管理者アクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬 속도를 바꾸지 못했습니다. 관리자 접근을 다시 허용해 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ventilatorsnelheid kon niet worden gewijzigd. Sta de beheerderstoegang opnieuw toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zmienić prędkości wentylatorów. Spróbuj ponownie zezwolić na dostęp administratora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mudar a velocidade das ventoinhas. Tente permitir o acesso de administrador de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Viteza ventilatoarelor nu a putut fi schimbată. Încercați să permiteți din nou accesul de administrator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить скорость вентиляторов. Разрешите доступ администратора ещё раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att ändra fläkthastigheten. Försök tillåta administratörsåtkomst igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนความเร็วพัดลมไม่ได้ ลองอนุญาตการเข้าถึงของผู้ดูแลระบบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan hızı değiştirilemedi. Yönetici erişimine yeniden izin vermeyi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося змінити швидкість вентиляторів. Дозвольте доступ адміністратора ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đổi được tốc độ quạt. Hãy thử cho phép quyền quản trị lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改风扇转速。请再次允许管理员权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更改風扇轉速。請再次允許管理員權限。"
          }
        }
      }
    },
