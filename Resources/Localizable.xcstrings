    "macOS asks for your administrator password each time Keep Awake turns on with this option.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب macOS كلمة سر المسؤول في كل مرة يعمل فيها «منع السكون» مع هذا الخيار."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS žádá o heslo správce pokaždé, když se „Bez spánku“ zapne s touto volbou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt jedes Mal nach dem Administratorpasswort, wenn „Wach bleiben“ mit dieser Option angeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for your administrator password each time Keep Awake turns on with this option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide la contraseña de administrador cada vez que «Mantener activo» se activa con esta opción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande le mot de passe administrateur chaque fois que « Rester éveillé » s’active avec cette option."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी “जगाए रखें” इस विकल्प के साथ चालू होता है, macOS आपसे एडमिन पासवर्ड माँगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS meminta kata sandi administrator setiap kali “Tetap Terjaga” menyala dengan pilihan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiede la password dell’amministratore ogni volta che “Resta sveglio” si attiva con questa opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオプションで「スリープさせない」がオンになるたびに、macOS が管理者パスワードを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션으로 ‘잠자기 방지’가 켜질 때마다 macOS가 관리자 암호를 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vraagt om je beheerderswachtwoord telkens als “Wakker houden” met deze optie aangaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS prosi o hasło administratora za każdym razem, gdy „Bez usypiania” włącza się z tą opcją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pede a senha de administrador sempre que “Manter ativo” é ativado com esta opção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS cere parola de administrator de fiecare dată când „Menține activ” pornește cu această opțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS спрашивает пароль администратора каждый раз, когда «Не засыпать» включается с этим параметром."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS frågar efter administratörslösenordet varje gång ”Håll vaken” slås på med det här alternativet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS จะขอรหัสผ่านผู้ดูแลระบบทุกครั้งที่ “ไม่ให้หลับ” เปิดพร้อมตัวเลือกนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uyanık Tut” bu seçenekle her açıldığında macOS yönetici parolanızı ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запитує пароль адміністратора щоразу, коли «Не засинати» вмикається з цим параметром."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hỏi mật khẩu quản trị viên mỗi lần “Giữ máy thức” bật với tùy chọn này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次“保持唤醒”带此选项开启时，macOS 都会要求输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次「保持喚醒」以此選項開啟時，macOS 都會要求輸入管理者密碼。"
          }
        }
      }
    },
    "macOS did not let pikapik move it. Turn on pikapik under App Management, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسمح macOS لـ pikapik بنقل العنصر. فعّل pikapik ضمن «إدارة التطبيقات» ثم أعد المحاولة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS přesun položky nedovolil. Zapněte pikapik v části „Správa aplikací“ a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat nicht erlaubt, dass pikapik das Objekt bewegt. Schalte pikapik unter „App-Verwaltung“ ein und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not let pikapik move it. Turn on pikapik under App Management, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no dejó que pikapik moviera el elemento. Activa pikapik en «Gestión de apps» y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
