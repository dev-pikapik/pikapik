          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Effetto scala» per un’animazione più rapida"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スケールエフェクト」を選ぶとアニメーションが速くなります"
