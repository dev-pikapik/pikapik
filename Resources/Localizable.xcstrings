    "The app has to close first. If it has unsaved work, it will ask you what to do.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب إغلاق التطبيق أولًا. إذا كان لديه عمل غير محفوظ، فسيسألك عمّا تريد فعله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikaci je nejdřív nutné zavřít. Pokud má neuložené změny, zeptá se, co s nimi dělat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App muss zuerst geschlossen werden. Falls noch etwas nicht gesichert ist, fragt sie dich, was passieren soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has to close first. If it has unsaved work, it will ask you what to do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app debe cerrarse primero. Si tiene trabajo sin guardar, te preguntará qué hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app doit d’abord être fermée. Si elle contient du travail non enregistré, elle vous demandera quoi faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले ऐप को बंद करना होगा। अगर उसमें बिना सहेजा काम है, तो वह आपसे पूछेगा कि क्या करना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App harus ditutup dulu. Jika ada pekerjaan yang belum disimpan, app akan menanyakan apa yang ingin Anda lakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app deve prima essere chiusa. Se ha lavoro non salvato, ti chiederà cosa fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にアプリを閉じる必要があります。保存していない作業がある場合は、どうするかアプリが確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 앱을 닫아야 합니다. 저장하지 않은 작업이 있으면 어떻게 할지 앱이 물어봅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app moet eerst worden gesloten. Als er nog niet-bewaard werk is, vraagt de app wat je wilt doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikację trzeba najpierw zamknąć. Jeśli ma niezapisaną pracę, zapyta, co zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app precisa ser fechado antes. Se houver trabalho não salvo, ele vai perguntar o que fazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația trebuie închisă mai întâi. Dacă are lucru nesalvat, vă va întreba ce să faceți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала приложение нужно закрыть. Если в нём есть несохранённая работа, оно спросит, что делать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen måste stängas först. Om den har osparat arbete frågar den vad du vill göra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องปิดแอปก่อน หากมีงานที่ยังไม่ได้บันทึก แอปจะถามว่าจะให้ทำอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce uygulamanın kapanması gerekir. Kaydedilmemiş işi varsa ne yapılacağını size soracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку програму потрібно закрити. Якщо в ній є незбережена робота, вона запитає, що робити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần đóng ứng dụng trước. Nếu còn công việc chưa lưu, ứng dụng sẽ hỏi bạn muốn làm gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先关闭此 App。如果有未存储的内容，它会询问你该怎么做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先關閉此 App。如果有未儲存的內容，它會詢問你該怎麼做。"
          }
        }
      }
    },
    "The app hides with all its windows, like with ⌘H": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختفي التطبيق مع كل نوافذه، كما مع ⌘H"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace se skryje i se všemi okny, jako s ⌘H"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App verschwindet mit all ihren Fenstern, wie mit ⌘H"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app hides with all its windows, like with ⌘H"
          }
        },
