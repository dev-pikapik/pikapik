        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é removido até você escolher"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se elimină nimic până nu alegeți dumneavoastră"
