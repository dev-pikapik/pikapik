    "Restart Finder once to bring back the right-click items": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل Finder مرة واحدة لتعود عناصر قائمة النقر بزر الماوس الأيمن"
          }
        },
        "cs": {
