            "state": "translated",
            "value": "La vue de toutes les fenêtres ne s’ouvre pas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी विंडो का नज़ारा नहीं खुलता"
          }
        },
        "id": {
          "stringUnit": {
