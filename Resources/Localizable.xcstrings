    "May pause to load. HD will play smoothly.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتوقف للتحميل. سيعمل HD بسلاسة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Může se zastavovat kvůli načítání. HD poběží plynule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann zum Laden anhalten. HD läuft flüssig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May pause to load. HD will play smoothly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede pararse a cargar. El HD irá fluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut s’arrêter pour charger. La HD sera fluide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड होने के लिए रुक सकता है। HD आराम से चलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa berhenti untuk memuat. HD akan lancar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può fermarsi a caricare. L’HD andrà fluido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みで止まることがあります。HDならスムーズです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로딩으로 멈출 수 있습니다. HD는 끊김 없이 재생됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stoppen om te laden. HD speelt soepel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może zatrzymywać się na ładowanie. HD pójdzie płynnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode parar para carregar. Em HD roda sem travar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poate opri ca să se încarce. HD va merge fluid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может останавливаться на загрузку. HD пойдёт без пауз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stanna för att ladda. HD spelas smidigt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจหยุดเพื่อโหลด HD จะเล่นได้ลื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklenmek için durabilir. HD sorunsuz oynar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Може зупинятися на завантаження. HD гратиме без пауз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể dừng để tải. HD sẽ phát mượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能会停下来缓冲。HD 能流畅播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能會停下來緩衝。HD 能流暢播放。"
          }
        }
      }
    },
