          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Mac nu poate afișa acum monitorul la %@. Încercați altă dimensiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac сейчас не может показать монитор в масштабе %@. Попробуйте другой размер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Mac-datorn kan inte visa bildskärmen i %@ just nu. Prova en annan storlek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้แสดงจอภาพที่ %@ ไม่ได้ในตอนนี้ ลองขนาดอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac şu anda monitörü %@ değerinde gösteremiyor. Başka bir boyut deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac зараз не може показати монітор у масштабі %@. Спробуйте інший розмір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này hiện không thể hiển thị màn hình ở %@. Hãy thử kích thước khác."
          }
        },
        "zh-Hans": {
