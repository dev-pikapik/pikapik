    "Lets the app save new files next to yours and see your background tasks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للتطبيق بحفظ الملفات الجديدة بجانب ملفاتك ورؤية مهام الخلفية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikaci ukládat nové soubory vedle vašich a vidět úlohy na pozadí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit die App neue Dateien neben deinen speichern und deine Hintergrundaufgaben sehen kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app save new files next to yours and see your background tasks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para guardar archivos nuevos junto a los tuyos y ver tus tareas en segundo plano"
