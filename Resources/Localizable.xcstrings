          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý tenhle okraj je moje království."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser ganze Rand ist mein Königreich."
