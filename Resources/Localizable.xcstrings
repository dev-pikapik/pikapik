    "Your Mac is a little warm but still running at full speed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Mac دافئ قليلًا لكنه لا يزال يعمل بأقصى سرعة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac je trochu zahřátý, ale pořád běží na plný výkon"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac ist etwas warm, läuft aber weiter mit voller Geschwindigkeit"
