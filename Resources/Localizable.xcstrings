    "Only System Settings can remove this one. Select it in the list and press −.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إزالة هذا إلا من إعدادات النظام. حدده في القائمة واضغط على −."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle umí odstranit jen Nastavení systému. Vyberte položku v seznamu a klepněte na −."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geht nur in den Systemeinstellungen: Wähle den Eintrag in der Liste aus und klicke auf −."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only System Settings can remove this one. Select it in the list and press −."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Ajustes del Sistema puede quitar este. Selecciónalo en la lista y pulsa −."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les Réglages Système peuvent retirer celle-ci. Sélectionnez-la dans la liste et cliquez sur −."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे सिर्फ़ सिस्टम सेटिंग्ज़ में हटाया जा सकता है। सूची में इसे चुनें और − दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya Pengaturan Sistem yang bisa menghapus yang ini. Pilih di daftar lalu tekan −."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Impostazioni di Sistema può rimuovere questo. Selezionalo nell’elenco e premi −."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはシステム設定でしか取り除けません。一覧で選択して−を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 시스템 설정에서만 제거할 수 있습니다. 목록에서 선택하고 −를 누르십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen Systeeminstellingen kan deze weghalen. Selecteer hem in de lijst en klik op −."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To da się usunąć tylko w Ustawieniach systemowych. Zaznacz pozycję na liście i kliknij −."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os Ajustes do Sistema podem remover esta. Selecione-a na lista e clique em −."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar Configurări sistem o poate elimina. Selectați-o în listă și apăsați −."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разрешение можно убрать только в Системных настройках: выберите его в списке и нажмите −."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara Systeminställningar kan ta bort den här. Markera den i listan och tryck på −."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแค่การตั้งค่าระบบที่เอารายการนี้ออกได้ เลือกในรายการแล้วกด −"
