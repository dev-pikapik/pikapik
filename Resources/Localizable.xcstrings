          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ‘Glijdende schaal’ voor een snellere animatie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Efekt skalowania”, aby animacja była szybsza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha “Efeito Escala” para uma animação mais rápida"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți „Efect de redimensionare” pentru o animație mai rapidă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Простое уменьшение», чтобы анимация была быстрее"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ”Skalningseffekt” för en snabbare animering"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก “เอฟเฟ็กต์รูปแบบขนาด” เพื่อให้ภาพเคลื่อนไหวเร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hızlı bir animasyon için “Ölçekleme Efektiyle” seçeneğini seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
