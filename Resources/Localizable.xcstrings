    "How fast Save and Print panels slide out and windows change size.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعة انزلاق لوحتي الحفظ والطباعة وتغيّر حجم النوافذ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak rychle se vysouvají panely Uložit a Tisk a mění se velikost oken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell die Dialoge „Sichern“ und „Drucken“ herausgleiten und Fenster ihre Größe ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How fast Save and Print panels slide out and windows change size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rapidez con que se despliegan los paneles Guardar e Imprimir y cambian de tamaño las ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse à laquelle les zones Enregistrer et Imprimer se déroulent et les fenêtres changent de taille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव और प्रिंट पैनल कितनी तेज़ी से खिसककर आते हैं और विंडो का आकार कितनी तेज़ी से बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa cepat panel Simpan dan Cetak meluncur keluar dan jendela berubah ukuran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto velocemente si aprono i pannelli Salva e Stampa e le finestre cambiano dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「保存」や「プリント」のパネルが出てくる速さと、ウインドウのサイズが変わる速さです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 및 프린트 패널이 나오는 속도와 윈도우 크기가 바뀌는 속도입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe snel de panelen Bewaar en Druk af uitschuiven en vensters van formaat veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak szybko wysuwają się panele Zachowaj i Drukuj oraz zmienia się rozmiar okien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rapidez com que os painéis Salvar e Imprimir deslizam e as janelas mudam de tamanho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de repede glisează panourile Salvează și Tipărește și își schimbă ferestrele dimensiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро выезжают панели «Сохранить» и «Печать» и меняется размер окон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur snabbt panelerna Spara och Skriv ut glider fram och fönster ändrar storlek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเร็วที่แผงบันทึกและพิมพ์เลื่อนออกมา และหน้าต่างเปลี่ยนขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydet ve Yazdır panellerinin ne kadar hızlı açıldığı ve pencerelerin ne kadar hızlı boyut değiştirdiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як швидко виїжджають панелі «Зберегти» й «Друк» і змінюється розмір вікон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ bảng Lưu và In trượt ra và cửa sổ đổi kích thước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“存储”和“打印”面板滑出以及窗口调整大小的速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「儲存」和「列印」面板滑出以及視窗調整大小的速度。"
          }
        }
      }
    },
