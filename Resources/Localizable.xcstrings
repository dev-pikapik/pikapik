          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona se hai due o più layout di tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードレイアウトが2つ以上あるときに使えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 레이아웃이 두 개 이상 있을 때 작동합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit werkt als je twee of meer toetsenbordindelingen hebt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa, gdy masz co najmniej dwa układy klawiatury"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona quando há dois ou mais layouts de teclado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcționează când aveți cel puțin două aranjamente de tastatură"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает, если у вас две раскладки клавиатуры или больше"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungerar när du har två eller fler tangentbordslayouter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้เมื่อมีรูปแบบแป้นพิมพ์ตั้งแต่สองแบบขึ้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki veya daha fazla klavye düzeniniz olduğunda çalışır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює, якщо у вас дві розкладки клавіатури або більше"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
