            "value": "¿Ya es hora de picar algo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est bientôt l’heure du goûter ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या नाश्ते का समय हो गया?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah waktunya ngemil belum?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già ora della merenda?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そろそろおやつの時間？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 간식 시간입니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is het al tijd voor een snack?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy to już pora na przekąskę?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já é hora do lanchinho?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E deja ora gustării?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "А уже пора перекусить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är det mellanmålsdags än?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงเวลาของว่างหรือยัง?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atıştırma saati geldi mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "А вже час перекусити?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ ăn vặt chưa nhỉ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到点心时间了吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到點心時間了嗎？"
          }
        }
      }
    },
    "It belongs to another user or to the system, so pikapik doesn’t touch it. You can quit it in Activity Monitor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا البرنامج يخص مستخدمًا آخر أو النظام، لذا لا يلمسه pikapik. يمكنك إنهاؤه من مراقب النشاط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Program patří jinému uživateli nebo systému, takže na něj pikapik nesahá. Ukončit ho můžete v aplikaci Monitor aktivity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Programm gehört einem anderen Benutzer oder dem System, deshalb lässt pikapik es in Ruhe. Du kannst es in der Aktivitätsanzeige beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It belongs to another user or to the system, so pikapik doesn’t touch it. You can quit it in Activity Monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa pertenece a otro usuario o al sistema, así que pikapik no lo toca. Puedes cerrarlo en Monitor de Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme appartient à un autre utilisateur ou au système, donc pikapik n’y touche pas. Vous pouvez le quitter dans Moniteur d’activité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रोग्राम किसी दूसरे उपयोगकर्ता या सिस्टम का है, इसलिए pikapik इसे नहीं छूता। आप इसे ऐक्टिविटी मॉनिटर में बंद कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program ini milik pengguna lain atau sistem, jadi pikapik tidak menyentuhnya. Anda bisa menutupnya di Monitor Aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma appartiene a un altro utente o al sistema, quindi pikapik non lo tocca. Puoi chiuderlo da Monitoraggio Attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプログラムはほかのユーザまたはシステムのものなので、pikapikは操作しません。アクティビティモニタで終了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자나 시스템의 프로그램이므로 pikapik은 건드리지 않습니다. 활성 상태 보기에서 종료할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het programma is van een andere gebruiker of van het systeem, dus pikapik laat het met rust. Je kunt het stoppen in Activiteitenweergave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program należy do innego użytkownika lub do systemu, więc pikapik go nie rusza. Możesz go zakończyć w Monitorze aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa pertence a outro usuário ou ao sistema, então o pikapik não mexe nele. Você pode encerrá-lo no Monitor de Atividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Programul aparține altui utilizator sau sistemului, așa că pikapik nu se atinge de el. Îl puteți închide din Monitor activitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа принадлежит другому пользователю или системе, поэтому pikapik её не трогает. Её можно завершить в «Мониторинге системы»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmet tillhör en annan användare eller systemet, så pikapik rör det inte. Du kan avsluta det i Aktivitetskontroll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมนี้เป็นของผู้ใช้อื่นหรือของระบบ pikapik จึงไม่แตะต้อง คุณออกจากโปรแกรมนี้ได้ในตัวตรวจสอบกิจกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program başka bir kullanıcıya ya da sisteme ait, bu yüzden pikapik ona dokunmuyor. Programı Etkinlik Monitörü’nden kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма належить іншому користувачеві або системі, тому pikapik її не чіпає. Її можна завершити в «Моніторі активності»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chương trình này thuộc về người dùng khác hoặc hệ thống nên pikapik không động đến. Bạn có thể thoát chương trình trong Giám sát hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个程序属于其他用户或系统，所以 pikapik 不会动它。你可以在“活动监视器”中退出它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個程式屬於其他使用者或系統，所以 pikapik 不會動它。你可以在「活動監視器」中結束它。"
          }
        }
      }
    },
    "It changed while pikapik was working, so it was left alone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر العنصر أثناء عمل pikapik، لذلك تُرك كما هو."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka se změnila během práce aplikace pikapik, proto zůstala nedotčená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt hat sich geändert, während pikapik gearbeitet hat. Deshalb wurde es nicht angerührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changed while pikapik was working, so it was left alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento cambió mientras pikapik trabajaba, así que no se tocó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément a changé pendant que pikapik travaillait, il n’a donc pas été touché."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik के काम करते समय यह आइटम बदल गया, इसलिए इसे छुआ नहीं गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item ini berubah saat pikapik bekerja, jadi tidak disentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elemento è cambiato mentre pikapik lavorava, quindi non è stato toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik の作業中に変更されたため、そのままにしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik이(가) 작업하는 동안 항목이 변경되어 그대로 두었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het onderdeel is veranderd terwijl pikapik bezig was en is daarom met rust gelaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element zmienił się w trakcie pracy pikapik, więc nie został ruszony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item mudou enquanto o pikapik trabalhava, então não foi tocado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementul s-a schimbat cât timp lucra pikapik, așa că nu a fost atins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент изменился, пока pikapik работал, поэтому его не тронули."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektet ändrades medan pikapik arbetade och lämnades därför orört."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้เปลี่ยนแปลงระหว่างที่ pikapik ทำงาน จึงไม่ได้แตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğe, pikapik çalışırken değiştiği için dokunulmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент змінився, поки pikapik працював, тому його не чіпали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này đã thay đổi trong lúc pikapik làm việc nên được để yên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目在 pikapik 工作期间发生了变化，因此未做改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目在 pikapik 運作期間發生了變化，因此未做更動。"
          }
        }
      }
    },
    "It cools itself quietly, so there is nothing to set": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبرّد نفسه بهدوء، فلا يوجد شيء لضبطه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chladí se tiše sám, takže není co nastavovat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kühlt sich leise von selbst, daher gibt es nichts einzustellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It cools itself quietly, so there is nothing to set"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se enfría solo en silencio, así que no hay nada que ajustar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se refroidit tout seul en silence, il n’y a rien à régler"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चुपचाप अपने आप ठंडा रहता है, इसलिए कुछ सेट करने की ज़रूरत नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini mendinginkan diri dengan senyap, jadi tidak ada yang perlu diatur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si raffredda da solo in silenzio, quindi non c’è nulla da impostare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに自分で冷えるので、設定するものはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용히 스스로 식으므로 설정할 것이 없습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij koelt zichzelf stil af, dus er valt niets in te stellen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chłodzi się sam po cichu, więc nie ma nic do ustawienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele se resfria sozinho e em silêncio, então não há nada para ajustar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se răcește singur, în liniște, așa că nu e nimic de setat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он охлаждается тихо сам, настраивать нечего"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kyler sig själv tyst, så det finns inget att ställa in"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องระบายความร้อนเองอย่างเงียบ ๆ จึงไม่มีอะไรให้ตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendini sessizce soğutur, ayarlanacak bir şey yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він охолоджується тихо сам, налаштовувати нічого"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tự làm mát êm ái nên không có gì để chỉnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会安静地自行散热，无需设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會安靜地自行散熱，不需要設定"
          }
        }
      }
    },
    "It could fill up your disk.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يمتلئ القرص."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohlo by to zaplnit celý disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Speicher könnte dadurch voll werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It could fill up your disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podría llenar tu disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre disque pourrait être saturé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपकी डिस्क भर सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk bisa menjadi penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe riempire il disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクがいっぱいになるおそれがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크가 가득 찰 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je schijf kan hierdoor vol raken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może to zapełnić cały dysk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso pode lotar o seu disco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar putea umple tot discul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может заполнить весь диск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan fylla hela disken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจทำให้ดิสก์เต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskiniz dolabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це може заповнити весь диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể làm đầy ổ đĩa của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘可能会被占满。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟可能會被佔滿。"
          }
        }
      }
    },
    "It could not be moved. Drag it to the Trash in Finder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر نقل العنصر. اسحبه إلى سلة المهملات في Finder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položku se nepodařilo přesunout. Přetáhněte ji ve Finderu do Koše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt konnte nicht bewegt werden. Ziehe es im Finder in den Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It could not be moved. Drag it to the Trash in Finder."
          }
