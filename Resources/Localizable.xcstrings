          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn “Hiệu ứng tỷ lệ” để hoạt ảnh nhanh hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“缩放效果”，动画会更快"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「縮放效果」，動畫會更快"
