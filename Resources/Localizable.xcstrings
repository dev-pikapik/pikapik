    "Fine-tune protection and explore your Mac’s shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط الحماية واستكشف اختصارات Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte ochranu a prozkoumejte zkratky svého Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schutz anpassen und die Kurzbefehle deines Mac erkunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tune protection and explore your Mac’s shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la protección y explora los atajos de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la protection et explorez les raccourcis de votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा समायोजित करें और Mac के शॉर्टकट देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan perlindungan dan jelajahi pintasan Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la protezione ed esplora le scorciatoie del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護を調整してMacのショートカットを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호를 조정하고 Mac 단축키를 살펴보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de bescherming aan en ontdek de sneltoetsen van je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj ochronę i poznaj skróty swojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a proteção e explore os atalhos do Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustați protecția și explorați scurtăturile Macului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте защиту и изучите сочетания вашего Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa skyddet och utforska kortkommandona på din Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับการป้องกันและสำรวจปุ่มลัดของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korumayı ayarlayın ve Mac’inizin kısayollarını keşfedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте захист і дослідіть поєднання вашого Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinh chỉnh bảo vệ và khám phá phím tắt của Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整保护并探索 Mac 的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整保護並探索 Mac 的快速鍵。"
          }
        }
      }
    },
