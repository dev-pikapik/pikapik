          "stringUnit": {
            "state": "translated",
            "value": "พัดลมกลับเป็นอัตโนมัติเพื่อความปลอดภัยของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizi korumak için fanlar Otomatik’e döndü"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вентилятори повернулися в режим «Авто», щоб Mac не перегрівся"
          }
        },
        "vi": {
          "stringUnit": {
