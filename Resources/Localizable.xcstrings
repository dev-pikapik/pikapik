          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 App，並將其資料、設定和暫存檔案移到垃圾桶"
          }
        }
      }
    },
    "Keeps the mouse wheel switching hotbar slots while you hold Shift to sneak.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى عجلة الفأرة تبدّل خانات الشريط السريع أثناء الضغط على Shift للتسلل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolečko myši dál přepíná sloty lišty, i když držíte Shift a plížíte se."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mausrad wechselt weiter die Hotbar-Slots, während du Shift zum Schleichen hältst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the mouse wheel switching hotbar slots while you hold Shift to sneak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rueda del ratón sigue cambiando las ranuras de la barra rápida mientras mantienes Shift para agacharte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La molette de la souris continue de changer d’emplacement de la barre rapide quand vous maintenez Maj pour vous accroupir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift दबाकर चुपके से चलते समय भी माउस व्हील हॉटबार के स्लॉट बदलता रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Roda mouse tetap mengganti slot hotbar saat Anda menahan Shift untuk berjongkok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rotella del mouse continua a cambiare gli slot della barra rapida mentre tieni premuto Maiusc per accovacciarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftを押してしゃがんでいる間も、マウスホイールでホットバーのスロットを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift를 눌러 웅크린 상태에서도 마우스 휠로 단축 슬롯을 계속 전환합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het muiswiel blijft de hotbar-slots wisselen terwijl je Shift ingedrukt houdt om te sluipen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kółko myszy nadal zmienia sloty paska, gdy trzymasz Shift, żeby się skradać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A roda do mouse continua trocando os espaços da barra de atalhos enquanto você segura Shift para agachar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotița mausului continuă să schimbe sloturile din bara rapidă cât ții apăsat Shift ca să te furișezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колесо мыши продолжает переключать ячейки быстрой панели, пока вы держите Shift, чтобы красться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mushjulet fortsätter byta plats i snabbfältet medan du håller Skift för att smyga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้อเมาส์ยังคงเปลี่ยนช่องบนแถบด่วนได้ขณะที่คุณกด Shift ค้างไว้เพื่อย่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlenmek için Shift’e basılı tutarken fare tekerleği hızlı çubuktaki yuvaları değiştirmeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колесо миші й далі перемикає комірки швидкої панелі, поки ви тримаєте Shift, щоб скрадатися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con lăn chuột vẫn đổi ô thanh nhanh khi bạn giữ Shift để rón rén."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 潜行时，鼠标滚轮仍可切换快捷栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 潛行時，滑鼠滾輪仍可切換快捷列。"
          }
        }
      }
    },
    "Keyboard": {
      "extractionState": "manual",
