    "Water break? I’ll keep your seat warm.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استراحة لشرب الماء؟ سأحجز لك مكانك دافئًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza na vodu? Pohlídám vám místo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinkpause? Ich halte dir den Platz warm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water break? I’ll keep your seat warm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pausa para beber agua? Te guardo el sitio calentito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pause pour boire ? Je vous garde la place au chaud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पानी पीने का ब्रेक? मैं आपकी जगह गरम रखूँगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Istirahat minum? Kursi Anda biar aku yang jaga tetap hangat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa acqua? Ti tengo il posto caldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お水休憩？席はあたためておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 마시는 시간? 자리는 따뜻하게 지켜 두겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even water drinken? Ik houd je plekje warm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwa na wodę? Przypilnuję ci miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa pra uma água? Eu guardo seu lugar quentinho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauză de apă? Vă țin locul cald."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попьём водички? Я посторожу ваше место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vattenpaus? Jag håller din plats varm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พักดื่มน้ำไหม? เดี๋ยวจองที่ไว้ให้อุ่น ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su molası mı? Yerinizi sıcak tutarım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перерва на водичку? Я постережу ваше місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
