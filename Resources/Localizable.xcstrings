          "stringUnit": {
            "state": "translated",
            "value": "Mac を守るため、ファンは自動に戻りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 보호하기 위해 팬이 자동으로 돌아갔습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ventilatoren zijn teruggegaan naar Auto om je Mac te beschermen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wentylatory wróciły do trybu Auto, aby chronić Maca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ventoinhas voltaram para Auto para proteger seu Mac"
          }
        },
