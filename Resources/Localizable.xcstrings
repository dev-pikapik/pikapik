            "value": "Video HD pun bisa berhenti untuk memuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche i video HD possono fermarsi a caricare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HD動画でも読み込みで止まることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HD 동영상도 로딩으로 멈출 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs HD-video kan stoppen om te laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet wideo HD może zatrzymywać się na ładowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até vídeo em HD pode parar para carregar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiar și video HD se poate opri ca să se încarce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже HD-видео может останавливаться на загрузку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även HD-video kan stanna för att ladda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้แต่วิดีโอ HD ก็อาจหยุดเพื่อโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HD video bile yüklenmek için durabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть HD-відео може зупинятися на завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả video HD cũng có thể dừng để tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使是 HD 视频也可能停下来缓冲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使是 HD 影片也可能停下來緩衝。"
          }
        }
      }
    },
    "Even calmer: Reduce Motion in Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدوء أكثر: تقليل الحركة في تسهيلات الاستخدام"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ještě klidněji: Omezit pohyb ve Zpřístupnění"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ruhiger: „Bewegung reduzieren“ in den Bedienungshilfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even calmer: Reduce Motion in Accessibility"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún más calma: Reducir movimiento en Accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore plus calme : Réduire les animations dans Accessibilité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और भी शांत: ऐक्सेसिबिलिटी में मोशन कम करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih tenang lagi: Kurangi gerakan di Aksesibilitas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora più calma: Riduci movimento in Accessibilità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに穏やかに：アクセシビリティの「視差効果を減らす」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 차분하게: 손쉬운 사용의 동작 줄이기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog rustiger: Verminder beweging in Toegankelijkheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze spokojniej: Ogranicz ruch w Dostępności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda mais calmo: Reduzir movimento em Acessibilidade"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Și mai calm: Redu mișcarea în Accesibilitate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё спокойнее: «Уменьшение движения» в Универсальном доступе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ännu lugnare: Minska rörelse i Hjälpmedel"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สงบยิ่งขึ้น: ลดการเคลื่อนไหวในการช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha da sakin: Erişilebilirlik’te Hareketi azalt"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще спокійніше: «Зменшити рух» у Доступності"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Êm dịu hơn nữa: Giảm chuyển động trong Trợ năng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更平静：辅助功能中的“减弱动态效果”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更平靜：輔助使用中的「減少動態效果」"
          }
        }
      }
    },
    "Every now and then it sits down for a chat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلس من حين لآخر ليدردش قليلًا"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Občas si sedne na kus řeči"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt sich ab und zu für einen kleinen Plausch hin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every now and then it sits down for a chat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez en cuando se sienta a charlar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De temps en temps, il s’assoit pour papoter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बीच-बीच में बैठकर गपशप करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesekali ia duduk untuk mengobrol"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tanto si siede a fare due chiacchiere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき座っておしゃべりします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 앉아서 수다를 떱니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat af en toe even zitten voor een praatje"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jakiś czas siada na pogawędkę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez em quando ele senta para bater papo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din când în când se așază la o poveste"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время от времени садится поболтать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då och då sätter det sig för en pratstund"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาน ๆ ครั้งจะนั่งลงคุยเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arada bir oturup sohbet eder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час від часу сідає побалакати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thỉnh thoảng nó ngồi xuống tán gẫu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时不时坐下来聊几句"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不時坐下來聊幾句"
          }
        }
      }
    },
    "Every now and then it sits down for a chat and tells you when an update is out": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلس من حين لآخر ليدردش قليلًا ويخبرك عندما يصدر تحديث"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Občas si sedne na kus řeči a dá vědět, když vyjde aktualizace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt sich ab und zu für einen kleinen Plausch hin und sagt Bescheid, wenn ein Update da ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every now and then it sits down for a chat and tells you when an update is out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez en cuando se sienta a charlar y te avisa cuando sale una actualización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De temps en temps, il s’assoit pour papoter et vous prévient quand une mise à jour est sortie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बीच-बीच में बैठकर गपशप करता है और अपडेट आने पर बताता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesekali ia duduk untuk mengobrol dan memberi tahu saat ada pembaruan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tanto si siede a fare due chiacchiere e ti avvisa quando esce un aggiornamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき座っておしゃべりし、アップデートが出たら教えてくれます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 앉아서 수다를 떨고, 업데이트가 나오면 알려 줍니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat af en toe even zitten voor een praatje en laat weten wanneer er een update is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jakiś czas siada na pogawędkę i daje znać, kiedy wyjdzie aktualizacja"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez em quando ele senta para bater papo e avisa quando sai uma atualização"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din când în când se așază la o poveste și vă anunță când apare o actualizare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время от времени садится поболтать и рассказывает, когда вышло обновление"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då och då sätter det sig för en pratstund och berättar när en uppdatering har kommit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นาน ๆ ครั้งจะนั่งลงคุยเล่น และบอกเมื่อมีอัปเดตใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arada bir oturup sohbet eder ve bir güncelleme çıktığında haber verir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час від часу сідає побалакати й розповідає, коли вийшло оновлення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thỉnh thoảng nó ngồi xuống tán gẫu và báo cho bạn khi có bản cập nhật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时不时坐下来聊几句，有更新时也会告诉你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不時坐下來聊幾句，有更新時也會告訴你"
          }
        }
      }
    },
    "Every permission belongs to an app that’s still on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إذن يخص تطبيقًا لا يزال على جهاز Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna oprávnění patří aplikacím, které na vašem Macu pořád jsou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Berechtigung gehört zu einer App, die noch auf deinem Mac ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every permission belongs to an app that’s still on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los permisos son de apps que siguen en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque autorisation appartient à une app encore présente sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अनुमति किसी ऐसे ऐप की है जो अभी भी आपके Mac पर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap izin dimiliki app yang masih ada di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni permesso appartiene a un’app ancora presente sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアクセス許可は、Macにまだあるアプリのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 권한이 아직 Mac에 있는 앱의 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke toestemming hoort bij een app die nog op je Mac staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uprawnienie należy do aplikacji, która nadal jest na Twoim Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as permissões são de apps que ainda estão no seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate permisiunile aparțin unor aplicații care sunt încă pe Mac-ul dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все разрешения принадлежат приложениям, которые всё ещё есть на вашем Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla behörigheter hör till appar som fortfarande finns på din Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ทั้งหมดเป็นของแอปที่ยังอยู่บน Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her izin hâlâ Mac’inizde olan bir uygulamaya ait."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі дозволи належать програмам, які досі є на вашому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quyền đều thuộc về ứng dụng vẫn còn trên máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项权限都属于仍在这台 Mac 上的 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每項權限都屬於仍在這台 Mac 上的 App。"
          }
        }
      }
    },
    "Every press switches language without the system menu. The same keys still reach the game.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر كل ضغطة اللغة دون قائمة النظام. تظل المفاتيح نفسها تصل إلى اللعبة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý stisk změní jazyk bez systémové nabídky. Stejné klávesy stále dostává i hra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Tastendruck wechselt die Sprache ohne Systemmenü. Dieselben Tasten erreichen weiterhin das Spiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every press switches language without the system menu. The same keys still reach the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pulsación cambia el idioma sin el menú del sistema. Las mismas teclas siguen llegando al juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appui change la langue sans menu système. Les mêmes touches continuent d’atteindre le jeu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दबाव पर सिस्टम मेनू के बिना भाषा बदलती है। वही कुंजियाँ गेम तक भी पहुँचती रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tekanan mengganti bahasa tanpa menu sistem. Tombol yang sama tetap diterima game."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pressione cambia lingua senza il menu di sistema. Gli stessi tasti continuano a raggiungere il gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押すたびにシステムメニューを開かずに言語を切り替えます。同じキーは引き続きゲームに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누를 때마다 시스템 메뉴 없이 언어가 바뀝니다. 같은 키는 계속 게임에 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke druk wisselt de taal zonder systeemmenu. Dezelfde toetsen blijven de game bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde naciśnięcie zmienia język bez menu systemowego. Te same klawisze nadal trafiają do gry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pressão troca o idioma sem o menu do sistema. As mesmas teclas continuam chegando ao jogo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare apăsare schimbă limba fără meniul sistemului. Aceleași taste ajung în continuare la joc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое нажатие сочетания меняет язык без системного меню. Те же клавиши продолжают поступать в игру."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje tryck byter språk utan systemmenyn. Samma tangenter når fortfarande spelet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่กดจะเปลี่ยนภาษาโดยไม่เปิดเมนูระบบ ปุ่มเดียวกันยังส่งถึงเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her basış, sistem menüsünü açmadan dili değiştirir. Aynı tuşlar oyuna ulaşmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне натискання поєднання змінює мову без системного меню. Ті самі клавіші продовжують надходити до гри."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần nhấn đổi ngôn ngữ mà không mở menu hệ thống. Các phím đó vẫn được gửi tới trò chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次按下都会切换语言，而不打开系统菜单。同样的按键仍会传给游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次按下都會切換語言，而不開啟系統選單。同樣的按鍵仍會傳給遊戲。"
          }
        }
      }
    },
