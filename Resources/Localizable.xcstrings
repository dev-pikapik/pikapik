    "pikapik wants to change the fan speed, turn services off and on, and add sharp sizes for monitors.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد pikapik تغيير سرعة المراوح وإيقاف الخدمات وتشغيلها وإضافة أحجام واضحة للشاشات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik chce měnit rychlost ventilátorů, vypínat a zapínat služby a přidávat ostré velikosti pro monitory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik möchte die Lüftergeschwindigkeit ändern, Dienste aus- und einschalten und Monitoren scharfe Größen hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik wants to change the fan speed, turn services off and on, and add sharp sizes for monitors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik quiere cambiar la velocidad de los ventiladores, desactivar y activar servicios y añadir tamaños nítidos para monitores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik souhaite changer la vitesse des ventilateurs, éteindre ou rallumer des services et ajouter des tailles nettes pour les écrans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik पंखे की गति बदलना, सेवाएँ बंद और चालू करना और मॉनिटर के लिए साफ़ साइज़ जोड़ना चाहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik ingin mengubah kecepatan kipas, mematikan dan menyalakan layanan, serta menambahkan ukuran tajam untuk monitor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik vuole cambiare la velocità delle ventole, spegnere e riaccendere i servizi e aggiungere dimensioni nitide per i monitor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik がファンの回転数の変更、サービスのオン/オフ、モニタにくっきり表示できるサイズの追加を行おうとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik이(가) 팬 속도를 바꾸고, 서비스를 끄거나 켜고, 모니터에 선명한 크기를 추가하려고 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik wil de ventilatorsnelheid wijzigen, diensten uit- en aanzetten en scherpe formaten voor monitors toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik chce zmienić prędkość wentylatorów, wyłączać i włączać usługi oraz dodać ostre rozmiary dla monitorów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pikapik quer mudar a velocidade das ventoinhas, desligar e ligar serviços e adicionar tamanhos nítidos para monitores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik vrea să schimbe viteza ventilatoarelor, să oprească și să pornească servicii și să adauge dimensiuni clare pentru monitoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik хочет менять скорость вентиляторов, выключать и включать службы и добавлять чёткие размеры для мониторов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik vill ändra fläkthastigheten, stänga av och slå på tjänster och lägga till skarpa storlekar för bildskärmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik ต้องการเปลี่ยนความเร็วพัดลม ปิดหรือเปิดบริการ และเพิ่มขนาดที่คมชัดสำหรับจอภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik fan hızını değiştirmek, hizmetleri kapatıp açmak ve monitörlere net boyutlar eklemek istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik хоче змінювати швидкість вентиляторів, вимикати й вмикати служби та додавати чіткі розміри для моніторів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik muốn đổi tốc độ quạt, tắt, bật dịch vụ và thêm kích thước sắc nét cho màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 想要更改风扇转速、关闭和开启服务，并为显示器添加清晰的尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik 想要更改風扇轉速、關閉和開啟服務，並為顯示器加入清晰的尺寸。"
          }
        }
      }
    },
    "pikapik wants to keep your Mac awake with the lid closed.": {
      "extractionState": "manual",
