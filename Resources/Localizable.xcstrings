    "Stays put while Reduce Motion is on.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى في مكانه ما دام «تقليل الحركة» قيد التشغيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
