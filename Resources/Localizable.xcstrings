            "value": "Zeit zum Strecken! Ich würde mitmachen, aber ich hab keine Arme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretch time! I’d join you, but I have no arms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hora de estirarse! Me apuntaría, pero no tengo brazos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est l’heure de s’étirer ! Je le ferais bien avec vous, mais je n’ai pas de bras."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रेचिंग का समय! मैं भी साथ देता, पर मेरे हाथ ही नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktunya peregangan! Aku mau ikut, tapi aku nggak punya tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È ora di sgranchirsi! Lo farei con te, ma non ho le braccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレッチの時間！一緒にやりたいけど、腕がないんです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트레칭 시간! 같이 하고 싶은데 저는 팔이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd om te rekken! Ik deed graag mee, maar ik heb geen armen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas się rozciągnąć! Zrobiłbym to z tobą, ale nie mam rąk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de alongar! Eu iria junto, mas não tenho braços."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E timpul să ne întindem! M-aș alătura, dar n-am mâini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пора размяться! Я бы с вами, но у меня нет рук."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dags att sträcka på sig! Jag hade hängt med, men jag har inga armar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้เวลายืดเส้นแล้ว! อยากทำด้วยนะ แต่ไม่มีแขน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esneme zamanı! Size katılırdım ama kollarım yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час розім’ятися! Я б із вами, але в мене немає рук."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ vươn vai rồi! Mình muốn tham gia lắm, mà mình không có tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该伸伸懒腰啦！我也想一起，可我没有胳膊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該伸展一下囉！我也想一起，可惜我沒有手。"
          }
        }
      }
    },
