    "Look out the window for 20 seconds. I’ll guard the screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر من النافذة لمدة 20 ثانية. سأحرس الشاشة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívejte se 20 sekund z okna. Já pohlídám obrazovku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau mal 20 Sekunden aus dem Fenster. Ich bewache den Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look out the window for 20 seconds. I’ll guard the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira por la ventana 20 segundos. Yo vigilo la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez par la fenêtre pendant 20 secondes. Je surveille l’écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "20 सेकंड खिड़की से बाहर देखिए। स्क्रीन की रखवाली मैं करूँगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat ke luar jendela selama 20 detik. Aku jaga layarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda fuori dalla finestra per 20 secondi. Io sorveglio lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "20秒だけ窓の外を見てみて。画面はぼくが見張っておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "20초만 창밖을 보십시오. 화면은 제가 지키겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk eens 20 seconden uit het raam. Ik bewaak het scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popatrz przez okno przez 20 sekund. Przypilnuję ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe pela janela por 20 segundos. Eu vigio a tela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitați-vă pe geam 20 de secunde. Eu păzesc ecranul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите в окно секунд двадцать. Я посторожу экран."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta ut genom fönstret i 20 sekunder. Jag vaktar skärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองออกไปนอกหน้าต่างสัก 20 วินาที เดี๋ยวเฝ้าหน้าจอให้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "20 saniye pencereden dışarı bakın. Ekranı ben beklerim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подивіться у вікно секунд двадцять. Я постережу екран."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn ra cửa sổ 20 giây nhé. Mình canh màn hình cho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看窗外 20 秒吧。屏幕我来守着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看窗外 20 秒吧。螢幕我來顧。"
          }
        }
      }
    },
