          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор всех окон не открывается"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översikten över alla fönster öppnas inte"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพรวมหน้าต่างทั้งหมดไม่เปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm pencerelerin görünümü açılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Огляд усіх вікон не відкривається"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ xem mọi cửa sổ không mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有窗口的总览不会打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有視窗的總覽不會打開"
          }
        }
      }
    },
