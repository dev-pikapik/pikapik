            "value": "Conserva la app y mueve sus datos, ajustes y archivos temporales a la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l’app et met ses données, réglages et fichiers temporaires à la Corbeille"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को रखता है और उसका डेटा, सेटिंग्ज़ और अस्थायी फ़ाइलें ट्रैश में ले जाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan app, lalu memindahkan data, pengaturan, dan file sementaranya ke Tong Sampah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene l’app e sposta nel Cestino i suoi dati, le impostazioni e i file temporanei"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは残し、データ・設定・一時ファイルをゴミ箱に移します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 그대로 두고 데이터, 설정, 임시 파일을 휴지통으로 옮깁니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt de app en verplaatst de gegevens, instellingen en tijdelijke bestanden naar de Prullenmand"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostawia aplikację i przenosi jej dane, ustawienia i pliki tymczasowe do Kosza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o app e move os dados, ajustes e arquivos temporários dele para o Lixo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează aplicația și mută datele, setările și fișierele ei temporare în Coș"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение остаётся, а его данные, настройки и временные файлы перемещаются в Корзину"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller appen och flyttar dess data, inställningar och tillfälliga filer till papperskorgen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บแอปไว้ และย้ายข้อมูล การตั้งค่า และไฟล์ชั่วคราวของแอปไปที่ถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı tutar; verilerini, ayarlarını ve geçici dosyalarını Çöp Sepeti’ne taşır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма лишається, а її дані, налаштування й тимчасові файли переміщуються в Смітник"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lại ứng dụng và chuyển dữ liệu, cài đặt và tệp tạm của nó vào Thùng rác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
