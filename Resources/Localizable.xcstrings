    "Add a game, and Game Mode turns on by itself while you play it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف لعبة، وسيعمل وضع الألعاب تلقائيًا أثناء لعبك بها"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte hru a herní režim se zapne sám, kdykoli ji hrajete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füg ein Spiel hinzu, dann schaltet sich der Spielmodus von selbst ein, während du es spielst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a game, and Game Mode turns on by itself while you play it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un juego y el modo de juego se activará solo mientras juegas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un jeu, et le Mode Jeu s’active tout seul pendant que vous y jouez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई गेम जोड़ें, और जब तक आप उसे खेलेंगे, गेम मोड अपने-आप चालू रहेगा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan game, dan Mode Game akan menyala sendiri selagi Anda memainkannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un gioco e la modalità gioco si attiverà da sola mentre ci giochi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームを追加すると、そのゲームをプレイしている間だけゲームモードが自動でオンになります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 추가하면 그 게임을 하는 동안 게임 모드가 저절로 켜집니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een game toe, dan gaat de gamemodus vanzelf aan terwijl je hem speelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj grę, a tryb gry włączy się sam, gdy w nią grasz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um jogo e o Modo Jogo liga sozinho enquanto você joga"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați un joc și Modul Joc pornește singur cât timp îl jucați"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте игру — и режим будет включаться сам, пока вы в неё играете"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett spel så slås spelläget på av sig självt medan du spelar det"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเกม แล้วโหมดเกมจะเปิดเองขณะที่คุณเล่นเกมนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oyun ekleyin; siz onu oynarken Oyun Modu kendiliğinden açılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте гру — і режим вмикатиметься сам, поки ви в неї граєте"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
