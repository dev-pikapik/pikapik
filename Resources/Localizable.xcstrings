    "Click and press new keys. Esc cancels, ⌫ brings back the usual keys.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر ثم اضغط المفاتيح الجديدة. Esc يلغي، و⌫ يعيد المفاتيح المعتادة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte a stiskněte nové klávesy. Esc zruší, ⌫ vrátí obvyklé klávesy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick hier und drück die neuen Tasten. Esc bricht ab, ⌫ holt die üblichen Tasten zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click and press new keys. Esc cancels, ⌫ brings back the usual keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic y pulsa las teclas nuevas. Esc cancela, ⌫ vuelve a las teclas de siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez, puis appuyez sur les nouvelles touches. Échap annule, ⌫ remet les touches habituelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिक करें और नई कुंजियाँ दबाएँ। Esc रद्द करता है, ⌫ सामान्य कुंजियाँ वापस लाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik lalu tekan tombol baru. Esc membatalkan, ⌫ mengembalikan tombol biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic e premi i nuovi tasti. Esc annulla, ⌫ rimette i tasti di sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして新しいキーを押します。Escでキャンセル、⌫でいつものキーに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭한 다음 새 키를 누르십시오. Esc는 취소, ⌫는 원래 키로 되돌립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik en druk op de nieuwe toetsen. Esc annuleert, ⌫ zet de gewone toetsen terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij i naciśnij nowe klawisze. Esc anuluje, ⌫ przywraca zwykłe klawisze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique e pressione as novas teclas. Esc cancela, ⌫ volta às teclas de sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic și apăsați tastele noi. Esc anulează, ⌫ aduce înapoi tastele obișnuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите сюда, а потом новые клавиши. Esc — отмена, ⌫ вернёт обычные клавиши."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka och tryck på de nya tangenterna. Esc avbryter, ⌫ tar tillbaka de vanliga tangenterna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกแล้วกดปุ่มใหม่ Esc ยกเลิก ⌫ กลับไปใช้ปุ่มเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıklayın ve yeni tuşlara basın. Esc vazgeçer, ⌫ alışılmış tuşları geri getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть сюди, а потім нові клавіші. Esc — скасувати, ⌫ поверне звичайні клавіші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào rồi nhấn phím mới. Esc để hủy, ⌫ để dùng lại phím quen thuộc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按后按下新的按键。Esc 取消，⌫ 恢复为常用按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下後按下新的按鍵。Esc 取消，⌫ 恢復為常用按鍵。"
          }
        }
      }
    },
    "Click only: a tap looks up the word": {
      "extractionState": "manual",
