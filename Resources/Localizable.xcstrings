    "Awards are counted only on this Mac. Nothing is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب الجوائز على هذا الـ Mac فقط. لا يُرسل أي شيء إلى أي مكان."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocenění se počítají jen v tomto Macu. Nic se nikam neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auszeichnungen werden nur auf diesem Mac gezählt. Nichts wird irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awards are counted only on this Mac. Nothing is sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los premios se cuentan solo en este Mac. No se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récompenses sont comptées uniquement sur ce Mac. Rien n’est envoyé nulle part."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरस्कार केवल इस Mac पर गिने जाते हैं। कुछ भी कहीं नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghargaan hanya dihitung di Mac ini. Tidak ada yang dikirim ke mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I premi vengono conteggiati solo su questo Mac. Non viene inviato nulla da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アワードはこのMacでのみ集計されます。どこにも何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상은 이 Mac에서만 집계됩니다. 어디로도 아무것도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderscheidingen worden alleen op deze Mac geteld. Er wordt nergens iets naartoe gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrody są liczone tylko na tym Macu. Nic nie jest nigdzie wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os prêmios são contados apenas neste Mac. Nada é enviado para lugar nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiile sunt numărate doar pe acest Mac. Nimic nu este trimis nicăieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Награды считаются только на этом Mac. Ничего никуда не отправляется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utmärkelser räknas bara på den här Mac-datorn. Inget skickas någonstans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รางวัลจะนับบน Mac เครื่องนี้เท่านั้น ไม่มีอะไรถูกส่งไปที่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödüller yalnızca bu Mac’te sayılır. Hiçbir yere hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
