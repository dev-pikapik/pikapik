    "pikapik Player shares the video you are playing with the AirPlay device you choose, only inside your local network.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشارك pikapik Player الفيديو الذي تشغّله مع جهاز AirPlay الذي تختاره، وذلك داخل شبكتك المحلية فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player sdílí přehrávané video se zařízením AirPlay, které vyberete, a to jen uvnitř vaší místní sítě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player gibt das Video, das du gerade abspielst, an das AirPlay-Gerät weiter, das du auswählst – nur innerhalb deines lokalen Netzwerks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player shares the video you are playing with the AirPlay device you choose, only inside your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player comparte el vídeo que estás reproduciendo con el dispositivo AirPlay que elijas, solo dentro de tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player partage la vidéo en cours de lecture avec l’appareil AirPlay que vous choisissez, uniquement au sein de votre réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player जो वीडियो आप चला रहे हैं उसे आपके चुने हुए AirPlay डिवाइस के साथ साझा करता है, केवल आपके स्थानीय नेटवर्क के भीतर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player membagikan video yang sedang Anda putar ke perangkat AirPlay yang Anda pilih, hanya di dalam jaringan lokal Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player condivide il video che stai riproducendo con il dispositivo AirPlay che scegli, solo all’interno della tua rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Playerは、再生中のビデオを、選んだAirPlayデバイスにだけ、ローカルネットワーク内で共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player는 재생 중인 비디오를 선택한 AirPlay 기기와 로컬 네트워크 안에서만 공유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player deelt de video die je afspeelt met het AirPlay-apparaat dat je kiest, alleen binnen je lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player udostępnia odtwarzane wideo wybranemu przez Ciebie urządzeniu AirPlay, tylko w Twojej sieci lokalnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pikapik Player compartilha o vídeo que você está reproduzindo com o dispositivo AirPlay que você escolher, somente dentro da sua rede local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player partajează videoclipul pe care îl redați cu dispozitivul AirPlay pe care îl alegeți, doar în interiorul rețelei dumneavoastră locale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player передаёт воспроизводимое видео на выбранное вами устройство AirPlay, только внутри вашей локальной сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player delar videon du spelar upp med den AirPlay-enhet du väljer, bara inom ditt lokala nätverk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player แชร์วิดีโอที่คุณกำลังเล่นไปยังอุปกรณ์ AirPlay ที่คุณเลือก ภายในเครือข่ายในบ้านของคุณเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player, oynattığınız videoyu seçtiğiniz AirPlay aygıtıyla yalnızca yerel ağınızın içinde paylaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player передає відео, яке ви відтворюєте, на вибраний вами пристрій AirPlay, лише в межах вашої локальної мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player chia sẻ video bạn đang phát với thiết bị AirPlay bạn chọn, chỉ trong mạng cục bộ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player 会把你正在播放的视频共享给你选择的 AirPlay 设备，仅限在你的本地网络内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik Player 會把你正在播放的影片分享給你選擇的 AirPlay 裝置，僅限在你的本地網路內。"
          }
        }
      }
    },
    "pikapik asks Finder to move apps to the Trash when macOS doesn’t let it do that itself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما لا يسمح macOS لـ pikapik بنقل التطبيقات إلى سلة المهملات بنفسه، يطلب pikapik من Finder نقلها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud macOS nedovolí aplikace do Koše přesunout přímo, požádá pikapik o přesun Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn macOS es pikapik nicht selbst erlaubt, Apps in den Papierkorb zu legen, bittet pikapik den Finder darum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik asks Finder to move apps to the Trash when macOS doesn’t let it do that itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando macOS no deja que pikapik lo haga por sí mismo, pikapik pide al Finder que mueva las apps a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand macOS ne laisse pas pikapik placer lui-même les apps dans la Corbeille, pikapik demande au Finder de le faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब macOS pikapik को ऐप्स ख़ुद ट्रैश में ले जाने की अनुमति नहीं देता, तब pikapik यह काम Finder से करवाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat macOS tidak mengizinkan pikapik memindahkannya sendiri, pikapik meminta Finder memindahkan app ke Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando macOS non permette a pikapik di farlo da solo, pikapik chiede al Finder di spostare le app nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が pikapik 自身での移動を許可しない場合、pikapik は Finder にアプリをゴミ箱へ移動するよう依頼します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 직접 이동하도록 허용하지 않으면 pikapik은(는) Finder에 앱을 휴지통으로 옮겨 달라고 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als macOS het pikapik niet zelf toestaat, vraagt pikapik aan Finder om apps naar de Prullenmand te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy macOS nie pozwala aplikacji pikapik zrobić tego samodzielnie, pikapik prosi Finder o przeniesienie aplikacji do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o macOS não deixa o pikapik fazer isso sozinho, o pikapik pede ao Finder que mova os apps para o Lixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când macOS nu îi permite lui pikapik să facă asta singur, pikapik îi cere lui Finder să mute aplicațiile în Coș."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если macOS не разрешает pikapik самому переместить приложение в Корзину, pikapik просит об этом Finder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När macOS inte låter pikapik göra det själv ber pikapik Finder att flytta appar till papperskorgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ macOS ไม่อนุญาตให้ pikapik ย้ายแอปไปที่ถังขยะเอง pikapik จะขอให้ Finder ทำแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS buna doğrudan izin vermediğinde pikapik, Finder’dan uygulamaları Çöp Sepeti’ne taşımasını ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо macOS не дозволяє pikapik самому перемістити програму до Смітника, pikapik просить про це Finder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi macOS không cho pikapik tự làm việc này, pikapik nhờ Finder chuyển ứng dụng vào Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 macOS 不允许 pikapik 自行将 App 移到废纸篓时，pikapik 会请求访达来完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 macOS 不允許 pikapik 自行將 App 移到垃圾桶時，pikapik 會請求 Finder 代為處理。"
          }
        }
      }
    },
    "pikapik can’t remove itself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع pikapik إزالة نفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik nemůže odebrat sám sebe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik kann sich nicht selbst entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pikapik can’t remove itself."
          }
        },
        "es": {
          "stringUnit": {
