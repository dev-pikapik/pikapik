    "Can’t open this image. It may be damaged or in a format macOS doesn’t support.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذه الصورة. قد يكون الملف تالفًا أو بتنسيق لا يدعمه macOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento obrázek nelze otevřít. Možná je poškozený nebo je ve formátu, který macOS nepodporuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild kann nicht geöffnet werden. Es ist möglicherweise beschädigt oder liegt in einem Format vor, das macOS nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t open this image. It may be damaged or in a format macOS doesn’t support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir esta imagen. Puede estar dañada o tener un formato que macOS no admite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir cette image. Elle est peut-être endommagée ou dans un format que macOS ne prend pas en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चित्र खोला नहीं जा सकता. फ़ाइल ख़राब हो सकती है या ऐसे फ़ॉर्मैट में हो सकती है जिसे macOS समर्थन नहीं देता."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar ini tidak dapat dibuka. File mungkin rusak atau dalam format yang tidak didukung macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire questa immagine. Potrebbe essere danneggiata o in un formato non supportato da macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を開けません。ファイルが破損しているか、macOSが対応していない形式の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지를 열 수 없습니다. 파일이 손상되었거나 macOS에서 지원하지 않는 형식일 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze afbeelding kan niet worden geopend. Het bestand is mogelijk beschadigd of heeft een indeling die macOS niet ondersteunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć tego obrazu. Plik może być uszkodzony lub mieć format, którego macOS nie obsługuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esta imagem. Ela pode estar danificada ou em um formato que o macOS não suporta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea nu poate fi deschisă. Poate fi deteriorată sau într-un format pe care macOS nu îl acceptă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся открыть эту картинку. Возможно, файл повреждён или macOS не поддерживает его формат."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att öppna bilden. Den kan vara skadad eller ha ett format som macOS inte stöder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดรูปภาพนี้ได้ ไฟล์อาจเสียหายหรืออยู่ในรูปแบบที่ macOS ไม่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu resim açılamıyor. Hasarlı olabilir veya macOS’un desteklemediği bir biçimde olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається відкрити це зображення. Можливо, файл пошкоджено або macOS не підтримує його формат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở hình ảnh này. Tệp có thể bị hỏng hoặc ở định dạng mà macOS không hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此图片。文件可能已损坏，或格式不受 macOS 支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開此圖片。檔案可能已損毀，或格式不受 macOS 支援。"
          }
        }
      }
    },
    "Can’t play this file. It may be damaged or in a format the player doesn’t support.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل هذا الملف. قد يكون تالفًا أو بصيغة لا يدعمها المشغّل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor se nepodařilo přehrát. Může být poškozený nebo ve formátu, který přehrávač nepodporuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann nicht abgespielt werden. Sie ist möglicherweise beschädigt oder liegt in einem Format vor, das der Player nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t play this file. It may be damaged or in a format the player doesn’t support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede reproducir este archivo. Puede que esté dañado o que tenga un formato que el reproductor no admite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce fichier. Il est peut-être endommagé ou dans un format que le lecteur ne prend pas en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल चलाई नहीं जा सकती। हो सकता है कि वह खराब हो या ऐसे फ़ॉर्मैट में हो जिसे प्लेयर समर्थन नहीं करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini tidak dapat diputar. File mungkin rusak atau berformat yang tidak didukung pemutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riprodurre questo file. Potrebbe essere danneggiato o in un formato che il lettore non supporta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを再生できません。ファイルが破損しているか、プレーヤーが対応していない形式の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 재생할 수 없습니다. 파일이 손상되었거나 플레이어가 지원하지 않는 포맷일 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kan niet worden afgespeeld. Het is mogelijk beschadigd of heeft een indeling die de speler niet ondersteunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odtworzyć tego pliku. Może być uszkodzony lub mieć format, którego odtwarzacz nie obsługuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reproduzir este arquivo. Ele pode estar danificado ou em um formato que o player não suporta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul nu poate fi redat. Poate fi deteriorat sau într-un format pe care playerul nu îl acceptă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся воспроизвести файл. Возможно, он повреждён или его формат не поддерживается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att spela upp filen. Den kan vara skadad eller ha ett format som spelaren inte stöder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นไฟล์นี้ไม่ได้ ไฟล์อาจเสียหายหรืออยู่ในรูปแบบที่เครื่องเล่นไม่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya oynatılamıyor. Dosya hasarlı olabilir veya oynatıcının desteklemediği bir biçimde olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається відтворити цей файл. Він може бути пошкоджений або мати формат, який програвач не підтримує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể phát tệp này. Tệp có thể bị hỏng hoặc có định dạng mà trình phát không hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放此文件。文件可能已损坏，或其格式不受播放器支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法播放此檔案。檔案可能已損毀，或其格式不受播放器支援。"
          }
        }
      }
    },
