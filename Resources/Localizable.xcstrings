    "Catch your pet in midair 5 times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك برفيقك في الهواء 5 مرات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chytněte mazlíčka ve vzduchu 5krát."
