    "Closing an app’s last window quits the app. Finder stays open.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق آخر نافذة لتطبيق يؤدي إلى إنهائه. يبقى Finder مفتوحًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavřením posledního okna se aplikace ukončí. Finder zůstane otevřený."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt du das letzte Fenster einer App, wird sie beendet. Der Finder bleibt offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing an app’s last window quits the app. Finder stays open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar la última ventana, la app se cierra. Finder sigue abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la dernière fenêtre d’une app la quitte. Le Finder reste ouvert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ऐप की आख़िरी विंडो बंद करने पर ऐप भी बंद हो जाता है। Finder खुला रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutup jendela terakhir app akan mengakhiri app tersebut. Finder tetap terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo l’ultima finestra, l’app si chiude. Il Finder resta aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの最後のウインドウを閉じるとアプリも終了します。Finderは終了しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 마지막 윈도우를 닫으면 앱이 종료됩니다. Finder는 계속 열려 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het laatste venster van een app sluit, stopt de app. Finder blijft open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie ostatniego okna aplikacji kończy jej działanie. Finder pozostaje otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao fechar a última janela, o app é encerrado. O Finder continua aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când închideți ultima fereastră a unei aplicații, aplicația se închide. Finder rămâne deschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыли последнее окно — приложение завершается. Finder остаётся открытым."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger en apps sista fönster avslutas appen. Finder förblir öppen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดหน้าต่างสุดท้ายของแอปจะออกจากแอปนั้น Finder ยังคงเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulamanın son penceresini kapatınca uygulamadan çıkılır. Finder açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрили останнє вікно — програма завершується. Finder лишається відкритим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng cửa sổ cuối cùng của ứng dụng sẽ thoát ứng dụng đó. Finder vẫn mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭应用的最后一个窗口时，应用会退出。访达保持打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 App 的最後一個視窗時會結束該 App。Finder 會保持打開。"
          }
        }
      }
    },
