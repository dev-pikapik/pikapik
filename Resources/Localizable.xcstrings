          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi nút đưa bạn đến một cài đặt hoạt ảnh trong Cài đặt hệ thống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按钮都会带你前往“系统设置”中的一项动画设置"
          }
