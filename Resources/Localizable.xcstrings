    "Lets the app change the fan speed, turn off background tasks for the whole Mac and add sharp sizes for monitors": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للتطبيق بتغيير سرعة المراوح وإيقاف المهام في الخلفية لجهاز Mac بالكامل وإضافة أحجام واضحة للشاشات"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikaci měnit rychlost ventilátorů, vypínat úlohy na pozadí pro celý Mac a přidávat ostré velikosti pro monitory"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit die App die Lüftergeschwindigkeit ändern, Hintergrundaufgaben für den ganzen Mac ausschalten und Monitoren scharfe Größen hinzufügen kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app change the fan speed, turn off background tasks for the whole Mac and add sharp sizes for monitors"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar la velocidad de los ventiladores, desactivar tareas en segundo plano de todo el Mac y añadir tamaños nítidos para monitores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer la vitesse des ventilateurs, désactiver des tâches en arrière-plan pour tout le Mac et ajouter des tailles nettes pour les écrans"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को पंखों की गति बदलने, पूरे Mac के लिए बैकग्राउंड टास्क बंद करने और मॉनिटर के लिए साफ़ साइज़ जोड़ने देता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan app mengubah kecepatan kipas, mematikan tugas latar belakang untuk seluruh Mac, dan menambahkan ukuran tajam untuk monitor"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cambiare la velocità delle ventole, disattivare le attività in background di tutto il Mac e aggiungere dimensioni nitide per i monitor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンの回転数を変更し、Mac 全体のバックグラウンドタスクをオフにし、モニタにくっきり表示できるサイズを追加するため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬 속도를 바꾸고, Mac 전체의 백그라운드 작업을 끄고, 모니터에 선명한 크기를 추가하는 데 필요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de app de ventilatorsnelheid wijzigen, achtergrondtaken voor de hele Mac uitzetten en scherpe formaten voor monitors toevoegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala aplikacji zmieniać prędkość wentylatorów, wyłączać zadania w tle dla całego Maca i dodawać ostre rozmiary dla monitorów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mudar a velocidade das ventoinhas, desligar tarefas em segundo plano do Mac inteiro e adicionar tamanhos nítidos para monitores"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aplicației să schimbe viteza ventilatoarelor, să oprească sarcinile din fundal pentru tot Mac-ul și să adauge dimensiuni clare pentru monitoare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы менять скорость вентиляторов, выключать фоновые задачи для всего Mac и добавлять чёткие размеры для мониторов"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter appen ändra fläkthastigheten, stänga av bakgrundsuppgifter för hela Macen och lägga till skarpa storlekar för bildskärmar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้แอปเปลี่ยนความเร็วพัดลม ปิดงานเบื้องหลังสำหรับทั้งเครื่อง Mac และเพิ่มขนาดที่คมชัดสำหรับจอภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın fan hızını değiştirmesini, tüm Mac için arka plan görevlerini kapatmasını ve monitörlere net boyutlar eklemesini sağlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінювати швидкість вентиляторів, вимикати фонові завдання для всього Mac і додавати чіткі розміри для моніторів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng đổi tốc độ quạt, tắt tác vụ nền cho cả máy Mac và thêm kích thước sắc nét cho màn hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于更改风扇转速、为整台 Mac 关闭后台任务，以及为显示器添加清晰的尺寸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於更改風扇轉速、為整台 Mac 關閉背景工作，以及為顯示器加入清晰的尺寸"
          }
        }
      }
    },
    "Lets the app find all of an app’s files, and permissions left by deleted apps": {
