    "Turns Do Not Disturb on or off.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل عدم الإزعاج أو يوقفه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíná nebo vypíná Nerušit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet Nicht stören ein oder aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns Do Not Disturb on or off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva No molestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive Ne pas déranger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परेशान न करें को चालू या बंद करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan atau mematikan Jangan Ganggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva Non disturbare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみモードをオンまたはオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해금지 모드를 켜거나 끕니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Niet storen aan of uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącza lub wyłącza Nie przeszkadzać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa Não Perturbe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează sau dezactivează Nu deranjați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает или выключает режим «Не беспокоить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår på eller av Stör ej."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหรือปิดห้ามรบกวน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsız Etme’yi açar veya kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Умикає або вимикає режим «Не турбувати»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt Không làm phiền."
          }
        },
        "zh-Hans": {
