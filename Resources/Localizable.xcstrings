    "If turned on now, stays on until you turn it off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لو شغّلته الآن، يبقى يعمل حتى توقفه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při zapnutí teď zůstane zapnuté, dokud ho nevypnete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt eingeschaltet, bleibt es an, bis du es ausschaltest"
