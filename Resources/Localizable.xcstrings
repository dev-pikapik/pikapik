            "state": "translated",
            "value": "すべてのウインドウの一覧が開かない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 윈도우 보기가 열리지 않음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het overzicht van alle vensters opent niet"
          }
        },
        "pl": {
