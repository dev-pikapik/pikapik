          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt an Ort und Stelle, solange „Bewegung reduzieren“ an ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stays put while Reduce Motion is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en su sitio mientras «Reducir movimiento» esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur place tant que « Réduire les animations » est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक “मोशन कम करें” चालू है, अपनी जगह पर ही रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap di tempat selama “Kurangi gerakan” menyala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta al suo posto finché «Riduci movimento» è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「視差効果を減らす」がオンの間は、その場から動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘동작 줄이기’가 켜져 있는 동안에는 제자리에 머무릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft op zijn plek zolang ‘Verminder beweging’ aanstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje na miejscu, dopóki opcja Ogranicz ruch jest włączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não sai do lugar enquanto Reduzir movimento estiver ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâne pe loc cât timp opțiunea Redu mișcarea e activată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся на месте, пока включено «Уменьшение движения»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stannar på plats medan Minska rörelse är på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่กับที่ขณะที่ “ลดการเคลื่อนไหว” เปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketi azalt seçeneği açıkken yerinde durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається на місці, поки ввімкнено «Зменшити рух»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở yên một chỗ khi Giảm chuyển động đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“减弱动态效果”打开时，它会待在原地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「減少動態效果」開啟時，它會待在原地。"
          }
        }
      }
    },
