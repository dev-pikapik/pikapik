    "Each wheel click scrolls the same distance, at any speed. Mouse only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل نقرة على العجلة تمرّر المسافة نفسها مهما كانت السرعة. للماوس فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé cvaknutí kolečka posune o stejnou vzdálenost, ať točíte jakkoli rychle. Jen pro myši."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Klick am Mausrad scrollt gleich weit, egal wie schnell. Nur für Mäuse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each wheel click scrolls the same distance, at any speed. Mouse only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada clic de la rueda desplaza la misma distancia, a cualquier velocidad. Solo para ratones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque cran de la molette fait défiler la même distance, quelle que soit la vitesse. Souris uniquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हील का हर क्लिक उतनी ही दूरी तक स्क्रॉल करता है, चाहे किसी भी गति से घुमाएँ। सिर्फ़ माउस के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap klik roda menggulir sejauh yang sama, secepat apa pun. Hanya untuk tetikus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scatto della rotellina scorre della stessa distanza, a qualsiasi velocità. Solo per mouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイールを1クリックするたびに、速さに関係なく同じ距離をスクロールします。マウス専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휠을 한 칸 돌릴 때마다 속도와 관계없이 같은 거리만큼 스크롤됩니다. 마우스 전용입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke klik van het wiel scrolt even ver, hoe snel je ook draait. Alleen voor muizen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde kliknięcie kółka przewija o tę samą odległość, bez względu na szybkość. Tylko dla myszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada clique da roda rola a mesma distância, não importa a velocidade. Só para mouse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare clic al rotiței derulează aceeași distanță, oricât de repede o învârtiți. Doar pentru mausuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый щелчок колёсика прокручивает на одно и то же расстояние, с любой скоростью. Только для мыши."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje klick på hjulet rullar lika långt, hur snabbt du än snurrar. Bara för möss."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การหมุนล้อทุกครั้งเลื่อนหน้าจอเท่ากัน ไม่ว่าจะหมุนเร็วแค่ไหน เฉพาะเมาส์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekerleğin her tıklaması, hızı ne olursa olsun aynı mesafe kaydırır. Yalnızca fareler için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен клік колеса прокручує на ту саму відстань, з будь-якою швидкістю. Лише для миші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần lăn con lăn cuộn cùng một quãng, dù nhanh hay chậm. Chỉ dành cho chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论转得多快，滚轮每转一格都滚动相同的距离。仅限鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論轉得多快，滾輪每轉一格都捲動相同的距離。僅適用於滑鼠。"
          }
        }
      }
    },
