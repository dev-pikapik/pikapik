    "Keeps the app and moves its data, settings and temporary files to the Trash": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي التطبيق وينقل بياناته وإعداداته وملفاته المؤقتة إلى سلة المهملات"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechá aplikaci a přesune její data, nastavení a dočasné soubory do Koše"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die App und legt ihre Daten, Einstellungen und temporären Dateien in den Papierkorb"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the app and moves its data, settings and temporary files to the Trash"
          }
        },
        "es": {
