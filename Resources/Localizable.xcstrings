    "Animations will be as they were before pikapik.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعود الرسوم المتحركة كما كانت قبل pikapik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animace budou jako před pikapik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Animationen sind wieder wie vor pikapik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animations will be as they were before pikapik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las animaciones volverán a ser como antes de pikapik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les animations redeviendront comme avant pikapik."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एनिमेशन वैसे ही हो जाएँगे जैसे pikapik से पहले थे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi akan kembali seperti sebelum pikapik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le animazioni torneranno come prima di pikapik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションはpikapikを使う前の状態に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애니메이션이 pikapik 사용 전으로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De animaties worden weer zoals vóór pikapik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animacje wrócą do stanu sprzed pikapik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As animações voltarão a ser como antes do pikapik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Animațiile vor fi din nou ca înainte de pikapik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимации станут такими, какими были до pikapik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Animationerna blir som före pikapik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพเคลื่อนไหวจะกลับไปเหมือนก่อนใช้ pikapik"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasyonlar pikapik’ten önceki hâline dönecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімації стануть такими, як були до pikapik."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt ảnh sẽ trở lại như trước khi dùng pikapik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画将恢复为使用 pikapik 之前的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動畫將恢復為使用 pikapik 之前的樣子。"
          }
        }
      }
    },
