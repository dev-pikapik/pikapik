    "How fast Finder moves to the next column in column view.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعة انتقال Finder إلى العمود التالي في عرض الأعمدة."
          }
        },
        "cs": {
