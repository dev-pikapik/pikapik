    },
    "The monitor didn’t stay at %@ and went back. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تبقَ الشاشة على %@ وعادت إلى حجمها السابق. حاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor nezůstal na %@ a vrátil se k předchozí velikosti. Zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Monitor ist nicht bei %@ geblieben und zur vorherigen Größe zurückgekehrt. Versuch es noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
