    "Press the chosen mouse button to hide the app in front, like ⌘H.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر الماوس الذي اخترته لإخفاء التطبيق الظاهر في المقدمة، مثل ⌘H."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte zvolené tlačítko myši a aplikace v popředí se skryje jako po ⌘H."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die gewählte Maustaste, um die App im Vordergrund auszublenden – wie mit ⌘H."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the chosen mouse button to hide the app in front, like ⌘H."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón del ratón elegido para ocultar la app que está en primer plano, como con ⌘H."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton choisi de la souris pour masquer l’app au premier plan, comme avec ⌘H."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामने वाले ऐप को छिपाने के लिए चुना हुआ माउस बटन दबाएँ, बिल्कुल ⌘H की तरह।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan tombol tetikus yang dipilih untuk menyembunyikan app yang sedang di depan, seperti ⌘H."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il tasto del mouse scelto per nascondere l’app in primo piano, come con ⌘H."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだマウスボタンを押すと、最前面のアプリが隠れます。⌘Hと同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 마우스 버튼을 누르면 맨 앞의 앱이 가려집니다. ⌘H와 같습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de gekozen muisknop om de app op de voorgrond te verbergen, net als met ⌘H."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij wybrany przycisk myszy, aby ukryć aplikację na pierwszym planie, jak skrótem ⌘H."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o botão do mouse escolhido para ocultar o app em primeiro plano, como com ⌘H."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați butonul ales al mausului ca să ascundeți aplicația din prim-plan, ca cu ⌘H."
