    "Nothing is using a door right now. That is normal.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستخدم أي برنامج أي باب الآن. وهذا طبيعي."
          }
        },
        "cs": {
          "stringUnit": {
