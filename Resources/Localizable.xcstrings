    "With ⇧ they select, with ⌘ they go to the start or end of the text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع ⇧ تحددان النص، ومع ⌘ تنتقلان إلى بداية النص أو نهايته"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S ⇧ vybírají, s ⌘ skočí na začátek nebo konec textu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ⇧ wählen sie aus, mit ⌘ springen sie an Anfang oder Ende des Textes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With ⇧ they select, with ⌘ they go to the start or end of the text"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ⇧ seleccionan, con ⌘ van al inicio o al final del texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ⇧ elles sélectionnent, avec ⌘ elles vont au début ou à la fin du texte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ के साथ ये चुनते हैं, ⌘ के साथ टेक्स्ट की शुरुआत या अंत पर जाते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan ⇧ untuk memilih, dengan ⌘ ke awal atau akhir teks"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ⇧ selezionano, con ⌘ vanno all’inizio o alla fine del testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧と一緒に押すと選択、⌘と一緒に押すとテキストの先頭や末尾へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧와 함께 누르면 선택, ⌘와 함께 누르면 텍스트의 처음이나 끝으로 이동"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met ⇧ selecteren ze, met ⌘ gaan ze naar het begin of einde van de tekst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z ⇧ zaznaczają, z ⌘ przechodzą na początek lub koniec tekstu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ⇧ selecionam, com ⌘ vão ao início ou ao fim do texto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu ⇧ selectează, cu ⌘ merg la începutul sau sfârșitul textului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С ⇧ выделяют, с ⌘ — к началу или концу текста"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ⇧ markerar de, med ⌘ går de till början eller slutet av texten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดพร้อม ⇧ เพื่อเลือก กดพร้อม ⌘ เพื่อไปต้นหรือท้ายข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⇧ ile seçer, ⌘ ile metnin başına veya sonuna gider"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З ⇧ виділяють, з ⌘ — до початку або кінця тексту"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kèm ⇧ để chọn, kèm ⌘ để đến đầu hoặc cuối văn bản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 时选择，按住 ⌘ 时跳到文本开头或末尾"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⇧ 時選取，按住 ⌘ 時跳到文字開頭或結尾"
          }
        }
      }
    },
