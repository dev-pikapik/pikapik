    "Hold the first key, tap the second": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط المفتاح الأول مطوّلًا واضغط الثاني"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte první klávesu, stiskněte druhou"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste Taste halten, zweite tippen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the first key, tap the second"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la primera tecla y pulsa la segunda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la première touche, appuyez sur la seconde"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली कुंजी दबाए रखें, दूसरी दबाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan tombol pertama, ketuk tombol kedua"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il primo tasto, premi il secondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ目のキーを押したまま、2つ目を押す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 키를 누른 채 두 번째 키를 누르기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de eerste toets ingedrukt, tik op de tweede"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj pierwszy klawisz, naciśnij drugi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a primeira tecla e toque na segunda"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsată prima tastă, apăsați-o pe a doua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте первую клавишу, нажмите вторую"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll första tangenten, tryck på den andra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มแรกค้างไว้ แล้วแตะปุ่มที่สอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk tuşu basılı tutun, ikinciye dokunun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте першу клавішу, натисніть другу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ phím đầu, nhấn phím thứ hai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住第一个键，轻按第二个键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住第一個鍵，輕按第二個鍵"
          }
        }
      }
    },
    "Hold ⌥ and tap ⇧: next language. Hold ⇧ and tap ⌥: previous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على ⌥ واضغط ⇧: اللغة التالية. اضغط مع الاستمرار على ⇧ واضغط ⌥: السابقة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte ⌥ a stiskněte ⇧: další jazyk. Podržte ⇧ a stiskněte ⌥: předchozí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ halten und ⇧ tippen: nächste Sprache. ⇧ halten und ⌥ tippen: vorherige"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌥ and tap ⇧: next language. Hold ⇧ and tap ⌥: previous"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌥ y pulsa ⇧: idioma siguiente. Mantén ⇧ y pulsa ⌥: anterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ et appuyez sur ⇧ : langue suivante. Maintenez ⇧ et appuyez sur ⌥ : précédente"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ दबाए रखें और ⇧ दबाएँ: अगली भाषा। ⇧ दबाए रखें और ⌥ दबाएँ: पिछली"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan ⌥ dan ketuk ⇧: bahasa berikutnya. Tahan ⇧ dan ketuk ⌥: sebelumnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌥ e premi ⇧: lingua successiva. Tieni premuto ⇧ e premi ⌥: precedente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ を押したまま ⇧ を押すと次の言語、⇧ を押したまま ⌥ を押すと前の言語"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥를 누른 채 ⇧를 누르면 다음 언어, ⇧를 누른 채 ⌥를 누르면 이전 언어"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ⌥ ingedrukt en tik op ⇧: volgende taal. Houd ⇧ ingedrukt en tik op ⌥: vorige"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj ⌥ i naciśnij ⇧: następny język. Przytrzymaj ⇧ i naciśnij ⌥: poprzedni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌥ e toque em ⇧: próximo idioma. Segure ⇧ e toque em ⌥: anterior"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți ⌥ și apăsați ⇧: limba următoare. Țineți ⇧ și apăsați ⌥: cea anterioară"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите ⌥ и нажимайте ⇧ — следующий язык. Держите ⇧ и нажимайте ⌥ — предыдущий"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned ⌥ och tryck på ⇧: nästa språk. Håll ned ⇧ och tryck på ⌥: föregående"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด ⌥ ค้างไว้แล้วแตะ ⇧: ภาษาถัดไป กด ⇧ ค้างไว้แล้วแตะ ⌥: ภาษาก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ basılıyken ⇧ tuşuna basın: sonraki dil. ⇧ basılıyken ⌥ tuşuna basın: önceki dil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте ⌥ і натискайте ⇧ — наступна мова. Тримайте ⇧ і натискайте ⌥ — попередня"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ ⌥ và nhấn ⇧: ngôn ngữ tiếp theo. Giữ ⇧ và nhấn ⌥: ngôn ngữ trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 再按 ⇧：下一种语言。按住 ⇧ 再按 ⌥：上一种语言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 再按 ⇧：下一個語言。按住 ⇧ 再按 ⌥：上一個語言"
          }
        }
      }
    },
    "Holding a key repeats it instead of opening the accent menu. Restart open apps to apply.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضغط المطوّل على مفتاح يكرّره بدل فتح قائمة التشكيل. أعد تشغيل التطبيقات المفتوحة ليسري ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržení klávesy ji opakuje místo nabídky akcentů. Otevřené aplikace restartujte, aby se změna projevila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gehaltene Taste wiederholt sich, statt das Akzentmenü zu öffnen. Offene Apps zum Übernehmen neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding a key repeats it instead of opening the accent menu. Restart open apps to apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener una tecla la repite en lugar de abrir el menú de acentos. Reinicia las apps abiertas para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir une touche la répète au lieu d’ouvrir le menu des accents. Redémarre les apps ouvertes pour l’appliquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी दबाए रखने पर वह एक्सेंट मेनू खोलने की जगह बार-बार टाइप होती है। लागू करने के लिए खुले ऐप्स को रीस्टार्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan tombol akan mengulangnya, bukan membuka menu aksen. Mulai ulang app yang terbuka agar berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere premuto un tasto lo ripete invece di aprire il menu degli accenti. Riavvia le app aperte per applicarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押し続けると、アクセントメニューを開かずに文字が繰り返されます。開いているアプリは再起動すると反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누르고 있으면 악센트 메뉴 대신 글자가 반복 입력됩니다. 열려 있는 앱은 다시 시작해야 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ingedrukte toets herhaalt zich in plaats van het accentmenu te openen. Start open apps opnieuw op om het toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymany klawisz powtarza się zamiast otwierać menu akcentów. Uruchom ponownie otwarte aplikacje, aby zastosować zmianę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar uma tecla a repete em vez de abrir o menu de acentos. Reinicie os apps abertos para aplicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ținând apăsată o tastă, aceasta se repetă în loc să deschidă meniul cu accente. Reporniți aplicațiile deschise ca să se aplice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживаемая клавиша повторяется вместо меню с вариантами букв. Чтобы это заработало, перезапустите открытые приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En nedhållen tangent upprepas i stället för att öppna accentmenyn. Starta om öppna appar för att det ska gälla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดแป้นค้างไว้จะพิมพ์ซ้ำ แทนการเปิดเมนูเครื่องหมาย รีสตาร์ตแอปที่เปิดอยู่เพื่อให้มีผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tuşu basılı tutmak, aksan menüsünü açmak yerine onu tekrarlar. Uygulamak için açık uygulamaları yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримувана клавіша повторюється замість меню з акцентами. Перезапустіть відкриті програми, щоб зміна подіяла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một phím sẽ lặp lại phím đó thay vì mở menu dấu. Khởi động lại các app đang mở để áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按键会重复输入，而不是弹出重音菜单。已打开的 App 需重新启动后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住按鍵會重複輸入，而不是彈出重音選單。已打開的 App 需重新啟動後生效。"
          }
        }
      }
    },
    "Home and End go to the start and end of a line": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Home وEnd إلى بداية السطر ونهايته"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Home a End na začátek a konec řádku"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home und End springen an Zeilenanfang und -ende"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home and End go to the start and end of a line"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home y End van al inicio y al final de la línea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home et End vont au début et à la fin de la ligne"
          }
        },
        "hi": {
