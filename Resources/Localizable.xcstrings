    "Remove an app and its files, and put them back any time before you empty the Trash": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزل تطبيقًا مع ملفاته، وأعدها متى شئت قبل أن تُفرغ سلة المهملات"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeberte aplikaci s jejími soubory a vraťte je kdykoli, než vysypete Koš"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App samt Dateien entfernen und jederzeit zurücklegen, bis du den Papierkorb leerst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove an app and its files, and put them back any time before you empty the Trash"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una app y sus archivos, y devuélvelos cuando quieras mientras no vacíes la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez une app et ses fichiers, et remettez-les quand vous voulez tant que la Corbeille n’est pas vidée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप और उसकी फ़ाइलें हटाएँ, और ट्रैश ख़ाली करने से पहले कभी भी वापस रख दें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus app beserta filenya, lalu kembalikan kapan saja sebelum Anda mengosongkan Tong Sampah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi un’app e i suoi file, e rimettili a posto quando vuoi finché non svuoti il Cestino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリとそのファイルを削除し、ゴミ箱を空にするまではいつでも元に戻せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 앱의 파일을 제거하고, 휴지통을 비우기 전까지 언제든 되돌릴 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder een app met alle bestanden en zet ze terug wanneer je wilt, tot je de Prullenmand leegmaakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń aplikację z plikami i przywróć je w dowolnej chwili, zanim opróżnisz Kosz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova um app e seus arquivos e devolva tudo quando quiser, até esvaziar o Lixo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminați o aplicație și fișierele ei și puneți-le la loc oricând, până goliți Coșul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите приложение и его файлы — их можно вернуть, пока Корзина не очищена"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort en app med filer och lägg tillbaka allt när du vill, tills du tömmer papperskorgen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแอปและไฟล์ของแอป และเอากลับคืนได้ทุกเมื่อจนกว่าจะล้างถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı dosyalarıyla kaldırın, Çöp Sepeti’ni boşaltana kadar istediğiniz zaman geri koyun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаліть програму та її файли — їх можна повернути, доки Смітник не очищено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ ứng dụng cùng các tệp của nó, và hoàn lại bất cứ lúc nào trước khi bạn dọn sạch Thùng rác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 App 及其文件，在清倒废纸篓之前随时可以放回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 App 及其檔案，在清空垃圾桶之前隨時可以放回"
          }
        }
      }
    },
    "Remove the permissions of all deleted apps?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة أذونات كل التطبيقات المحذوفة؟"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit oprávnění všech smazaných aplikací?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen aller gelöschten Apps entfernen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the permissions of all deleted apps?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar los permisos de todas las apps eliminadas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les autorisations de toutes les apps supprimées ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी डिलीट किए गए ऐप्स की अनुमतियाँ हटाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus izin semua app yang dihapus?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere i permessi di tutte le app eliminate?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したすべてのアプリのアクセス許可を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제한 모든 앱의 권한을 제거하겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toestemmingen van alle verwijderde apps verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć uprawnienia wszystkich usuniętych aplikacji?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover as permissões de todos os apps apagados?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminați permisiunile tuturor aplicațiilor șterse?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить разрешения всех удалённых приложений?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort behörigheterna för alla raderade appar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาสิทธิ์ของแอปที่ลบไปแล้วทั้งหมดออกใช่ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen tüm uygulamaların izinleri kaldırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити дозволи всіх видалених програм?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa quyền của mọi ứng dụng đã xóa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除所有已删除 App 的权限吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除所有已刪除 App 的權限嗎？"
          }
        }
      }
    },
