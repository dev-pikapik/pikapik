        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存此影格。"
          }
        }
      }
    },
    "Couldn’t turn this back on. Try again or use System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إعادة تشغيله. حاول مرة أخرى أو استخدم إعدادات النظام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se to znovu zapnout. Zkuste to znovu nebo použijte Nastavení systému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiedereinschalten hat nicht geklappt. Versuche es erneut oder nutze die Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t turn this back on. Try again or use System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo volver a encender. Inténtalo de nuevo o usa Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de le rallumer. Réessayez ou utilisez Réglages Système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे फिर से चालू नहीं किया जा सका। फिर से कोशिश करें या सिस्टम सेटिंग का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyalakannya lagi. Coba lagi atau gunakan Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riaccenderlo. Riprova o usa Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンに戻せませんでした。もう一度試すか、システム設定を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 켤 수 없었습니다. 다시 시도하거나 시스템 설정을 사용해 주십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weer aanzetten is niet gelukt. Probeer het opnieuw of gebruik Systeeminstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się tego włączyć ponownie. Spróbuj ponownie lub użyj Ustawień systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível religar. Tente de novo ou use Ajustes do Sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut porni din nou. Încercați din nou sau folosiți Configurări sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось снова включить. Попробуйте ещё раз или воспользуйтесь Системными настройками."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att slå på igen. Försök igen eller använd Systeminställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดกลับไม่สำเร็จ ลองอีกครั้งหรือใช้การตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden açılamadı. Tekrar dene ya da Sistem Ayarları’nı kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося повернути. Спробуйте ще раз або скористайтеся Системними параметрами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bật lại mục này. Hãy thử lại hoặc dùng Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新打开。请重试，或使用“系统设置”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新打開。請重試，或使用「系統設定」。"
          }
        }
      }
    },
