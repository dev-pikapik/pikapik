            "state": "translated",
            "value": "HomeとEndで行頭と行末へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Home과 End로 줄의 처음과 끝으로 이동"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Home en End naar begin en einde van de regel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Home i End na początek i koniec wiersza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Home e End vão ao início e ao fim da linha"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Home și End la începutul și sfârșitul rândului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Home и End — к началу и концу строки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Home och End till början och slutet av raden"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Home และ End ไปต้นและท้ายบรรทัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home ve End satır başına ve sonuna gider"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Home і End — до початку й кінця рядка"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Home và End đến đầu và cuối dòng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Home 和 End 跳到行首和行尾"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Home 和 End 跳到行首和行尾"
          }
        }
      }
    },
