    "In Finder, %@ cuts the selected files and ⌘V moves them into the folder you paste in. ⌘C cancels the cut.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Finder، يقصّ %@ الملفات المحددة، ثم ينقلها ⌘V إلى المجلد الذي تلصق فيه. ⌘C يلغي القص."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Finderu %@ vyjme vybrané soubory a ⌘V je přesune do složky, do které vkládáte. ⌘C vyjmutí zruší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Finder schneidet %@ die ausgewählten Dateien aus, und ⌘V verschiebt sie in den Ordner, in dem du einfügst. ⌘C bricht das Ausschneiden ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, %@ cuts the selected files and ⌘V moves them into the folder you paste in. ⌘C cancels the cut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Finder, %@ corta los archivos seleccionados y ⌘V los mueve a la carpeta donde pegas. ⌘C cancela el corte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Finder, %@ coupe les fichiers sélectionnés et ⌘V les déplace dans le dossier où vous collez. ⌘C annule la coupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder में %@ चुनी हुई फ़ाइलें कट करता है, और ⌘V उन्हें उस फ़ोल्डर में ले जाता है जिसमें आप पेस्ट करते हैं। ⌘C कट को रद्द कर देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Finder, %@ memotong file yang dipilih, lalu ⌘V memindahkannya ke folder tempat file ditempel. ⌘C membatalkan pemotongan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel Finder, %@ taglia i file selezionati e ⌘V li sposta nella cartella in cui incolli. ⌘C annulla il taglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで%@を押すと選択中のファイルを切り取り、⌘Vで貼り付け先のフォルダへ移動します。⌘Cで切り取りを取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 %@는 선택한 파일을 잘라내고, ⌘V는 붙여넣는 폴더로 옮깁니다. ⌘C를 누르면 잘라내기가 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de Finder knipt %@ de geselecteerde bestanden en verplaatst ⌘V ze naar de map waarin je plakt. ⌘C annuleert het knippen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Finderze %@ wycina zaznaczone pliki, a ⌘V przenosi je do folderu, w którym wklejasz. ⌘C anuluje wycinanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Finder, %@ corta os arquivos selecionados e ⌘V os move para a pasta em que você cola. ⌘C cancela o corte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Finder, %@ decupează fișierele selectate, iar ⌘V le mută în folderul în care le lipiți. ⌘C anulează decuparea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Finder %@ вырезает выделенные файлы, а ⌘V переносит их в папку, куда вы вставляете. ⌘C отменяет вырезание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Finder klipper %@ ut de markerade filerna, och ⌘V flyttar dem till mappen där du klistrar in. ⌘C avbryter utklippningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Finder %@ จะตัดไฟล์ที่เลือก และ ⌘V จะย้ายไฟล์ไปยังโฟลเดอร์ที่วาง ส่วน ⌘C จะยกเลิกการตัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’da %@ seçili dosyaları keser, ⌘V ise onları yapıştırdığınız klasöre taşır. ⌘C kesmeyi iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Finder %@ вирізає виділені файли, а ⌘V переносить їх до папки, куди ви вставляєте. ⌘C скасовує вирізання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Finder, %@ cắt các tệp đã chọn và ⌘V chuyển chúng vào thư mục bạn dán. ⌘C hủy thao tác cắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中，%@ 剪切所选文件，⌘V 把它们移动到粘贴所在的文件夹。⌘C 可取消剪切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中，%@ 會剪下所選檔案，⌘V 會把它們移到貼上的檔案夾。⌘C 可取消剪下。"
          }
        }
      }
    },
    "In Finder, Return and Enter open the selected files, and F2 or fn F2 renames them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Finder، يفتح Return وEnter الملفات المحددة، ويعيد F2 أو fn F2 تسميتها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Finderu klávesy Return a Enter otevřou vybrané soubory a F2 nebo fn F2 je přejmenuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Finder öffnen Return und Enter die ausgewählten Dateien, und F2 oder fn F2 benennt sie um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, Return and Enter open the selected files, and F2 or fn F2 renames them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Finder, Retorno e Intro abren los archivos seleccionados, y F2 o fn F2 los renombra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Finder, Retour et Entrée ouvrent les fichiers sélectionnés, et F2 ou fn F2 les renomme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder में Return और Enter चुनी हुई फ़ाइलें खोलते हैं, और F2 या fn F2 उनका नाम बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Finder, Return dan Enter membuka file yang dipilih, dan F2 atau fn F2 mengganti namanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel Finder, Invio ed Enter aprono i file selezionati e F2 o fn F2 li rinomina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで、ReturnキーまたはEnterキーを押すと選択中のファイルを開き、F2またはfn F2で名前を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 Return과 Enter는 선택한 파일을 열고, F2 또는 fn F2는 이름을 바꿉니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de Finder openen Return en Enter de geselecteerde bestanden en wijzigt F2 of fn F2 de naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Finderze klawisze Return i Enter otwierają zaznaczone pliki, a F2 lub fn F2 zmienia ich nazwę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Finder, Return e Enter abrem os arquivos selecionados, e F2 ou fn F2 renomeia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Finder, Return și Enter deschid fișierele selectate, iar F2 sau fn F2 le redenumește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Finder клавиши Return и Enter открывают выделенные файлы, а F2 или fn F2 переименовывает их."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Finder öppnar Return och Enter de markerade filerna, och F2 eller fn F2 byter namn på dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Finder ปุ่ม Return และ Enter จะเปิดไฟล์ที่เลือก ส่วน F2 หรือ fn F2 จะเปลี่ยนชื่อไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’da Return ve Enter seçili dosyaları açar, F2 veya fn F2 ise adlarını değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Finder клавіші Return і Enter відкривають виділені файли, а F2 або fn F2 перейменовує їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Finder, Return và Enter mở các tệp đã chọn, còn F2 hoặc fn F2 đổi tên chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中，按 Return 或 Enter 可打开所选文件，按 F2 或 fn F2 可重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中，按 Return 或 Enter 會打開所選檔案，按 F2 或 fn F2 則重新命名。"
          }
        }
      }
    },
    "In Finder, ⌫ and ⌦ (fn ⌫ on a laptop) move the selected files to the Trash, like ⌘⌫. While you type a name or search, they erase letters as usual.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Finder، ينقل ⌫ و⌦ (fn ⌫ في الحاسوب المحمول) الملفات المحددة إلى سلة المهملات، كما يفعل ⌘⌫. أثناء كتابة اسم أو البحث، يمحوان الحروف كالمعتاد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve Finderu ⌫ a ⌦ (fn ⌫ na notebooku) přesunou vybrané soubory do Koše, stejně jako ⌘⌫. Když píšete název nebo hledáte, mažou písmena jako obvykle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Finder legen ⌫ und ⌦ (fn ⌫ am Laptop) die ausgewählten Dateien in den Papierkorb, wie ⌘⌫. Während du einen Namen tippst oder suchst, löschen sie wie gewohnt Buchstaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder, ⌫ and ⌦ (fn ⌫ on a laptop) move the selected files to the Trash, like ⌘⌫. While you type a name or search, they erase letters as usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Finder, ⌫ y ⌦ (fn ⌫ en un portátil) mueven los archivos seleccionados a la Papelera, como ⌘⌫. Mientras escribes un nombre o buscas, borran letras como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Finder, ⌫ et ⌦ (fn ⌫ sur un portable) placent les fichiers sélectionnés dans la Corbeille, comme ⌘⌫. Quand vous tapez un nom ou une recherche, elles effacent les lettres comme d’habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder में ⌫ और ⌦ (लैपटॉप पर fn ⌫) चुनी हुई फ़ाइलों को ट्रैश में ले जाते हैं, ⌘⌫ की तरह। जब आप नाम टाइप कर रहे हों या खोज रहे हों, तो ये पहले की तरह अक्षर मिटाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Finder, ⌫ dan ⌦ (fn ⌫ di laptop) memindahkan file yang dipilih ke Tong Sampah, seperti ⌘⌫. Saat Anda mengetik nama atau mencari, keduanya menghapus huruf seperti biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel Finder, ⌫ e ⌦ (fn ⌫ su un portatile) spostano i file selezionati nel Cestino, come ⌘⌫. Mentre scrivi un nome o cerchi, cancellano le lettere come al solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderで⌫または⌦（ノートパソコンではfn ⌫）を押すと、⌘⌫と同じように選択中のファイルをゴミ箱に入れます。名前の入力中や検索中は、通常どおり文字を消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 ⌫와 ⌦(노트북에서는 fn ⌫)를 누르면 ⌘⌫처럼 선택한 파일이 휴지통으로 이동합니다. 이름을 입력하거나 검색하는 동안에는 평소대로 글자를 지웁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de Finder verplaatsen ⌫ en ⌦ (fn ⌫ op een laptop) de geselecteerde bestanden naar de Prullenmand, zoals ⌘⌫. Terwijl je een naam typt of zoekt, wissen ze gewoon letters."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Finderze ⌫ i ⌦ (fn ⌫ na laptopie) przenoszą zaznaczone pliki do Kosza, tak jak ⌘⌫. Gdy wpisujesz nazwę lub szukasz, kasują litery jak zwykle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Finder, ⌫ e ⌦ (fn ⌫ no notebook) movem os arquivos selecionados para o Lixo, como ⌘⌫. Enquanto você digita um nome ou pesquisa, elas apagam letras como sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Finder, ⌫ și ⌦ (fn ⌫ pe laptop) mută fișierele selectate în Coș, ca ⌘⌫. Cât timp scrieți un nume sau căutați, șterg literele ca de obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Finder клавиши ⌫ и ⌦ (fn ⌫ на ноутбуке) отправляют выделенные файлы в Корзину, как ⌘⌫. Пока вы вводите имя или ищете, они стирают буквы как обычно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Finder flyttar ⌫ och ⌦ (fn ⌫ på en bärbar dator) de markerade filerna till papperskorgen, som ⌘⌫. Medan du skriver ett namn eller söker raderar de bokstäver som vanligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Finder ปุ่ม ⌫ และ ⌦ (fn ⌫ บนแล็ปท็อป) จะย้ายไฟล์ที่เลือกไปที่ถังขยะ เหมือน ⌘⌫ ขณะพิมพ์ชื่อหรือค้นหา ปุ่มจะลบตัวอักษรตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’da ⌫ ve ⌦ (dizüstünde fn ⌫), seçili dosyaları ⌘⌫ gibi Çöp Sepeti’ne taşır. Bir ad yazarken veya arama yaparken her zamanki gibi harf siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Finder клавіші ⌫ і ⌦ (fn ⌫ на ноутбуці) переносять виділені файли у Смітник, як ⌘⌫. Поки ви вводите назву чи шукаєте, вони стирають літери як зазвичай."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Finder, ⌫ và ⌦ (fn ⌫ trên máy tính xách tay) chuyển các tệp đã chọn vào Thùng rác, giống ⌘⌫. Khi bạn đang gõ tên hoặc tìm kiếm, chúng xóa chữ như bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中，⌫ 和 ⌦（笔记本电脑上为 fn ⌫）会把所选文件移到废纸篓，和 ⌘⌫ 一样。输入名称或搜索时，它们照常删除文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中，⌫ 和 ⌦（筆電上為 fn ⌫）會把所選檔案移到垃圾桶，和 ⌘⌫ 一樣。輸入名稱或搜尋時，它們照常刪除文字。"
          }
        }
      }
    },
    "In System Settings › Displays you’ll see one more screen, “%@”: that’s how pikapik makes everything larger, and you don’t need to do anything with it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر في إعدادات النظام › شاشات العرض شاشة إضافية باسم «%@»: هكذا يعرض pikapik الصورة المكبّرة، ولا حاجة إلى فعل أي شيء بها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavení systému › Monitory uvidíte ještě jednu obrazovku, „%@“: takto pikapik zobrazuje zvětšený obraz a nemusíte s ní nic dělat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Systemeinstellungen › Displays siehst du einen weiteren Bildschirm, „%@“: So zeigt pikapik das größere Bild, und du musst damit nichts tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings › Displays you’ll see one more screen, “%@”: that’s how pikapik makes everything larger, and you don’t need to do anything with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema › Pantallas verás una pantalla más, «%@»: así es como pikapik muestra la imagen más grande, y no tienes que hacer nada con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système › Moniteurs, vous verrez un écran de plus, « %@ » : c’est ainsi que pikapik affiche l’image agrandie, et vous n’avez rien à faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग › डिस्प्ले में आपको एक और स्क्रीन “%@” दिखेगी: pikapik इसी तरह सब कुछ बड़ा करता है, और आपको इसके साथ कुछ करने की ज़रूरत नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Pengaturan Sistem › Layar, Anda akan melihat satu layar lagi, “%@”: begitulah cara pikapik menampilkan gambar yang lebih besar, dan Anda tidak perlu melakukan apa pun dengannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni di Sistema › Schermi vedrai uno schermo in più, «%@»: è così che pikapik mostra l’immagine più grande, e non devi farci nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › ディスプレイには画面「%@」も表示されますが、これはpikapikが拡大表示するためのもので、何もする必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 디스플레이에 ‘%@’ 화면이 하나 더 표시되는데, pikapik이 화면을 크게 보여 주는 방식이므로 아무것도 하지 않아도 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Systeeminstellingen › Beeldschermen zie je nog een scherm, ‘%@’: zo toont pikapik het grotere beeld, en je hoeft er niets mee te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Ustawieniach systemowych › Wyświetlacze zobaczysz jeszcze jeden ekran, „%@”: tak pikapik pokazuje powiększony obraz i nie musisz nic z nim robić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes do Sistema › Telas, você verá mais uma tela, “%@”: é assim que o pikapik mostra a imagem maior, e não é preciso fazer nada com ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Configurări sistem › Afișaje veți vedea încă un ecran, „%@”: așa afișează pikapik imaginea mărită și nu trebuie să faceți nimic cu el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Системных настройках › Дисплеи вы увидите ещё один экран, «%@»: так pikapik показывает увеличенное изображение, и делать с ним ничего не нужно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Systeminställningar › Bildskärmar ser du ytterligare en skärm, ”%@”: så gör pikapik allt större, och du behöver inte göra något med den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการตั้งค่าระบบ › จอภาพ คุณจะเห็นหน้าจอเพิ่มขึ้นอีกหนึ่งจอชื่อ “%@” ซึ่งเป็นวิธีที่ pikapik ใช้แสดงภาพให้ใหญ่ขึ้น คุณไม่ต้องทำอะไรกับหน้าจอนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları › Ekranlar’da “%@” adlı bir ekran daha göreceksiniz: pikapik büyütülmüş görüntüyü bu şekilde gösterir ve onunla ilgili bir şey yapmanız gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Системних параметрах › Дисплеї ви побачите ще один екран, «%@»: так pikapik показує збільшене зображення, і робити з ним нічого не потрібно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Cài đặt hệ thống › Màn hình, bạn sẽ thấy thêm một màn hình “%@”: đây là cách pikapik hiển thị hình ảnh lớn hơn, và bạn không cần làm gì với nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置” › “显示器”中会多出一个屏幕“%@”：pikapik 正是通过它显示放大的画面，你无需对它进行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」›「顯示器」中會多出一個螢幕「%@」：pikapik 就是透過它顯示放大的畫面，你不需要對它做任何事。"
          }
        }
      }
    },
    "In System Settings, click “%@”, then “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في إعدادات النظام، انقر على «%@»، ثم على «%@»."
