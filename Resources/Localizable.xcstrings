        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, виберіть домашню папку «%@»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tiếp tục, hãy chọn thư mục chính “%@” của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要继续，请选择你的个人文件夹“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要繼續，請選擇你的個人檔案夾「%@」。"
          }
        }
      }
    },
    "To count frames, allow “%@”. No picture is kept or sent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعدّ الإطارات، اسمح بـ «%@». لا يتم حفظ أي صورة ولا إرسالها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro počítání snímků povolte „%@“. Obraz se neukládá ani neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Bilder zu zählen, erlaube „%@“. Es wird kein Bild gespeichert oder gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To count frames, allow “%@”. No picture is kept or sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para contar los fotogramas, permite «%@». No se guarda ni se envía ninguna imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour compter les images, autorisez « %@ ». Aucune image n’est conservée ni envoyée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेम गिनने के लिए “%@” की अनुमति दें। कोई तस्वीर सेव या कहीं भेजी नहीं जाती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menghitung frame, izinkan “%@”. Tidak ada gambar yang disimpan atau dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per contare i fotogrammi, consenti “%@”. Nessuna immagine viene salvata o inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームを数えるには、「%@」を許可してください。画像は保存も送信もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임을 세려면 “%@”을(를) 허용하십시오. 화면은 저장되거나 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta “%@” toe om frames te tellen. Er wordt geen beeld bewaard of verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby liczyć klatki, zezwól na „%@”. Obraz nie jest zapisywany ani wysyłany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para contar os quadros, permita “%@”. Nenhuma imagem é guardada nem enviada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a număra cadrele, permiteți „%@”. Nicio imagine nu este păstrată sau trimisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы считать кадры, разрешите «%@». Изображение не сохраняется и никуда не отправляется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt ”%@” för att räkna bildrutor. Ingen bild sparas eller skickas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อนับเฟรม ให้อนุญาต “%@” ไม่มีการเก็บหรือส่งภาพใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareleri saymak için “%@” iznini verin. Hiçbir görüntü saklanmaz veya gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб рахувати кадри, дозвольте «%@». Зображення не зберігається й нікуди не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đếm khung hình, hãy cho phép “%@”. Không hình ảnh nào được lưu hay gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要计算帧数，请允许“%@”。不会保存或发送任何画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要計算影格數，請允許「%@」。不會儲存或傳送任何畫面。"
          }
        }
      }
    },
    "To find them, pikapik needs to read the list of permissions. It only looks and changes nothing until you press Remove.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للعثور عليها، يحتاج pikapik إلى قراءة قائمة الأذونات. هو ينظر فقط ولا يغيّر شيئًا حتى تضغط على «إزالة»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby je našel, potřebuje pikapik přečíst seznam oprávnění. Jen se dívá a nic nemění, dokud neklepnete na „Odstranit“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sie zu finden, muss pikapik die Liste der Berechtigungen lesen. Es schaut nur und ändert nichts, bis du auf „Entfernen“ klickst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find them, pikapik needs to read the list of permissions. It only looks and changes nothing until you press Remove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrarlos, pikapik necesita leer la lista de permisos. Solo mira y no cambia nada hasta que pulses “Eliminar”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les trouver, pikapik doit lire la liste des autorisations. Il se contente de regarder et ne change rien tant que vous n’appuyez pas sur « Supprimer »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें ढूँढने के लिए pikapik को अनुमतियों की सूची पढ़नी होती है। यह सिर्फ़ देखता है और जब तक आप “हटाएँ” नहीं दबाते, कुछ नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menemukannya, pikapik perlu membaca daftar izin. Ia hanya melihat dan tidak mengubah apa pun sampai Anda menekan “Hapus”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trovarli, pikapik deve leggere l’elenco dei permessi. Guarda soltanto e non cambia nulla finché non premi “Rimuovi”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけるには、pikapikがアクセス許可の一覧を読む必要があります。見るだけで、“削除”を押すまで何も変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 찾으려면 pikapik이 권한 목록을 읽어야 합니다. 보기만 할 뿐, '제거'를 누르기 전에는 아무것도 바꾸지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om ze te vinden, moet pikapik de lijst met toestemmingen lezen. Het kijkt alleen en verandert niets tot je op 'Verwijder' klikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby je znaleźć, pikapik musi odczytać listę uprawnień. Tylko patrzy i niczego nie zmienia, dopóki nie klikniesz „Usuń”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrá-las, o pikapik precisa ler a lista de permissões. Ele só olha e não muda nada até você clicar em “Remover”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să le găsească, pikapik trebuie să citească lista de permisiuni. Doar se uită și nu schimbă nimic până nu apăsați „Eliminați”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы найти их, pikapik нужно прочитать список разрешений. Приложение только смотрит и ничего не меняет, пока вы не нажмёте «Удалить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att hitta dem behöver pikapik läsa listan över behörigheter. Den bara tittar och ändrar inget förrän du trycker på ”Ta bort”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการค้นหา pikapik ต้องอ่านรายการสิทธิ์ แอปจะแค่ดูและไม่เปลี่ยนแปลงอะไรจนกว่าคุณจะกด “เอาออก”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları bulmak için pikapik’in izin listesini okuması gerekir. Yalnızca bakar ve siz “Kaldır”a basana kadar hiçbir şeyi değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб знайти їх, pikapik має прочитати список дозволів. Програма лише дивиться й нічого не змінює, доки ви не натиснете «Вилучити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tìm chúng, pikapik cần đọc danh sách quyền. Ứng dụng chỉ xem và không thay đổi gì cho đến khi bạn bấm “Xóa”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要找到它们，pikapik 需要读取权限列表。它只查看，在你点按“移除”之前不会更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了找出它們，pikapik 需要讀取權限列表。它只會查看，在你按下「移除」之前不會更改任何內容。"
          }
        }
      }
    },
    "To free a port, quit the program that holds it: in the program itself or in Activity Monitor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتحرير منفذ، أنهِ البرنامج الذي يحجزه: من البرنامج نفسه أو من مراقب النشاط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Port uvolníte ukončením programu, který ho drží: přímo v programu nebo v Monitoru aktivity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Port freizumachen, beende das Programm, das ihn belegt: im Programm selbst oder in der Aktivitätsanzeige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To free a port, quit the program that holds it: in the program itself or in Activity Monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para liberar un puerto, cierra el programa que lo ocupa: en el propio programa o en Monitor de Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour libérer un port, quittez le programme qui l’occupe : dans le programme lui-même ou dans Moniteur d’activité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्ट खाली करने के लिए उसे इस्तेमाल कर रहा प्रोग्राम बंद करें: प्रोग्राम में ही या ऐक्टिविटी मॉनिटर में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membebaskan port, tutup program yang memakainya: langsung di program itu atau lewat Monitor Aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per liberare una porta, chiudi il programma che la occupa: dal programma stesso oppure da Monitoraggio Attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートを空けるには、そのポートを使っているプログラムを終了します。プログラムで直接終了するか、アクティビティモニタで終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트를 비우려면 포트를 사용 중인 프로그램을 종료하십시오. 프로그램에서 직접 종료하거나 활성 상태 보기에서 종료하면 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om een poort vrij te maken, stop je het programma dat hem bezet houdt: in het programma zelf of in Activiteitenweergave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zwolnić port, zakończ program, który go zajmuje: w samym programie albo w Monitorze aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para liberar uma porta, encerre o programa que a ocupa: no próprio programa ou no Monitor de Atividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să eliberați un port, închideți programul care îl ocupă: chiar din program sau din Monitor activitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы освободить порт, завершите программу, которая его держит: в самой программе или в «Мониторинге системы»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att frigöra en port avslutar du programmet som håller den: i själva programmet eller i Aktivitetskontroll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการทำให้พอร์ตว่าง ให้ออกจากโปรแกรมที่ใช้พอร์ตนั้นอยู่ จะออกจากในตัวโปรแกรมเองหรือในตัวตรวจสอบกิจกรรมก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir portu serbest bırakmak için onu tutan programı kapatın: programın kendisinden ya da Etkinlik Monitörü’nden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб звільнити порт, завершіть програму, яка його тримає: у самій програмі або в «Моніторі активності»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để giải phóng cổng, hãy thoát chương trình đang giữ cổng: ngay trong chương trình đó hoặc trong Giám sát hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要释放端口，请退出占用它的程序：直接在该程序中退出，或在“活动监视器”中退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要釋放連接埠，請結束佔用它的程式：直接在該程式中結束，或在「活動監視器」中結束。"
          }
        }
      }
    },
    "To free port %@, turn off “%@” in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتحرير المنفذ %1$@، أوقف «%2$@» في إعدادات النظام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li uvolnit port %1$@, vypněte „%2$@“ v Nastavení systému."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Port %1$@ freizumachen, schalte „%2$@“ in den Systemeinstellungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To free port %1$@, turn off “%2$@” in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para liberar el puerto %1$@, desactiva «%2$@» en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour libérer le port %1$@, désactivez « %2$@ » dans Réglages Système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्ट %1$@ खाली करने के लिए सिस्टम सेटिंग्ज़ में “%2$@” बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membebaskan port %1$@, matikan “%2$@” di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per liberare la porta %1$@, disattiva «%2$@» in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート%1$@を空けるには、システム設定で「%2$@」をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@번 포트를 비우려면 시스템 설정에서 ‘%2$@’ 기능을 끄십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om poort %1$@ vrij te maken, zet je ‘%2$@’ uit in Systeeminstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zwolnić port %1$@, wyłącz „%2$@” w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para liberar a porta %1$@, desative “%2$@” nos Ajustes do Sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a elibera portul %1$@, dezactivați „%2$@” în Configurări sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы освободить порт %1$@, выключите «%2$@» в Системных настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill frigöra port %1$@ stänger du av ”%2$@” i Systeminställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการทำให้พอร์ต %1$@ ว่าง ให้ปิด “%2$@” ในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ portunu serbest bırakmak için Sistem Ayarları’nda “%2$@” seçeneğini kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
