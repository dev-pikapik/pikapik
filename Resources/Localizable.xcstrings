    "Meet your pet in the morning on 7 different days.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقِ برفيقك في الصباح في 7 أيام مختلفة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Setkejte se se svým mazlíčkem ráno v 7 různých dnech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff dein Haustier an 7 verschiedenen Tagen morgens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet your pet in the morning on 7 different days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuéntrate con tu mascota por la mañana en 7 días distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez votre compagnon le matin pendant 7 jours différents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 अलग-अलग दिनों में सुबह अपने नन्हे दोस्त से मिलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temui peliharaan Anda di pagi hari pada 7 hari berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incontra il tuo animaletto la mattina in 7 giorni diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7つの異なる日の朝に、ペットに会います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 다른 7일의 아침에 펫을 만나 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
